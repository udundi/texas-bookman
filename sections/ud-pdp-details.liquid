<style>
  /* Vue v-cloak directive to hide content until Vue is ready */
  [v-cloak] {
    display: none !important;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 1rem;
  }

  .ud-drawers a {
    color: #94412f !important;
    font-weight: 700;
    text-decoration: underline !important;
  }

  .variant-radio {
    display: none !important;
  }

  .variant-radio:checked + .variant-label {
    background-color: white;
    color: #322f30;
  }

  .swiper-pagination-bullet-active {
    background-color: #313558 !important;
  }

  .ud-rich-text > ul {
    list-style: disc !important;
    padding-left: 24px;
  }
  .ud-rich-text > a {
    color: #313558;
    text-decoration: underline;
  }

  /* Image Modal Styles */
  .image-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.85);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .image-modal.active {
    display: flex;
    opacity: 1;
  }

  .image-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 3rem;
    height: 3rem;
    background-color: rgba(0, 0, 0, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s;
    z-index: 10001;
  }

  .image-modal-close:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .image-modal-close svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke: white;
  }

  .modal-swiper-container {
    width: 100%;
    height: 100%;
  }

  .modal-swiper-container .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
  }

  .modal-swiper-container .swiper-slide img,
  .modal-swiper-container .swiper-slide video {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .modal-swiper-container .swiper-button-next,
  .modal-swiper-container .swiper-button-prev {
    color: white;
    background-color: rgba(0, 0, 0, 0.9);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
  }

  .modal-swiper-container .swiper-button-next:hover,
  .modal-swiper-container .swiper-button-prev:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .modal-swiper-container .swiper-button-next:after,
  .modal-swiper-container .swiper-button-prev:after {
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .image-modal-close {
      top: 0.5rem;
      right: 0.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }

    .modal-swiper-container .swiper-button-next,
    .modal-swiper-container .swiper-button-prev {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
{% render 'vue-mix-pdp' %}

{% comment %} Main HTML Container {% endcomment %}
<div
  id="MainProduct-{{ section.id }}"
  class="tw-flex tw-w-full tw-items-center tw-justify-center section-{{ section.id }}-props tw-flex-col"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-vue-product-details
  data-product-handle="{{ product.handle }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-url="{{ product.url }}"
>
  {% comment %} Add to Cart Form {% endcomment %}
  {% form 'product', product, data-productid: product.id, ref: 'productForm', id: 'product_form', class: 'tw-w-full' %}
    <input
      type="hidden"
      name="id"
      :value="defaultVariantId"
    >
    <div
      class="tw-flex tw-w-full tw-max-w-container-xl tw-flex-col tw-justify-between tw-gap-4 tw-gap-x-10 tw-pt-4 md:tw-flex-row md:tw-items-start"
    >
      {% content_for 'blocks' %}
    </div>
  {% endform %}
</div>

{% render 'gallery-modal' %}

<!-- Setting Price variables for vue -->
{% assign product_price = product.selected_or_first_available_variant.price %}
{% assign sitewide_discount = settings.sitewide_sale | default: false %}

<!-- Vue Main script -->
<script>
  const app = Vue.createApp({
    delimiters: ['[[', ']]'],
    mixins: [global, pdpdata],
    data() {
      return {
        quantity: 1,
        currentVariantId: '{{ product.selected_or_first_available_variant.id }}',
        productPrice: '{{ product_price }}',
        openedBlocks: {% if section.blocks.size > 0 %}[String('block-{{ section.blocks[0].id }}').slice(0, -2)]{% else %}[]{% endif %},
        sitewideDiscount: {{ settings.sitewide_sale_discount | divided_by: 100.0 }},
        sitewideSale: {{ sitewide_discount }},
      };
    },
    methods: {
      addCalculatorToCart() {
        let quantity = 0;

        // Determine quantity based on selected option
        if (this.selectedCalc === 'calc') {
          quantity = this.calculatedTiles;
        } else if (this.selectedCalc === 'deal') {
          quantity = this.roundedTiles;
        } else {
          alert('Please select a quantity option');
          return;
        }

        // Set quantity and add to cart
        this.quantity = quantity;
        this.addingToCart = true;
        this.addToCart();
      },
      async addToCart() {
        this.addingToCart = true;
        const params = new URLSearchParams(window.location.search);
        const urlVariant = params.get('variant');

        // Default variant ID — currentVariantId is set synchronously on click so it always reflects
        // the user's latest selection even if the async section fetch is still in flight.
        let variantIdToAdd = Number(this.currentVariantId || urlVariant || '{{ product.selected_or_first_available_variant.id }}');
        let useBundleVariant = false;

        // Debug: Log available tile variant info
        console.log('Bundle Debug:', {
          isBundleEnabled: this.isBundleProductEnabled,
          quantity: this.quantity,
          isMultiple: this.quantity % 8 === 0,
          tileVariantIdFromLiquid: {{ product.selected_or_first_available_variant.metafields.custom.tile_variant.value.id | default: 0 }},
          defaultVariantId: {{ product.selected_or_first_available_variant.id }}
        });

        // Check if we should use bundle variant (when quantity is a multiple of 8 and bundle is enabled)
        if (this.isBundleProductEnabled && this.quantity % 8 === 0) {
          const tileVariantId = {{ product.selected_or_first_available_variant.metafields.custom.tile_variant.value.id | default: 0 }};
          console.log('Checking bundle variant:', tileVariantId);

          if (!isNaN(tileVariantId) && tileVariantId > 0) {
            variantIdToAdd = tileVariantId;
            useBundleVariant = true;
            console.log('✓ Using bundle variant:', tileVariantId);
          } else {
            console.warn('✗ Bundle variant ID invalid:', tileVariantId);
          }
        }

        // Check shipping options (only if bundle product is not being used)
        if (!useBundleVariant && this.selectedShipping === 'tiles') {
          const tileVariantId = {{ product.selected_or_first_available_variant.metafields.custom.tile_variant.value.id | default: 0 }};
          if (!isNaN(tileVariantId) && tileVariantId > 0) {
            variantIdToAdd = tileVariantId;
          } else {
            console.warn('Tile variant not available, using default variant');
          }
        }

        // Final validation of variant ID
        if (isNaN(variantIdToAdd) || variantIdToAdd <= 0) {
          console.error('Invalid variant ID:', variantIdToAdd);
          Swal.fire({
            icon: 'error',
            text: 'Please select a valid product variant.',
          });
          this.addingToCart = false;
          return;
        }

        console.log('Final cart add details:', {
          variantIdToAdd,
          useBundleVariant,
          finalQuantity: useBundleVariant ? this.quantity / 8 : (this.quantity || 1),
          originalQuantity: this.quantity
        });

        // Calculate the final quantity to add
        let finalQuantity = this.quantity || 1;

        if (useBundleVariant) {
          // When using bundle variant, divide quantity by 8 (e.g., quantity 8 = 1 bundle, 16 = 2 bundles)
          finalQuantity = this.quantity / 8;
          console.log('Bundle quantity:', finalQuantity);
        } else if (this.selectedShipping === 'tiles') {
          finalQuantity = this.quantity || 1;
        } else if (this.isMultiplesOf8) {
          // When using multiples of 8, divide quantity by 8
          finalQuantity = Math.ceil(this.quantity / 8);
        }

        // Build properties object for the main product
        let mainItemProperties = {};
        {% if product.metafields.custom.adhesive_tab_count > 0 %}
          mainItemProperties['adhesive-tabs'] = Number('{{ product.metafields.custom.adhesive_tab_count }}');
        {% elsif product.metafields.custom.mini_adhesive_tab_count > 0 %}
          mainItemProperties['mini-adhesive-tabs'] = Number('{{ product.metafields.custom.mini_adhesive_tab_count }}');
        {% endif %}

        // Add background layer to properties if selected
        if (this.selectedBackgroundColor) {
          mainItemProperties['Background Layer'] = this.selectedBackgroundColor;
        }

        // Add tile set description if tiles shipping is selected
        if (this.selectedShipping === 'tiles') {
          mainItemProperties['Shipping'] = 'Set of 8 - Cut Down Tiles';
        }

        // Add bundle product property if using bundle variant
        if (useBundleVariant) {
          mainItemProperties['Bundle'] = 'Set of 8 Tiles';
        }

        // Add multiples of 8 property if enabled
        if (this.isMultiplesOf8 && !useBundleVariant) {
          mainItemProperties['Type'] = 'Set of 8';
        }

        // 3D Acoustic Boxes: Add attachment property BEFORE building main item
        {% if product.handle == '3d-boxes' or product.handle == '3d-acoustic-boxes-screws' or product.handle == 'small-3d-acoustic-boxes' %}
        if (this.attachmentConfig) {
          const attachmentType = this.selectedAttachment || 'adhesive';
          const attachmentInfo = this.attachmentConfig[attachmentType];
          if (attachmentInfo && attachmentInfo.count > 0 && attachmentInfo.variantId) {
            const attachmentLabel = attachmentType === 'screws' ? 'drywall-screws' : 'adhesive-tape';
            mainItemProperties[attachmentLabel] = attachmentInfo.count;
            // Studio packing list reads this visible prop to render per-line hardware breakout
            mainItemProperties['Attachment'] = attachmentType === 'screws' ? 'Drywall Screws' : 'Adhesive Tape';
          }
        }
        {% endif %}

        // Build main item - only include properties if not empty
        let mainItem = {
          quantity: finalQuantity,
          id: variantIdToAdd,
        };

        mainItemProperties['_tags'] = {{ product.tags | json }};
        // Only add properties if there are any
        if (Object.keys(mainItemProperties).length > 0) {
          mainItem.properties = mainItemProperties;
        }

        let items = [mainItem];

        // Add adhesive tabs if applicable (multiply by final quantity)
        {% if product.metafields.custom.adhesive_tab_count > 0 %}
          items.push({
            quantity: Number('{{ product.metafields.custom.adhesive_tab_count }}') * finalQuantity,
            id: '37500128919721',
          });
        {% elsif product.metafields.custom.mini_adhesive_tab_count > 0 %}
          items.push({
            quantity: Number('{{ product.metafields.custom.mini_adhesive_tab_count }}') * finalQuantity,
            id: '45111050698980',
          });
        {% endif %}

        // 3D Acoustic Boxes: Add attachment line item
        {% if product.handle == '3d-boxes' or product.handle == '3d-acoustic-boxes-screws' or product.handle == 'small-3d-acoustic-boxes' %}
        if (this.attachmentConfig) {
          const attachmentType = this.selectedAttachment || 'adhesive';
          const attachmentInfo = this.attachmentConfig[attachmentType];

          if (attachmentInfo && attachmentInfo.count > 0 && attachmentInfo.variantId) {
            const attachmentQuantity = attachmentInfo.count * finalQuantity;
            items.push({
              quantity: attachmentQuantity,
              id: attachmentInfo.variantId,
            });
          }
        }
        {% endif %}

        if (this.shippingMethod == 'Freight') {
          this.bus.$emit('addFreight');
          await axios.get('/cart.js').then(async (response) => {
            let cartItems = response.data.items;
            let addShipping = true;
          });
        }

        items.reverse();

        // Filter out any invalid items
        items = items.filter(item => item && item.id && !isNaN(item.id) && item.quantity > 0);

        // Validate we have items to add
        if (items.length === 0) {
          console.error('No valid items to add to cart');
          Swal.fire({
            icon: 'error',
            text: 'Unable to add item to cart. Please select a valid variant.',
          });
          this.addingToCart = false;
          return;
        }

        console.log('Adding to cart:', JSON.stringify(items, null, 2));

        axios
          .post('/cart/add.js', {
            items: items,
          })
          .then((response) => {
            console.log('Cart add success:', response.data);
            console.log('Items actually added:', response.data.items?.map(item => ({
              id: item.variant_id,
              title: item.title,
              quantity: item.quantity,
              variant_title: item.variant_title
            })));
            this.showCart();
            this.bus.$emit('refreshCart');
            this.addingToCart = false;
            this.$forceUpdate();
          })
          .catch((error) => {
            console.error('Cart add error:', error);
            console.error('Error response:', error.response);
            const errorMessage = error.response && error.response.data && error.response.data.description
              ? error.response.data.description
              : 'Unable to add item to cart. Please try again.';
            Swal.fire({
              icon: 'error',
              text: errorMessage,
            });
            this.addingToCart = false;
          })
          .finally(() => {
            this.addingToCart = false;
          });
      },
      getProductTiles() {
        if (typeof axios === 'undefined') {
          // Axios not loaded yet (deferred), retry after a short delay
          setTimeout(() => this.getProductTiles(), 100);
          return;
        }
          // Axios POST request (converted from cURL)
        axios.post(
          'https://studiov2.feltright.com/api/update-shopify-product',
          {
            shopifyProductId: {{ product.id }}
          },
          {
            headers: {
              'Content-Type': 'application/json',
              'Authorization': 'Basic ZmVsdHJpZ2h0OmZlbHRyaWdodDEyMw=='
            }
          }
        )
        .then(response => {
          // handle success
          console.log('Tiles Response', response.data);
        })
        .catch(error => {
          // handle error
          console.error('Tiles Error Response', error);
        });
      },
    },
    mounted() {
      // Expose global function for 3D Boxes Installation Type selector
      // This allows the native onclick handlers in the snippet to update Vue state
      {% if product.handle == '3d-boxes' or product.handle == '3d-acoustic-boxes-screws' or product.handle == 'small-3d-acoustic-boxes' %}
      const self = this;
      window.set3DBoxesAttachment = function(type) {
        self.selectedAttachment = type;
      };
      console.log('3D Boxes attachmentConfig:', this.attachmentConfig);
      {% endif %}

      const params = new URLSearchParams(window.location.search);
      const urlVariant = params.get('variant');
      if (urlVariant) {
        this.currentVariantId = urlVariant;
      }
      if ('{{ product.metafields.custom.special_shipping_options.value }}' == 'Freight Shipping Only') {
        this.shippingMethod = 'Freight';
      }
      this.getProductTiles()
      if (this.getParameter('ceilingRecomendationGood') || this.getParameter('ceilingRecomendationBetter') || this.getParameter('ceilingRecomendationBest')) {
        this.ceilingRecomendationGood = this.getParameter('ceilingRecomendationGood');
        this.ceilingRecomendationBetter = this.getParameter('ceilingRecomendationBetter');
        this.ceilingRecomendationBest = this.getParameter('ceilingRecomendationBest');
        this.ceilingMessageId = this.getParameter('ceilingMessageId');
        this.ceilingBaffleType = this.getParameter('ceilingBaffleType');
        this.showAcousticRecommendations();
      }

      // Check for commercial calculator parameters
      const urlParams = new URLSearchParams(window.location.search);
      const designType = urlParams.get('design_type');
      const productId = urlParams.get('product_id');
      const quantity = urlParams.get('quantity');
      const coverage = urlParams.get('coverage');
      const solutionType = urlParams.get('solution_type');
      const productName = urlParams.get('product_name');

      // Check for commercial calculator parameters (multiple solution types)
      const wallQuantity = urlParams.get('wall_quantity');
      const wallSqFt = urlParams.get('wall_sqft');
      const ceilingQuantity = urlParams.get('ceiling_quantity');
      const ceilingSqFt = urlParams.get('ceiling_sqft');
      const wallProduct = urlParams.get('wall_product');
      const roomType = urlParams.get('room_type');
      const ceilingProductId = urlParams.get('ceiling_product_id');

      // Map ceiling product ID to URL
      const ceilingProductUrlMap = {
        'cloud_baffles': '/products/drop-ceiling-cloud-baffle',
        'blade_baffles': '/products/admiral-ceiling-blade',
        'beams': '/products/4-foot-wood-acoustic-beams',
        'wood_slat_ceiling': '/products/wood-slat-ceiling'
      };
      const ceilingProductUrl = ceilingProductId ? ceilingProductUrlMap[ceilingProductId] : null;

      // Check for multiple solution results
      const maxWallQuantity = urlParams.get('max_wall_quantity');
      const balancedWallQuantity = urlParams.get('balanced_wall_quantity');
      const maxCeilingWallQuantity = urlParams.get('max_ceiling_wall_quantity');

      if (designType === 'Felt Right Design' && (quantity || maxWallQuantity)) {
        this.isCommercial = true;
        this.solutionType = solutionType;
        this.quantityMode = urlParams.get('quantity_mode') || 'ideal';

        // Debug logging for development
        console.log('Commercial calculator activated:', {
          designType,
          quantity,
          maxWallQuantity,
          solutionType,
          hasMultipleSolutions: !!maxWallQuantity
        });

        // Store calculator parameters
        this.calculatorParams = {
          wallProduct: wallProduct || productId,
          roomType: roomType || 'commercial'
        };
        console.log('ceilingProductUrl', ceilingProductUrl)
        if (maxWallQuantity) {
          // Multiple solutions provided
          this.commercialSolutions = {
            maxWall: {
              wallUnits: parseInt(urlParams.get('max_wall_quantity')) || 0,
              wallSqFt: parseInt(urlParams.get('max_wall_sqft')) || 0,
              ceilingUnits: parseInt(urlParams.get('max_wall_ceiling_quantity')) || 0,
              ceilingSqFt: parseInt(urlParams.get('max_wall_ceiling_sqft')) || 0,
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            },
            balanced: {
              wallUnits: parseInt(urlParams.get('balanced_wall_quantity')) || 0,
              wallSqFt: parseInt(urlParams.get('balanced_wall_sqft')) || 0,
              ceilingUnits: parseInt(urlParams.get('balanced_ceiling_quantity')) || 0,
              ceilingSqFt: parseInt(urlParams.get('balanced_ceiling_sqft')) || 0,
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            },
            maxCeiling: {
              wallUnits: parseInt(urlParams.get('max_ceiling_wall_quantity')) || 0,
              wallSqFt: parseInt(urlParams.get('max_ceiling_wall_sqft')) || 0,
              ceilingUnits: parseInt(urlParams.get('max_ceiling_quantity')) || 0,
              ceilingSqFt: parseInt(urlParams.get('max_ceiling_sqft')) || 0,
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            }
          };
        } else {
          // Single solution - estimate other solutions
          const baseQuantity = parseInt(quantity) || 0;
          const baseCoverage = parseInt(coverage) || 0;

          this.commercialSolutions = {
            maxWall: {
              wallUnits: Math.round(baseQuantity * 1.2),
              wallSqFt: Math.round(baseCoverage * 1.2),
              ceilingUnits: Math.round(baseQuantity * 0.1),
              ceilingSqFt: Math.round(baseCoverage * 0.1),
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            },
            balanced: {
              wallUnits: baseQuantity,
              wallSqFt: baseCoverage,
              ceilingUnits: Math.round(baseQuantity * 0.3),
              ceilingSqFt: Math.round(baseCoverage * 0.3),
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            },
            maxCeiling: {
              wallUnits: Math.round(baseQuantity * 0.6),
              wallSqFt: Math.round(baseCoverage * 0.6),
              ceilingUnits: Math.round(baseQuantity * 0.8),
              ceilingSqFt: Math.round(baseCoverage * 0.8),
              ceilingProductUrl: ceilingProductUrl || '/products/drop-ceiling-cloud-baffle'
            }
          };
        }

        this.showCommercialCalculatorCards();

        // Scroll to top so calculator results are visible
        this.$nextTick(() => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    }
  });

  // Mount the Vue 3 application
  app.mount('.section-{{ section.id }}-props');


  function initMobileSwiper() {
    try {
      const container = document.querySelector('.swiper-container');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof swiper2 !== 'undefined' && swiper2 && swiper2.slides) {
        if (swiper2.slides.length === newSlideCount) {
          swiper2.update();
          swiper2.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy (false, false = keep DOM intact)
        if (swiper2.destroy) swiper2.destroy(false, false);
      }

      swiper2 = new Swiper('.swiper-container', {
        loop: true,
        spaceBetween: 10,
        slidesPerView: 1,
        navigation: {
          nextEl: '.swiper-container .swiper-button-next',
          prevEl: '.swiper-container .swiper-button-prev',
        },
        pagination: {
          el: ".swiper-pagination",
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var swiper2;
  initMobileSwiper();
  function initThumbsSwiper() {
    try {
      const container = document.querySelector('.swiper-thumbs');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof swiper !== 'undefined' && swiper && swiper.slides) {
        if (swiper.slides.length === newSlideCount) {
          swiper.update();
          swiper.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy
        if (swiper.destroy) swiper.destroy(false, false);
      }

      swiper = new Swiper('.swiper-thumbs', {
        loop: false,
        slidesPerView: 3.4,
        spaceBetween: 10,
        freeMode: true,
        watchSlidesProgress: true,
        breakpoints: {
          450: {
            slidesPerView: 2.4,
          },
          900: {
            slidesPerView: 3.4,
          },
          1440: {
            slidesPerView: 4.4,
          },
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var swiper;
  initThumbsSwiper();

  var swiper3 = new Swiper('.related-swiper', {
    slidesPerView: 1.3,
    spaceBetween: 10,
    breakpoints: {
      900: {
        slidesPerView: 2.3,
      },
      1440: {
        slidesPerView: 3.3,
      },
    },
  });

  function initModalSwiper() {
    try {
      const container = document.querySelector('.modal-swiper-container');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof modalSwiper !== 'undefined' && modalSwiper && modalSwiper.slides) {
        if (modalSwiper.slides.length === newSlideCount) {
          modalSwiper.update();
          modalSwiper.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy
        if (modalSwiper.destroy) modalSwiper.destroy(false, false);
      }

      modalSwiper = new Swiper('.modal-swiper-container', {
        loop: true,
        spaceBetween: 10,
        slidesPerView: 1,
        navigation: {
          nextEl: '.modal-swiper-container .swiper-button-next',
          prevEl: '.modal-swiper-container .swiper-button-prev',
        },
        keyboard: {
          enabled: true,
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var modalSwiper;
  initModalSwiper();

  function goToSlide(index) {
    if (typeof swiper2 !== 'undefined' && swiper2 && swiper2.slideTo) {
      swiper2.slideTo(index);
    }
  }

  // Image Modal Functions
  function openImageModal(slideIndex) {
    const modal = document.getElementById('imageModal-{{ section.id }}');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';

    // Go to the clicked slide - ensure modalSwiper is initialized
    if (slideIndex !== undefined && typeof modalSwiper !== 'undefined' && modalSwiper) {
      // Use setTimeout to ensure swiper is ready
      setTimeout(() => {
        if (modalSwiper && modalSwiper.slideTo) {
          modalSwiper.slideTo(slideIndex);
        }
      }, 100);
    }
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal-{{ section.id }}');
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>

