{%- if block.settings.collection_gate != blank -%}
  {%- liquid
    assign gate = block.settings.collection_gate

    # When the store has a storefront filter for this subcategory (Search & Discovery,
    # e.g. the custom.category metafield), the gate is a multi-select checkbox on the
    # current collection. Otherwise it links to the gate's own collection.
    assign filter_param = block.settings.filter_param | default: 'filter.p.m.custom.category'
    assign filter_value = block.settings.filter_value | default: gate.title
    assign filter_found = false
    assign gate_value = nil
    unless collection == gate
      for filter in collection.filters
        if filter.param_name == filter_param
          assign filter_found = true
          for value in filter.values
            if value.value == filter_value
              assign gate_value = value
              break
            endif
          endfor
        endif
      endfor
    endunless
  -%}
  {%- capture child_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}
  {%- liquid
    # Nested gates and filters mark themselves active so this gate stays visible and opens
    assign child_blocks = child_blocks | strip
    assign has_active_child = false
    if child_blocks contains 'data-filter-active'
      assign has_active_child = true
    endif

    assign show_gate = false
    assign gate_active = false
    if filter_found
      # Hide subcategories with no results, unless already selected.
      if gate_value
        assign gate_active = gate_value.active
        if gate_value.active or gate_value.count > 0 or has_active_child
          assign show_gate = true
        endif
        if gate_value.active
          assign gate_href = gate_value.url_to_remove
        else
          assign gate_href = gate_value.url_to_add
        endif
        assign gate_count = gate_value.count
      endif
    elsif collection == gate or gate.all_products_count > 0 or has_active_child
      assign show_gate = true
    endif
  -%}
  {%- if show_gate -%}
    {%- unless filter_found -%}
      {%- liquid
        # theme-check-disable
        capture content_for_query_string
          echo content_for_header
        endcapture
      -%}

      {% assign get_full_url = content_for_query_string
        | split: '"pageurl":"'
        | last
        | split: '"'
        | first
        | split: '.myshopify.com'
        | last
        | replace: '\/', '/'
        | replace: '%20', ' '
        | replace: '\u0026', '&'
        | replace: collection.url, ''
        | replace: 'feltright.com', ''
      %}
      {% assign query_params = get_full_url | replace: '?', '' | replace: '_fd=0&pb=0&', '' | split: '&' %}
      {%- liquid
        if collection == gate
          assign gate_active = true
          assign gate_href = routes.all_products_collection_url
          assign gate_count = collection.all_products_count
        else
          assign gate_href = gate.url
          assign gate_count = gate.all_products_count
        endif
        if query_params != blank
          assign joined_params = query_params | join: '&'
          assign gate_href = gate_href | append: '?' | append: joined_params
        endif
      -%}
    {%- endunless -%}
    {%- liquid
      assign children_collapsed = true
      if gate_active or has_active_child
        assign children_collapsed = false
      endif
      assign gate_label = block.settings.title | default: gate.title
    -%}
    <div class="tw-p-1">
      <div class="tw-flex tw-w-full tw-flex-col"{% if gate_active %} data-filter-active{% endif %}>
        <div class="tw-flex tw-w-full tw-items-center tw-gap-1">
          {% render 'collection-filter-checkbox',
            href: gate_href,
            checked: gate_active,
            label: gate_label,
            count: gate_count
          %}
          {%- if child_blocks != blank -%}
            <button
              type="button"
              class="tw-flex-shrink-0 tw-fill-offblack tw-size-3 tw-cursor-pointer tw-bg-transparent tw-border-0 tw-p-0 tw-m-0"
              aria-label="Show subcategories of {{ gate_label | escape }}"
              @click="toggleFilter('{{ block.id }}', {{ children_collapsed }})"
            >
              <div
                class="tw-fill-offblack tw-size-3"
                v-if="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
              >
                {% render 'icon-arrow-up' %}
              </div>
              <div v-else class="tw-fill-offblack tw-size-3">{% render 'icon-arrow-down' %}</div>
            </button>
          {%- endif -%}
        </div>
        {%- if child_blocks != blank -%}
          <div
            class="tw-pl-4 tw-pt-1 tw-flex tw-flex-col tw-gap-[1px]"
            v-show="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
          >
            {{ child_blocks }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection Gate",
  "settings": [
    {
      "type": "collection",
      "id": "collection_gate",
      "label": "Linked Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Link Title",
      "default": "Filter Title"
    },
    {
      "type": "text",
      "id": "filter_param",
      "label": "Storefront filter",
      "info": "Search & Discovery filter that selects this subcategory. When the store has it enabled, the gate becomes a multi-select checkbox instead of a link to the collection.",
      "placeholder": "filter.p.m.custom.category"
    },
    {
      "type": "text",
      "id": "filter_value",
      "label": "Filter value",
      "info": "Defaults to the linked collection's title.",
      "placeholder": "Art"
    }
  ],
  "blocks": [
    {
      "type": "_collection-gate"
    },
    {
      "type": "_collection-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Gate"
    }
  ]
}
{% endschema %}
