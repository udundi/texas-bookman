{%- comment -%}
  Details fields; each is hidden when empty or holding the import's "Not available" placeholder,
  and the Details tab itself is dropped when none are left.
{%- endcomment -%}
{%- capture details_html -%}
  {%- assign detail_labels = 'Pub Date|Format|Pages|Illustration Type' | split: '|' -%}
  {%- assign detail_keys = 'publication_date|format|pages|illustration_type' | split: '|' -%}
  {%- for detail_key in detail_keys -%}
    {%- assign detail_value = product.metafields.custom[detail_key] | strip -%}
    {%- assign detail_value_lower = detail_value | downcase -%}
    {%- if detail_value != blank and detail_value_lower != 'not available' -%}
      <div>{{ detail_labels[forloop.index0] }}: {{ detail_value }}</div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{% style %}
  .section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.container_width == 'full_width' %}
      width: 100%;
    {% elsif section.settings.container_width == 'lg_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'md_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'sm_desktop' %}
      max-width: var(--container-width, 1280px);
    {% elsif section.settings.container_width == 'tablet' %}
      max-width: var(--container-width, 768px);
    {% else section.settings.container_width == 'mobile' %}
      max-width: var(--container-width, 448px);
    {% endif %}

  }
{% endstyle %}

<div class="section-{{ block.id }} tw-mx-auto tw-py-4">
  <div class="vue-controler-{{ block.id }} tw-mx-auto">
    {% if block.blocks[0] != blank %}
      <div class="tw-flex tw-justify-start tw-gap-0.5">
        {% assign tab_titles = block.settings.tab_titles | append: '-' | split: '-' %}
        {% if details_html != blank %}
        <button
          @click="clickingTab('info')"
          class=" tw-text-16 tw-font-montserrat tw-leading-tight tw-px-4 tw-py-2 tw-capitalize tw-text-offblack"
          :class="
            [
              clickedTab == 'info' ? 'tw-border-t tw-rounded-t-md tw-border-brand-grey tw-border-x tw-bg-brand-eggshell' : 'tw-font-normal'
            ]
          "
        >
          Details
        </button>
        {% endif %}
        {% for block in block.blocks %}
          <button
            @click="clickingTab('{{ forloop.index0 }}')"
            class=" tw-text-16 tw-font-montserrat tw-leading-tight tw-px-4 tw-py-2 tw-capitalize tw-text-offblack"
            :class="
              [
                clickedTab == '{{ forloop.index0 }}' ? 'tw-border-t tw-rounded-t-md tw-border-brand-grey tw-border-x tw-bg-brand-eggshell' : 'tw-font-normal'
              ]
            "
          >
            {{ tab_titles[forloop.index0] | default: 'Default Tab' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  {% if details_html != blank %}
  <div
    v-if="clickedTab == 'info'"
    class="tw-overflow-hidden tw-border tw-border-brand-grey tw-rounded-[4px] tw-mt-[-1px] tw-bg-brand-eggshell info-tab-{{ block.id }}"
    :class="[clickedTab == 'info' ? 'tw-rounded-tl-none' : '']"
  >
    <div class="tw-flex tw-flex-col tw-gap-4 tw-items-center tw-w-full tw-justify-center tw-p-4 ">
      <div class="tw-w-full tw-gap-4 tw-flex tw-items-start tw-justify-start">
        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-items-start tw-w-full tw-justify-start tw-py-4">
          {{ details_html }}
        </div>
      </div>
    </div>
  </div>
  {% endif %}
  {% for block in block.blocks %}
    <div
      v-if="clickedTab == {{ forloop.index0 }}"
      class="tw-overflow-hidden tw-border tw-border-brand-grey tw-rounded-[4px] tw-mt-[-1px] tw-bg-brand-eggshell info-tab-{{ block.id }}"
    >
      {% render block %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Tabbed Info Section",
  "class": "tw-w-full",
  "settings": [
    {
      "type": "text",
      "label": "Tab Titles",
      "id": "tab_titles",
      "info": "Separate titles with hyphens => '-'"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_left",
      "label": "Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_right",
      "label": "Padding Right",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_left",
      "label": "Mobile Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_right",
      "label": "Mobile Padding Right",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Max Width Of Section",
      "options": [
        {
          "value": "mobile",
          "label": "448px (Mobile)"
        },
        {
          "value": "tablet",
          "label": "768px (Tablet)"
        },
        {
          "value": "sm_desktop",
          "label": "1024px (Sm Desktop)"
        },
        {
          "value": "md_desktop",
          "label": "1280px (Md Desktop)"
        },
        {
          "value": "lg_desktop",
          "label": "1440px (Lg Desktop)"
        },
        {
          "value": "full_width",
          "label": "Full Width"
        }
      ],
      "default": "full_width"
    }
  ],
  "blocks": [
    {
      "type": "_pdp-info-tab"
    }
  ],
  "presets": [
    {
      "name": "Tabbed Info Section"
    }
  ]
}
{% endschema %}
