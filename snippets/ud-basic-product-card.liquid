{% assign product_id = section.id | append: '-' | append: cur_product.handle | append: extra_append %}
{% assign product_atc_id = product_id | append: '-atc' %}
{% assign isbn = cur_product.metafields.facts.isbn | default: cur_product.metafields.custom.isbn %}
{%- liquid
  # Same quantity rules as the related-products quick add: B2B min/increment, and a max at stock
  # (only when Shopify refuses to oversell) or the rule max, whichever is lower.
  assign qty_variant = cur_product.selected_or_first_available_variant
  assign min_qty = qty_variant.quantity_rule.min | default: 1
  assign qty_step = qty_variant.quantity_rule.increment | default: 1
  assign qty_max = nil
  if qty_variant.inventory_management == 'shopify' and qty_variant.inventory_policy == 'deny'
    assign qty_max = qty_variant.inventory_quantity | at_least: 1
  endif
  if qty_variant.quantity_rule.max
    if qty_max == nil or qty_variant.quantity_rule.max < qty_max
      assign qty_max = qty_variant.quantity_rule.max
    endif
  endif
  capture stock_info
    render 'stock-state', product: cur_product
  endcapture
  assign stock_state = stock_info | split: ' ' | first
-%}

<div
  id="{{ product_id }}"
  class="{{ class }} tw-justify-between tw-flex tw-flex-col tw-p-4 {%  unless no_border %}tw-border tw-border-brand-grey tw-mr-[-1px] tw-mb-[-1px]{% endunless %}"
>
  <a href="{{ cur_product.url | default: '/' }}">
    <div class=" tw-aspect-3/4 tw-w-3/4 tw-object-cover tw-mx-auto md:tw-mb-3 tw-mb-2 tw-relative">
      {% if cur_product.featured_image != blank %}
        {% if small_image == true %}
          {{
            cur_product.featured_image
            | image_url: width: 400
            | image_tag: loading: 'lazy', class: 'tw-w-full tw-object-cover tw-h-72 tw-aspect-3/4'
          }}
        {% else %}
          {{
            cur_product.featured_image
            | image_url: width: 800
            | image_tag: loading: 'lazy', class: 'tw-size-full tw-object-cover tw-aspect-3/4'
          }}
        {% endif %}
      {% else %}
        <div class=" tw-size-full">
          {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-max-w-[450px] tw-mx-auto tw-object-cover' }}
        </div>
      {% endif %}
      {% if cur_product.tags contains 'New Product' %}
        <div class="tw-absolute tw-top-2.5 tw-right-2 tw-text-12 tw-px-4 tw-py-1 tw-bg-black tw-rounded-[4px] tw-text-white tw-font-semibold">
          New
        </div>
      {% endif %}
    </div>
  </a>
  <div class="tw-flex tw-flex-col tw-justify-between tw-h-full tw-w-full tw-gap-x-4 tw-gap-y-3 tw-items-start">
    <div class="tw-w-full">
      <!-- Title Container -->
      <div class="tw-flex tw-gap-x-4 tw-gap-y-1 tw-pb-2 tw-items-center tw-flex-wrap tw-w-full tw-justify-between">
        <!-- Title -->
        <div class="tw-flex tw-w-full tw-flex-row tw-gap-2 tw-items-start tw-justify-between">
          <a class="tw-w-full tw-h-10 tw-line-clamp-2 tw-max-w-96" href="{{ cur_product.url | default: "/" }}">
            <h3 class="tw-font-semibold tw-text-14 tw-text-brand-primary tw-line-clamp-2 tw-w-full tw-leading-tight tw-h-fit tw-m-0">
              {{ cur_product.title | default: 'Product title' }}
            </h3>
          </a>
        </div>
        <div class="tw-flex tw-flex-col">
          {%- unless cur_product.type == 'Greeting Card' -%}
          <div class="tw-text-gray-600 tw-text-14 tw-font-semibold">
            List:
            <span class="tw-font-normal">{{ cur_product.compare_at_price | default: cur_product.price | money }}</span>
          </div>
          {%- endunless -%}
          <div class="tw-font-semibold tw-text-14 ">
            {% if customer %}Your{% endif %} Net Price:
            <span class="tw-font-normal">{{ cur_product.price | money }}</span>
          </div>
        </div>
        {% render 'stock-label', state: stock_state, class: 'tw-mt-1' %}
      </div>
    </div>
    {% if customer == null %}
      <a
        href="{{ routes.account_login_url }}"
        class="tw-bg-brand-secondary tw-w-full tw-cursor-pointer tw-pointer-events-auto md:tw-text-12 tw-text-10 tw-uppercase tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center tw-py-2 tw-no-underline"
      >
        Sign in to shop
      </a>
    {% elsif stock_state == 'out_of_stock' %}
      <button
        type="button"
        disabled
        class="tw-bg-brand-secondary tw-w-full md:tw-text-12 tw-text-10 tw-uppercase tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4 tw-font-semibold tw-font-montserrat tw-whitespace-nowrap tw-items-center tw-py-2 tw-opacity-50 tw-cursor-not-allowed"
      >
        Out of Stock
      </button>
    {% else %}
      <div class="tw-flex tw-flex-wrap tw-gap-2 tw-items-stretch tw-w-full">
        <div class="tw-flex tw-items-center tw-gap-2 tw-grow tw-text-brand-greyer">
          <label for="{{ product_id }}-qty" class="tw-whitespace-nowrap">
            {{- 'QTY' -}}
            {%- if min_qty > 1 %} (Min {{ min_qty }}{% if qty_step > 1 %}, x{{ qty_step }}{% endif %}){% elsif qty_step > 1 %} (x{{ qty_step }}){% endif -%}
            :
          </label>
          <input
            id="{{ product_id }}-qty"
            type="number"
            min="{{ min_qty }}"
            step="{{ qty_step }}"
            {% if qty_max %}max="{{ qty_max }}"{% endif %}
            placeholder="{{ min_qty }}"
            v-model.number="quantity"
            @input="capQuantity($event.target)"
            @change="quantity = validQuantity(quantity, {{ min_qty }}, {{ qty_step }}, {{ qty_max | default: 'Infinity' }})"
            class="tw-w-full tw-min-w-10 tw-text-center tw-leading-none tw-py-1 tw-border tw-border-brand-grey tw-rounded tw-text-12 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
            :disabled="addingToCart"
          >
        </div>
        <button
          type="button"
          id="{{ product_atc_id }}"
          class="tw-bg-brand-secondary tw-grow tw-cursor-pointer tw-pointer-events-auto md:tw-text-12 tw-text-10 tw-uppercase tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center tw-py-2"
          @click="addToCart()"
          :disabled="addingToCart"
        >
          [[ addingToCart ? 'Adding...' : 'Add to Cart' ]]
        </button>
      </div>
    {% endif %}
  </div>
</div>

<script>
  new Vue({
    el: '#{{ product_id }}',
    delimiters: ['[[', ']]'],
    data() {
      return {
        addingToCart: false,
        productPrice: '{{ cur_product.price }}',
        quantity: {{ min_qty }},
      };
    },
    methods: {
      // Keep the typed quantity at or under stock / the rule max
      capQuantity(input) {
        const max = {{ qty_max | default: 'Infinity' }};
        if (Number(input.value) > max) {
          input.value = max;
          this.quantity = max;
        }
      },
      addToCart() {
        this.addingToCart = true;
        this.quantity = this.validQuantity(this.quantity, {{ min_qty }}, {{ qty_step }}, {{ qty_max | default: 'Infinity' }});
        let items = [
          {
            quantity: this.quantity,
            'properties': {
              '_tags': {{ cur_product.tags | json }},
              {%- if isbn != blank %}
              '_isbn': {{ isbn | append: '' | json }},
              {%- endif %}
            },
            id: '{{ cur_product.selected_or_first_available_variant.id }}',
          },
        ];

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw data;
          return data;
        }).then((data) => {
          // Same bus events as the related-products quick add, so the add-to-cart popup shows
          this.bus.$emit('cartItemAdded', data.items?.[0] || data);
          this.bus.$emit('refreshCart');
        }).catch((error) => {
          console.error('Unable to add item to cart', error);
          this.bus.$emit('cartFailedToAdd', error);
        }).finally(() => {
          this.addingToCart = false;
        });
      },
    },
  });
</script>
