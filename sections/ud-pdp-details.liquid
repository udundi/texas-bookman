{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Spacing Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 300,
      "step": 20,
      "unit": "px",
      "label": "Spacing Bottom",
      "default": 0
    },
    {
      "type": "select",
      "id": "layout_gallery_size",
      "label": "Layout Gallery Size",
      "info": "Determines the Width of the Gallery on Desktop",
      "options": [
        {
          "value": "w-full md:w-1/3",
          "label": "1/3 width"
        },
        {
          "value": "w-full md:w-1/2",
          "label": "1/2 width"
        },
        {
          "value": "w-full md:w-2/3",
          "label": "2/3 width"
        },
        {
          "value": "w-full md:w-3/4",
          "label": "3/4 width"
        }
      ],
      "default": "w-full md:w-2/3"
    }
  ],
  "blocks": [
    {
      "type": "_pdp-column"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product Details"
    }
  ]
}
{% endschema %}
