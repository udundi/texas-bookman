  {%- liquid
    # theme-check-disable
    capture content_for_query_string
      echo content_for_header
    endcapture
  -%}

  {% assign get_full_url = content_for_query_string
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | split: '.myshopify.com'
    | last
    | replace: '\/', '/'
    | replace: '%20', ' '
    | replace: '\u0026', '&'
    | replace: collection.url, ''
    | replace: 'feltright.com', ''
  %}
  {%- comment -%}
    A gate links to another collection. It renders nothing when that collection is missing or empty,
    unless it's the page you're on or something nested under it is. Children open when one is active.
  {%- endcomment -%}
  {%- assign linked_collection = block.settings.collection_gate -%}
  {%- assign is_current_gate = false -%}
  {%- if linked_collection != blank and collection.handle == linked_collection.handle -%}
    {%- assign is_current_gate = true -%}
  {%- endif -%}

  {%- capture child_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}
  {%- assign child_blocks = child_blocks | strip -%}
  {%- assign has_active_child = false -%}
  {%- if child_blocks contains 'data-filter-active' -%}
    {%- assign has_active_child = true -%}
  {%- endif -%}

  {%- assign show_gate = false -%}
  {%- if linked_collection != blank -%}
    {%- if linked_collection.products_count > 0 or is_current_gate or has_active_child -%}
      {%- assign show_gate = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- if show_gate -%}
    {%- comment -%} On the gate's own page, count what the shopper is looking at (filters applied). {%- endcomment -%}
    {%- if is_current_gate -%}
      {%- assign gate_count = collection.products_count -%}
    {%- else -%}
      {%- assign gate_count = linked_collection.products_count -%}
    {%- endif -%}
    {%- assign children_collapsed = true -%}
    {%- if is_current_gate or has_active_child -%}
      {%- assign children_collapsed = false -%}
    {%- endif -%}
    {%- assign query_params = get_full_url | replace: '?', '' | replace: '_fd=0&pb=0&', '' | split: '&' -%}

    <div class="tw-p-1">
      <div class="tw-flex tw-w-full tw-flex-col"{% if is_current_gate %} data-filter-active{% endif %}>
        <div class="tw-flex tw-w-full tw-items-center tw-gap-1">
          <a
            {% if query_params != blank %}
              {% if is_current_gate %}
                href="{{ routes.all_products_collection_url }}?{{ query_params | join: '&' }}"
              {% else %}
                href="{{ linked_collection.url }}?{{ query_params | join: '&' }}"
              {% endif %}
            {% else %}
              {% if is_current_gate %}
                href="{{ routes.all_products_collection_url }}"
              {% else %}
                href="{{ linked_collection.url }}"
              {% endif %}
            {% endif %}
            class="tw-flex tw-flex-1 tw-justify-center tw-items-center tw-gap-2 tw-group"
          >
            <div class="tw-border group-hover:tw-border-black  tw-border-offblack tw-size-4 tw-aspect-square tw-rounded-[4px] tw-p-0.5 tw-my-auto{% if is_current_gate %} tw-bg-black {% endif %}">
              <svg
                class=" tw-fill-white {% unless is_current_gate %} tw-hidden  {% endunless %}"
                viewBox="0 0 448 512"
              >
                <path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z" />
              </svg>
            </div>

            <p class=" group-hover:tw-underline tw-text-offblack tw-text-14 tw-w-full !tw-m-0">
              {{- block.settings.title | default: linked_collection.title }} ({{ gate_count }})
            </p>
          </a>
          {%- if child_blocks != blank -%}
            <button
              type="button"
              class="tw-flex-shrink-0 tw-fill-offblack tw-size-3 tw-cursor-pointer tw-bg-transparent tw-border-0 tw-p-0 tw-m-0"
              aria-label="Show subcategories of {{ block.settings.title | default: linked_collection.title | escape }}"
              @click="toggleFilter('{{ block.id }}', {{ children_collapsed }})"
            >
              <div
                class="tw-fill-offblack tw-size-3"
                v-if="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
              >
                {% render 'icon-arrow-up' %}
              </div>
              <div v-else class="tw-fill-offblack tw-size-3">{% render 'icon-arrow-down' %}</div>
            </button>
          {%- endif -%}
        </div>
        {%- if child_blocks != blank -%}
          <div
            class="tw-pl-4 tw-pt-1 tw-flex tw-flex-col tw-gap-[1px]"
            v-show="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
          >
            {{ child_blocks }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

{% schema %}
{
  "name": "Collection Gate",
  "settings": [
    {
      "type": "collection",
      "id": "collection_gate",
      "label": "Linked Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Link Title",
      "default": "Filter Title"
    }
  ],
  "blocks": [
    {
      "type": "_collection-gate"
    },
    {
      "type": "_collection-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Gate"
    }
  ]
}
{% endschema %}
