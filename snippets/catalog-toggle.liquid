{%- comment -%}
  US / UK catalog toggle (Figma "Catalog Toggles", "Navigation — Catalog toggle").
  Each option links to the current page with ?country=XX. Shopify switches
  the shopper's market from that parameter and remembers it in the
  localization cookie. Links rather than a localization form POST, because
  the CLI dev server rejects form posts with 401.

  Accepts:
  - form_id {String} unique id for the form
  - class {String} optional extra classes on the wrapper
{%- endcomment -%}
{%- if localization.available_countries.size > 1 -%}
  <div class="catalog-toggle-form" id="{{ form_id }}">
    <div class="catalog-toggle {{ class }}" role="group" aria-label="Catalog">
      {%- for country in localization.available_countries -%}
        {%- liquid
          assign label = country.name
          if country.iso_code == 'US'
            assign label = 'United States'
          elsif country.iso_code == 'GB'
            assign label = 'United Kingdom'
          endif
          assign current = false
          if country.iso_code == localization.country.iso_code
            assign current = true
          endif
        -%}
        <a
          href="{{ request.path }}?country={{ country.iso_code }}"
          class="catalog-toggle__option{% if current %} is-active{% endif %}"
          {% if current %}
            aria-current="true"
          {% endif %}
        >
          {{- label -}}
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .catalog-toggle-form {
    margin: 0;
  }
  .catalog-toggle {
    display: flex;
    width: 100%;
    padding: 2px;
    background: #f1f1f1;
  }
  .catalog-toggle__option {
    flex: 1 1 0;
    display: block;
    text-align: center;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 0;
    background: transparent;
    color: #6b6b6b;
    font-family: 'proxima-nova', sans-serif;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .catalog-toggle__option:hover {
    color: #212121;
  }
  .catalog-toggle__option.is-active {
    background: #20448f;
    color: #ffffff;
    font-weight: 600;
    cursor: default;
  }
  .catalog-toggle__option:focus-visible {
    outline: 2px solid #20448f;
    outline-offset: 2px;
  }
{% endstylesheet %}
