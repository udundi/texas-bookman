<!-- Used In Product Details Section -->
{% comment %}{% render 'ud-product-thumb-image', thumb_image: image, thumb_number: slide_number %}{% endcomment %}

<button
  class="swiper-slide tw-h-fit tw-w-full tw-max-w-20 tw-cursor-pointer tw-aspect-3/4"
  @click="goToSlide({{ thumb_number }})"
>
  {{
    thumb_image
    | image_url: width: 120
    | image_tag:
      class: 'tw-h-full tw-w-full tw-object-cover tw-object-center tw-rounded-md tw-border tw-border-solid tw-border-black'
  }}
</button>
