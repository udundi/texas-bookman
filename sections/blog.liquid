{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{% style %}
  .ud-blog-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .ud-blog-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section
  class="ud-blog-{{ section.id }} tw-w-full"
  id="ud-blog-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tw-mx-auto tw-px-6 tw-max-w-screen-2xl tw-w-full">
    {%- assign heading = section.settings.heading | default: blog.title -%}
    {%- if heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="tw-font-semibold tw-mb-2 tw-font-montserrat"
        style="
          color: {{ section.settings.heading_color }};
          font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);
          text-align: {{ section.settings.heading_alignment }};
        "
      >
        {{ heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p
        class="tw-mb-9 tw-font-montserrat tw-max-w-2xl"
        style="color: {{ section.settings.subtext_color }}; font-size: {{ section.settings.subtext_size }}px; text-align: {{ section.settings.subtext_alignment }};"
      >
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    <div class="tw-flex tw-items-center tw-justify-between tw-mb-6">
      <p class="tw-font-semibold tw-text-18 tw-text-offblack tw-m-0 tw-font-montserrat">
        Showing {{ blog.articles_count }} Article{% if blog.articles_count != 1 %}s{% endif %}
      </p>
    </div>

    <div class="tw-flex tw-flex-col">
      {%- paginate blog.articles by 5 -%}
        {%- for article in blog.articles -%}
          {%- assign published_date = article.published_at | date: '%B %-d, %Y' -%}
          {%- assign excerpt = article.excerpt | strip_html | truncatewords: 30 -%}
          {%- render 'ud-blog-card',
            section: section,
            image: article.image,
            image_alt: article.title,
            title: article.title,
            title_url: article.url,
            author: article.author,
            published_date: published_date,
            description: excerpt,
            cta_label: 'Read More',
            cta_url: article.url
          -%}
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div class="tw-mt-4">
            {{- paginate | default_pagination -}}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the blog's title when left blank"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#212121"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Min Size (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Max Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 40
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#212121"
    },
    {
      "type": "select",
      "id": "subtext_alignment",
      "label": "Subtext Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext Font Size (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Article Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "color",
      "id": "article_title_color",
      "label": "Article Title Color",
      "default": "#20448F"
    },
    {
      "type": "range",
      "id": "article_title_size",
      "label": "Article Title Size (px)",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta (author/date) Color",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta Font Size (px)",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA Background",
      "default": "#20448F"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_font_size",
      "label": "CTA Font Size (px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "cta_border_radius",
      "label": "CTA Border Radius (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 2
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FDFBF8"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width (px)",
      "min": 600,
      "max": 1600,
      "step": 40,
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ]
}
{% endschema %}
