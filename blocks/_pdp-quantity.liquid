<!-- Quantity Selector -->
<!-- Standard quantity selector -->
<div
  class="
    {% if block.settings.visibility contains 'mobile' %}
      tw-flex
      md:tw-hidden
    {% elsif block.settings.visibility contains "desktop" %}
      tw-hidden
      md:tw-flex
    {% else %}
      tw-flex
    {% endif %} tw-flex-col tw-gap-1
  "
>
  {% if customer == null %}
    <a
      href="{{ routes.account_login_url }}"
      class="tw-uppercase tw-bg-brand-primary tw-text-brand-eggshell tw-py-2.5 tw-px-4 tw-rounded-[4px] tw-text-center tw-font-semibold tw-text-14 tw-transition-all hover:tw-brightness-95 tw-block"
    >
      Sign in to shop
    </a>
  {% else %}
    {% assign min_qty = product.selected_or_first_available_variant.quantity_rule.min | default: 1 %}
    {% assign qty_step = product.selected_or_first_available_variant.quantity_rule.increment | default: 1 %}
    <label class="tw-font-montserrat tw-text-16 tw-font-semibold tw-text-offblack"
      >QTY
      {%- if min_qty > 1 or qty_step > 1 %}
        <span class="tw-font-normal">
          {%- if min_qty > 1 %}(Minimum Required {{ min_qty }}{% if qty_step > 1 %}, multiples of {{ qty_step }}{% endif %}){% else %}(Multiples of {{ qty_step }}){% endif -%}
        </span>
      {%- endif -%}
    </label>
    <div class="tw-flex tw-w-full tw-pb-2">
      <div class="tw-relative tw-flex tw-max-w-28 tw-items-center tw-rounded-[4px] tw-bg-brand-eggshell tw-border tw-border-brand-grey">
        <button
          type="button"
          id="decrement-button"
          @click="quantity = validQuantity(quantity - qtyStep, minQty, qtyStep)"
          :disabled="quantity <= minQty"
          :class="quantity <= minQty ? 'tw-cursor-not-allowed' : ''"
          class="tw-bg-brand-bg-dark tw-rounded-[4px] tw-pl-4 tw-pr-2"
        >
          {% render 'icon-minus' %}
        </button>
        <label class="tw-hidden" for="quantity-input">Quantity</label>
        <input
          type="integer"
          id="quantity-input"
          aria-label="quantity"
          name="quantity"
          min="{{ min_qty }}"
          step="{{ qty_step }}"
          max="100"
          @keydown="if (isNaN(parseInt(event.key)) && event.key != 'Backspace') { event.preventDefault(); }"
          @input="quantity < 1 ? quantity = 1 : quantity = quantity"
          @change="quantity = validQuantity(quantity, minQty, qtyStep)"
          max="{{ product.selected_or_first_available_variant.inventory_quantity }}"
          v-model="quantity"
          class="tw-text-sm tw-block tw-h-10 tw-w-full tw-py-1 tw-text-center tw-text-offblack"
          required
        >
        <button
          type="button"
          id="increment-button"
          aria-label="increase quantity by 1"
          @click="quantity = validQuantity(Number(quantity) + qtyStep, minQty, qtyStep)"
          class="tw-bg-brand-bg-dark tw-rounded-[4px] tw-pl-2 tw-pr-4"
        >
          {% render 'icon-plus' %}
        </button>
      </div>
      <!-- Add to Cart Button -->
      <button
        type="submit"
        @click="addToCart()"
        class="tw-ml-2 tw-w-full tw-rounded-[4px] tw-bg-brand-primary tw-py-2 tw-text-sm tw-font-semibold tw-text-brand-eggshell tw-flex tw-justify-center"
      >
        <span v-if="!addingToCart"> Add to Cart </span>
        <div v-if="addingToCart" class="tw-animate-spin tw-size-6 tw-fill-white">
          {% render 'icon-spin' %}
        </div>
      </button>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "PDP Quantity",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "PDP Quantity"
    }
  ]
}
{% endschema %}
