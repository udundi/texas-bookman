<div class="tw-flex tw-flex-col tw-gap-4 tw-items-center">
  <div class="tw-w-full tw-h-full tw-flex tw-items-center sm:tw-gap-4 tw-py-4">
    <!-- Desktop Prev Button -->
    <button
      class="tw-bg-grey-light tw-m-2 tw-size-12 tw-aspect-square tw-rounded-md tw-border-none md:tw-flex tw-hidden tw-items-center tw-justify-center tw-cursor-pointer tw-drop-shadow-lg tw-pointer-events-auto tw-shrink-0"
      id="featured-swiper-prev-{{ block.id }}"
    >
      {% render 'icon-chevron-left' %}
    </button>
    <!-- Swiper Container -->
    <div class="tw-w-full swiper tw-border-l tw-border-brand-grey block-{{ block.id }}">
      <div class="swiper-wrapper tw-h-full">
        {% if block.settings.product_source == 'product_list' %}
          {% for car_product in block.settings.product_list limit: 15 %}
            <div class="swiper-slide tw-border tw-border-brand-grey tw-border-l-0 !tw-h-full">
              {% render 'ud-basic-product-card',
                cur_product: car_product,
                video_aspect: true,
                no_border: true,
                small_card: true,
                button_style: section.settings.button_style,
                product_reviews: 5,
                show_button_type: 'quick-add',
                button_text: section.settings.button_text,
                show_price: section.settings.show_price
              %}
            </div>
          {% endfor %}
        {% else %}
          {% for car_product in block.settings.collection limit: 15 %}
            <div class="swiper-slide">
              {% render 'ud-basic-product-card',
                cur_product: car_product,
                video_aspect: true,
                no_border: true,
                small_card: true,
                button_style: section.settings.button_style,
                product_reviews: 5,
                show_button_type: 'quick-add',
                button_text: section.settings.button_text,
                show_price: section.settings.show_price
              %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
    <!-- Next Button -->
    <button
      class="tw-bg-grey-light tw-aspect-square tw-size-12 tw-m-2 tw-rounded-md tw-border-none md:tw-flex tw-hidden tw-items-center tw-justify-center tw-cursor-pointer tw-drop-shadow-lg tw-pointer-events-auto tw-shrink-0"
      id="featured-swiper-next-{{ block.id }}"
    >
      {% render 'icon-chevron-right' %}
    </button>
  </div>
</div>

<script>
  var swiper = new Swiper('.block-{{ block.id }}', {
    slidesPerView: {{ block.settings.mobile_slides }},
    loop: true,
    breakpoints: {
      425: {
        slidesPerView: {{ block.settings.tablet_slides }},
      },
      768: {
        slidesPerView: {{ block.settings.sm_desktop_slides }},
      },
      1024: {
        slidesPerView: {{ block.settings.lg_desktop_slides }},
      },
    },
    // Disable all automatic slide advancement from pointer/touch events
    touchStartPreventDefault: false,

    navigation: {
      nextEl: '#featured-swiper-next-{{ block.id }}',
      prevEl: '#featured-swiper-prev-{{ block.id }}',
    },
  });
</script>

{% schema %}
{
  "name": "Basic Product Carousel",
  "settings": [
    {
      "type": "select",
      "id": "product_source",
      "label": "Product Source",
      "options": [
        {
          "label": "Collection",
          "value": "collection"
        },
        {
          "label": "Product List",
          "value": "product_list"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "label": "Collection for Carousel",
      "id": "collection"
    },
    {
      "type": "product_list",
      "label": "Select Products",
      "id": "product_list"
    },
    {
      "type": "url",
      "label": "Button Url",
      "id": "button_url"
    },
    {
      "type": "text",
      "label": "Button Text",
      "id": "button_text"
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "label": "Mobile Slide Count",
      "default": 1.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "tablet_slides",
      "label": "Tablet Slide Count",
      "default": 3.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "sm_desktop_slides",
      "label": "Small Desktop Slide Count",
      "default": 4.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "lg_desktop_slides",
      "label": "Large Desktop Slide Count",
      "default": 6,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "header",
      "content": "Product Display"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Basic Product Carousel"
    }
  ]
}
{% endschema %}
