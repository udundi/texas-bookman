<!-- Tab Group -->
<div class="tw-group tw-relative tw-flex tw-h-full tw-bg-brand-eggshell tw-items-center tw-justify-center">
  <button
    class="tw-relative tw-hidden tw-border-y-2 tw-border-solid tw-border-transparent group-hover:tw-border-b-brand-primary group-hover:tw-text-brand-primary md:tw-py-[7px] tw-py-3 md:tw-px-0 tw-px-1.5 tw-font-brand-body !tw-text-12 tw-font-semibold md:tw-block tw-text-offblack hover:tw-text-brand-primary tw-leading-[15px] tw-tracking-[0.05em] tw-whitespace-nowrap tw-transition-colors tw-uppercase"
    @click="selectedTab = '{{ block.id }}'; positionDropdown('{{ block.id }}')"
    @mouseenter="selectedTab = '{{ block.id }}'; selectedSubTab = ''; positionDropdown('{{ block.id }}')"
  >
    {{ block.settings.header }}
  </button>
  <!-- Mobile Button -->
  <button
    class="tw-relative tw-flex tw-w-full tw-items-center tw-justify-between tw-gap-2 tw-border-0 tw-border-b tw-border-brand-grey tw-border-solid tw-bg-white tw-px-4 tw-py-4 tw-text-start tw-font-brand-body !tw-text-14 tw-font-semibold tw-uppercase tw-text-offblack"
    @click="selectedTab = '{{ block.id }}';"
    :class="selectedTab ? 'tw-hidden' : 'md:tw-hidden'"
  >
    <span>{{ block.settings.header }}</span>
    <span class="tw-size-3 tw-flex-shrink-0 tw-fill-offblack">{% render 'icon-chevron-right' %}</span>
  </button>
  <!-- Dropdown: sized to its content, centered under its tab, shifted back on screen if it would overflow -->
  <div
    v-show="selectedTab === '{{ block.id }}'"
    data-tab-id="{{ block.id }}"
    data-offset="{{ block.settings.dropdown_offset }}"
    class="nav-dropdown md:tw-absolute tw-flex tw-w-full md:tw-w-max tw-flex-col md:tw-flex-row md:tw-left-1/2 tw-top-full tw-max-w-screen-2xl md:-tw-translate-x-1/2 md:tw-z-50 tw-min-h-0 tw-text-black"
  >
    <!-- Mobile Level 2 Header: Back / Close -->
    <div class="tw-flex tw-w-full tw-items-center tw-justify-between tw-border-0 tw-border-b tw-border-brand-grey tw-border-solid tw-bg-white tw-px-4 tw-py-4 md:tw-hidden">
      <button
        type="button"
        class="tw-flex tw-items-center tw-gap-1 tw-text-14 tw-font-semibold tw-uppercase tw-text-offblack"
        @click="selectedTab = ''; selectedSubTab = ''"
      >
        <span class="tw-size-3 tw-fill-offblack">{% render 'icon-chevron-left' %}</span>
        Back
      </button>
      <button
        type="button"
        class="tw-flex tw-size-6 tw-items-center tw-justify-center tw-rounded-full tw-border tw-border-offblack"
        aria-label="Close menu"
        @click="closeMobileNav()"
      >
        <span class="tw-size-3 tw-fill-offblack">{% render 'icon-close' %}</span>
      </button>
    </div>
    <div
      class="md:tw-flex-row tw-flex-col tw-flex tw-h-full md:tw-overflow-y-auto max-md:tw-overflow-visible tw-w-full tw-min-h-0"
    >
      <div class="tw-flex md:tw-flex-row tw-flex-col tw-h-full tw-min-h-0 tw-border-brand-grey tw-border md:tw-shadow-lg tw-bg-brand-eggshell md:tw-mx-auto max-md:tw-w-full">
        {% for sub_block in block.blocks %}
          {% render sub_block %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tabbed Header Container",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header Tab Title"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Dropdown",
      "default": false
    },
    {
      "type": "range",
      "id": "dropdown_offset",
      "label": "Dropdown Horizontal Offset (px)",
      "min": -600,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 0,
      "info": "Shift dropdown left (negative) or right (positive) from tab center on desktop"
    }
  ],
  "blocks": [
    {
      "type": "_header-menu-links"
    },
    {
      "type": "_header-products"
    }
  ]
}
{% endschema %}
