{% capture contact_block %}
  <div class="tw-flex tw-flex-row max-md:tw-justify-center tw-text-12">
    <a href="tel:{{ section.settings.phone | replace: '(', '' | replace: ')', '' | replace: ' ', '' | replace: '-', '' }}" class='tw-block tw-pr-4 tw-border-r-2 tw-border-navy tw-underline'>
      {{- section.settings.phone -}}
    </a>
    <a href="mailto:{{ section.settings.email }}" class='tw-pl-4 tw-block tw-underline'>{{ section.settings.email }}</a>
  </div>
  <span class='tw-mt-2 tw-text-12 tw-block'>Hours: 8am-4pm MST M-F</span>
{% endcapture %}

<div class="tw-w-full tw-flex tw-flex-col tw-overflow-hidden tw-relative tw-z-[100] tw-bg-white tw-pt-4">

  <!-- Main Grid Container -->
  <div class="md:tw-px-4 tw-mx-auto tw-w-full tw-flex tw-items-center lg:tw-justify-between tw-justify-center tw-max-w-screen-2xl tw-gap-x-12 max-lg:tw-flex-col md:tw-gap-y-16 sm:tw-pb-12">
    <!-- Left Info Container -->
    <div class="tw-flex tw-flex-col tw-items-center md:tw-justify-between tw-justify-center max-sm:tw-gap-x-7 md:tw-gap-y-4 tw-text-navy sm:tw-w-fit tw-w-full">
      <!-- Logo Container -->
      <div class="tw-flex tw-gap-4 md:tw-flex-col tw-flex-row tw-items-start">
        <!-- Logo -->
        <a
          class="tw-size-20"
          href="/"
          rel="home">
          {{ section.settings.logo | image_url: width: '150' | image_tag: alt: 'Felt Right Logo' }}
        </a>


        <!-- Slogan -->
        <div class="tw-text-navy tw-font-playfair md:tw-text-24 tw-text-20 md:tw-w-48 tw-w-40 tw-font-medium tw-leading-6">
          <!-- Slogan Top Line -->
          <div class="tw-w-full tw-text-start">Feel better in</div>
          <!-- Slogan Bottom Line -->
          <div class="tw-italic tw-w-full tw-text-end">your own space</div>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="md:tw-pt-8 tw-pt-4 max-md:tw-pb-4 tw-font-semibold max-md:tw-text-center tw-w-full max-sm:tw-border-t-2 max-sm:tw-border-b-2 tw-border-solid tw-border-grey-darker">
        {{ contact_block }}
      </div>

    </div>

    <!-- Right Menu Container -->
    <div class="md:tw-flex sm:tw-grid tw-grid-cols-3 tw-flex md:tw-flex-row tw-flex-col max-md:tw-w-full tw-gap-x-6 sm:tw-gap-y-4 md:tw-justify-evenly sm:tw-justify-start tw-justify-center sm:tw-items-start tw-items-center">
      <!-- Footer Link Lists -->
      {% for block in section.blocks %}
        <div class="tw-w-full tw-flex tw-justify-center">
          {% render 'ud-footer-links-v2'
            , title: block.settings.menu.title
            , links: block.settings.menu.links
            , is_first: forloop.first
            , is_last: forloop.last
          %}
        </div>
      {% endfor %}
    </div>
  </div>

</div>

{% schema %}
  {
    "name": "Main Footer",
    "tag": "footer",
    "blocks": [
      {
        "name": "Footer Menu",
        "type": "menu",
        "settings": [
          {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "link_list",
        "id": "legal_menu",
        "label": "Legal Pages Menu"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "header",
        "content": "Social"
      },
      {
        "type": "header",
        "content": "Contact"
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Phone",
        "info": "Pattern: (123) 456-7890"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email"
      },
      {
        "type": "text",
        "id": "hours",
        "label": "Hours"
      }
    ],
    "presets": [
      {
        "name": "Main Footer"
      }
    ]
  }
{% endschema %}