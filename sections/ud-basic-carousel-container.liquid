{% style %}
  .section-outer-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}rem;
    padding-bottom: {{ section.settings.padding_bottom }}rem;
  }

  .section-{{ section.id }} {
    padding-left: {{ section.settings.padding_left }}rem;
    {% if section.settings.container_width == 'full_width' %}
      width: 100%;
    {% elsif section.settings.container_width == 'lg_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'md_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'sm_desktop' %}
      max-width: var(--container-width, 1280px);
    {% elsif section.settings.container_width == 'tablet' %}
      max-width: var(--container-width, 768px);
    {% else section.settings.container_width == 'mobile' %}
      max-width: var(--container-width, 448px);
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .section-outer-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}rem;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}rem;
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-left: {{ section.settings.mobile_padding_left }}rem;
      padding-right: {{ section.settings.mobile_padding_right }}rem;
    }
  }
{% endstyle %}

<div class="section-outer-{{ section.id }}">
  <div class="section-{{ section.id }} tw-mx-auto">
    {% if section.settings.section_title != blank %}
      <div class="tw-flex tw-justify-between md:tw-px-20 tw-py-4">
        <div class=" tw-font-playfair tw-font-semibold tw-w-full md:tw-text-36 tw-text-22 tw-leading-tight tw-text-center tw-text-offblack">
          {{ section.settings.section_title }}
        </div>
        <!-- Desktop Button -->
        <a
          href="{{ section.settings.button_url }}"
          class="tw-bg-brand-primary tw-uppercase tw-font-semibold tw-text-white tw-py-2 tw-px-4 tw-w-full tw-hidden md:tw-flex tw-items-center tw-justify-center tw-max-w-64 tw-rounded-md"
        >
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
    <div class="tw-flex tw-flex-col tw-gap-4 tw-items-center">
      <div class="tw-w-full tw-h-full tw-flex tw-items-center sm:tw-gap-4 tw-py-4">
        <!-- Desktop Prev Button -->
        <button
          class="tw-bg-grey-light tw-m-2 tw-size-12 tw-aspect-square tw-rounded-full tw-border-none md:tw-flex tw-hidden tw-items-center tw-justify-center tw-cursor-pointer tw-drop-shadow-lg tw-pointer-events-auto tw-shrink-0"
          id="featured-swiper-prev-{{ section.id }}"
        >
          {% render 'icon-chevron-left' %}
        </button>
        <!-- Swiper Container -->
        <div class="tw-w-full swiper tw-border-l tw-border-offblack carousel-{{ section.id }}">
          <div class="swiper-wrapper tw-h-full">
            {% if section.settings.product_source == 'product_list' %}
              {% for car_product in section.settings.product_list limit: 15 %}
                <div class="swiper-slide tw-border tw-border-offblack tw-border-l-0 !tw-h-full">
                  {% render 'ud-basic-product-card',
                    cur_product: car_product,
                    video_aspect: true,
                    no_border: true,
                    small_card: true,
                    button_style: section.settings.button_style,
                    product_reviews: 5,
                    show_button_type: 'quick-add',
                    button_text: section.settings.button_text,
                    show_price: section.settings.show_price
                  %}
                </div>
              {% endfor %}
            {% else %}
              {% for car_product in section.settings.collection limit: 15 %}
                <div class="swiper-slide">
                  {% render 'ud-basic-product-card',
                    cur_product: car_product,
                    video_aspect: true,
                    no_border: true,
                    small_card: true,
                    button_style: section.settings.button_style,
                    product_reviews: 5,
                    show_button_type: 'quick-add',
                    button_text: section.settings.button_text,
                    show_price: section.settings.show_price
                  %}
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
        <!-- Next Button -->
        <button
          class="tw-bg-grey-light tw-aspect-square tw-size-12 tw-m-2 tw-rounded-full tw-border-none md:tw-flex tw-hidden tw-items-center tw-justify-center tw-cursor-pointer tw-drop-shadow-lg tw-pointer-events-auto tw-shrink-0"
          id="featured-swiper-next-{{ section.id }}"
        >
          {% render 'icon-chevron-right' %}
        </button>
      </div>
      <!-- Mobile Button -->
      <a
        href="{{ section.settings.button_url }}"
        class="tw-bg-brand-primary tw-uppercase tw-font-semibold tw-text-white tw-py-2 tw-px-4 tw-w-full md:tw-hidden tw-flex tw-items-center tw-justify-center tw-max-w-96 tw-rounded-sm"
      >
        {{ section.settings.button_text }}
      </a>
    </div>
  </div>
</div>

<script>
  var swiper = new Swiper('.carousel-{{ section.id }}', {
    slidesPerView: {{ section.settings.mobile_slides }},
    loop: true,
    breakpoints: {
      425: {
        slidesPerView: {{ section.settings.tablet_slides }},
      },
      768: {
        slidesPerView: {{ section.settings.sm_desktop_slides }},
      },
      1024: {
        slidesPerView: {{ section.settings.lg_desktop_slides }},
      },
    },
    // Disable all automatic slide advancement from pointer/touch events
    touchStartPreventDefault: false,

    navigation: {
      nextEl: '#featured-swiper-next-{{ section.id }}',
      prevEl: '#featured-swiper-prev-{{ section.id }}',
    },
  });
</script>

{% schema %}
{
  "name": "Basic Product Carousel",
  "settings": [
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_left",
      "label": "Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_right",
      "label": "Padding Right",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_left",
      "label": "Mobile Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_right",
      "label": "Mobile Padding Right",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Max Width Of Section",
      "options": [
        {
          "value": "mobile",
          "label": "448px (Mobile)"
        },
        {
          "value": "tablet",
          "label": "768px (Tablet)"
        },
        {
          "value": "sm_desktop",
          "label": "1024px (Sm Desktop)"
        },
        {
          "value": "md_desktop",
          "label": "1280px (Md Desktop)"
        },
        {
          "value": "lg_desktop",
          "label": "1440px (Lg Desktop)"
        },
        {
          "value": "full_width",
          "label": "Full Width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product Source",
      "options": [
        {
          "label": "Collection",
          "value": "collection"
        },
        {
          "label": "Product List",
          "value": "product_list"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "label": "Collection for Carousel",
      "id": "collection"
    },
    {
      "type": "product_list",
      "label": "Select Products",
      "id": "product_list"
    },
    {
      "type": "url",
      "label": "Button Url",
      "id": "button_url"
    },
    {
      "type": "text",
      "label": "Button Text",
      "id": "button_text"
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "label": "Mobile Slide Count",
      "default": 1.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "tablet_slides",
      "label": "Tablet Slide Count",
      "default": 3.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "sm_desktop_slides",
      "label": "Small Desktop Slide Count",
      "default": 4.3,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    },
    {
      "type": "range",
      "id": "lg_desktop_slides",
      "label": "Large Desktop Slide Count",
      "default": 6,
      "step": 0.1,
      "unit": "img",
      "min": 1,
      "max": 8
    }
  ],
  "presets": [
    {
      "name": "Basic Product Carousel"
    }
  ]
}
{% endschema %}
