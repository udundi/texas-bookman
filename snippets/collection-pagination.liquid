{% comment %}
  Renders a custom pagination bar with page numbers and a "Results per page" dropdown.
  Usage:
    {% render 'collection-pagination', paginate: paginate, items_per_page: items_per_page %}
{% endcomment %}

{% assign per_page_options = '20,40,60,80,100' | split: ',' %}

<div class="tw-flex tw-flex-wrap tw-items-center tw-mx-auto tw-mt-[-1px] tw-justify-between tw-gap-4  tw-py-4 tw-px-4">
  <!-- Page Number Navigation -->
  {% comment %}
    <nav aria-label="Pagination" class="tw-flex tw-items-center tw-gap-1">
      <!-- Previous Arrow -->
      {% if paginate.previous %}
        <a
          href="{{ paginate.previous.url }}"
          aria-label="Previous page"
          class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-gray-300 tw-text-offblack hover:tw-bg-gray-100 tw-transition-colors"
        >
          <svg class="tw-w-3 tw-h-3" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z"/>
          </svg>
        </a>
      {% else %}
        <span
          aria-disabled="true"
          class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-gray-200 tw-text-gray-300 tw-cursor-not-allowed"
        >
          <svg class="tw-w-3 tw-h-3" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z"/>
          </svg>
        </span>
      {% endif %}

      <!-- Page Parts -->
      {% for part in paginate.parts %}
        {% if part.is_link %}
          <a
            href="{{ part.url }}"
            aria-label="Page {{ part.title }}"
            class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-gray-300 tw-text-14 tw-text-offblack hover:tw-bg-gray-100 tw-transition-colors"
          >
            {{ part.title }}
          </a>
        {% else %}
          {% if part.title == paginate.current_page %}
            <span
              aria-current="page"
              aria-label="Page {{ part.title }}, current page"
              class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-brand-primary tw-bg-brand-primary tw-text-14 tw-font-semibold tw-text-white"
            >
              {{ part.title }}
            </span>
          {% else %}
            <span class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-text-14 tw-text-gray-400">
              {{ part.title }}
            </span>
          {% endif %}
        {% endif %}
      {% endfor %}

      <!-- Next Arrow -->
      {% if paginate.next %}
        <a
          href="{{ paginate.next.url }}"
          aria-label="Next page"
          class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-gray-300 tw-text-offblack hover:tw-bg-gray-100 tw-transition-colors"
        >
          <svg class="tw-w-3 tw-h-3" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="M278.6 406.6c-12.5 12.5-32.8 12.5-45.3 0l-192-192c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L256 338.7l169.4-169.4c12.5-12.5 32.8-12.5 45.3 0s12.5 32.8 0 45.3l-192 192z"/>
          </svg>
        </a>
      {% else %}
        <span
          aria-disabled="true"
          class="tw-flex tw-items-center tw-justify-center tw-w-8 tw-h-8 tw-border tw-border-gray-200 tw-text-gray-300 tw-cursor-not-allowed"
        >
          <svg class="tw-w-3 tw-h-3" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
            <path d="M278.6 406.6c-12.5 12.5-32.8 12.5-45.3 0l-192-192c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L256 338.7l169.4-169.4c12.5-12.5 32.8-12.5 45.3 0s12.5 32.8 0 45.3l-192 192z"/>
          </svg>
        </span>
      {% endif %}
    </nav>
  {% endcomment %}

  <!-- Results Per Page -->
  <div class="tw-flex tw-items-center tw-gap-2">
    <span class="tw-text-14 tw-text-offblack tw-whitespace-nowrap">Results per page:</span>
    <div class="tw-relative tw-flex tw-items-center">
      <select
        aria-label="Results per page"
        class="tw-appearance-none tw-border tw-border-gray-300 tw-pl-3 tw-pr-8 tw-py-1.5 tw-text-14 tw-text-offblack tw-bg-white tw-cursor-pointer hover:tw-border-gray-400 tw-transition-colors"
        onchange="
          (function(val) {
            var url = new URL(window.location.href);
            url.searchParams.set('limit', val);
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
          })(this.value)
        "
      >
        {% for option in per_page_options %}
          {% assign option_int = option | plus: 0 %}
          <option
            value="{{ option_int }}"
            {% if option_int == items_per_page %}
              selected
            {% endif %}
          >
            {{ option_int }}
          </option>
        {% endfor %}
      </select>
      <div class="tw-pointer-events-none tw-absolute tw-right-2 tw-top-1/2 -tw-translate-y-1/2 tw-fill-offblack tw-size-3">
        {% render 'icon-arrow-down' %}
      </div>
    </div>
  </div>
</div>
