            "rich_text_KqYxxp": {
              "type": "rich-text",
              "name": "Rich Text",
              "settings": {
                "text": "<p>Founded in 2011 and specializing in bringing classic and hard-to-find esoteric texts back into print. At Lost Library, we believe that some books should never fade into obscurity. Our publishing house is dedicated to reprinting the rare, and mysterious, works that deserve another chapter in the modern world. Specializing in esoteric texts, hidden mythologies, and timeless curiosities, we carefully select titles that spark the mind and keep wisdom alive for new generations of readers.<br/><br/>Think of us as book archaeologists dusting off forgotten treasures and giving them fresh ink and new life. Whether it's a long-lost manual of ancient knowledge, an overlooked spiritual guide, or a cult classic that slipped through the cracks, Lost Library makes sure these stories aren't just remembered, but beautifully reimagined for today's shelves.</p>",
                "align": "start",
                "color": "#000000",
                "max_width": 1000
              },
              "blocks": {}
            },
            "rich_text_VWVML9": {
              "type": "rich-text",
              "name": "Rich Text",
              "settings": {
                "text": "<p><em>Because sometimes the most magical discoveries aren't found in the new releases; they're rediscovered in the Lost Library.</em></p>",
                "align": "start",
                "color": "#20438D",
                "max_width": 1000
              },
              "blocks": {}
            }
