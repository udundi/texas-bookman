<style>
  .block-{{ block.id }} {
    border-width: {{ block.settings.border }}px;
    border-style: solid;
    border-color: {{ block.settings.border_color }};
    max-width: {{ block.settings.max_width }}px;

  }
  @media screen and (max-width: 749px) {
    .block-{{ block.id }} {
      max-width: {{ block.settings.mobile_max_width }}px;
    }
  }
</style>
{% if block.settings.image != blank %}
  <img
    srcset="
      {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
      {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
      {%- if block.settings.image.width >= 533 -%}{{ block.settings.image | image_url: width: 533 }} 533w,{%- endif -%}
      {%- if block.settings.image.width >= 720 -%}{{ block.settings.image | image_url: width: 720 }} 720w,{%- endif -%}
      {%- if block.settings.image.width >= 940 -%}{{ block.settings.image | image_url: width: 940 }} 940w,{%- endif -%}
      {%- if block.settings.image.width >= 1066 -%}{{ block.settings.image | image_url: width: 1066 }} 1066w,{%- endif -%}
      {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
    "
    src="{{ block.settings.image | image_url: width: 400 }}"
    alt="{{ block.settings.image.alt | escape }}"
    class="
      block-{{ block.id }}
      tw-object-contain
    "
    loading="lazy"
    width="100%"
    height="100%">
{% else %}
  {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-max-w-12 tw-aspect-square tw-h-full tw-object-contain' }}
{% endif %}

{% schema %}
  {
    "name": "Icon",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "header",
        "content": "Max Width of Image"
      },
      {
        "type": "range",
        "min": 0,
        "max": 400,
        "step": 4,
        "unit": "px",
        "id": "max_width",
        "label": "Desktop",
        "default": 120
      },
      {
        "type": "range",
        "min": 0,
        "max": 400,
        "step": 4,
        "unit": "px",
        "id": "mobile_max_width",
        "label": "Mobile",
        "default": 120
      },
      {
        "type": "header",
        "content": "Image Border"
      },
      {
        "type": "range",
        "id": "border",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "Image Border",
        "default": 0
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border Color"
      }
    ],
    "presets": [
      {
        "name": "Icon"
      }
    ]
  }
{% endschema %}