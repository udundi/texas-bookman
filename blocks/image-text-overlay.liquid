    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "square",
          "label": "Square (1 / 1)"
        },
        {
          "value": "2/3",
          "label": "Tall Photo (2 / 3)"
        },
        {
          "value": "3/4",
          "label": "Tall Photo (3 / 4)"
        },
        {
          "value": "4/5",
          "label": "Tall Photo (4 / 5)"
        },
        {
          "value": "5/6",
          "label": "Tall Photo (5 / 6)"
        },
        {
          "value": "6/7",
          "label": "Tall Photo (6 / 7)"
        },
        {
          "value": "9/10",
          "label": "Tall Photo (9 / 10)"
        },
        {
          "value": "video",
          "label": "Video (16 / 9)"
        },
        {
          "value": "8/3",
          "label": "Wide Banner (8 / 3)"
        },
        {
          "value": "10/9",
