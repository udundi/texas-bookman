<div
  class="
    {% if block.settings.visibility contains 'mobile' %}
      tw-contents
      md:tw-hidden
    {% elsif block.settings.visibility contains "desktop" %}
      tw-hidden
      md:tw-contents
    {% else %}
      tw-contents
    {% endif %}
  "
>
  {% comment %}
    Case-pack products carry a second "Case" variant (Pack Size option) that holds no stock of its
    own; cases are filled from the Single variant's stock. The discount is read from the Case price
    so the promo always matches what the cart charges.
  {% endcomment %}
  {% assign single_variant = product.selected_or_first_available_variant %}
  {% assign case_variant = nil %}
  {% for variant in product.variants %}
    {% if variant.option1 == 'Case' %}
      {% assign case_variant = variant %}
    {% elsif single_variant.option1 == 'Case' %}
      {% assign single_variant = variant %}
    {% endif %}
  {% endfor %}
  {% assign case_size = product.metafields.custom.case_size.value
    | default: case_variant.metafields.custom.case_quantity.value
    | default: 1
  %}
  {% assign available = single_variant.inventory_quantity | at_least: 0 %}
  {% comment %} Same sellable count as sections/ud-pdp-details.liquid {% endcomment %}
  {% assign sellable = available %}
  {% if settings.max_sellable_per_item > 0 and sellable > settings.max_sellable_per_item %}
    {% assign sellable = settings.max_sellable_per_item %}
  {% endif %}
  {% assign cases_available = sellable | divided_by: case_size %}
  {% assign case_saving_pct = 0 %}
  {% if case_variant and case_size > 1 %}
    {% assign case_full_price = single_variant.price | times: case_size %}
    {% assign case_saving_pct = case_full_price
      | minus: case_variant.price
      | times: 100.0
      | divided_by: case_full_price
      | round
    %}
  {% endif %}
  <div class="tw-flex tw-flex-col tw-py-2 tw-px-3 tw-rounded-[4px] tw-bg-brand-eggshell tw-border tw-border-brand-grey tw-items-start tw-gap-1">
    <div>
      <span class="tw-font-semibold">Availability:</span>
      {{ available }} in stock
      {%- if sellable < available %} (up to {{ sellable }} per order){% endif %}
    </div>
    {% if case_size > 1 %}
      <div>
        <span class="tw-font-semibold">Cases Available:</span> {{ cases_available }} |
        <span class="tw-font-semibold">Cases Include:</span> {{ case_size }} {% if product.type contains 'Book' %}books{% else %}items{% endif %}
      </div>
    {% endif %}
    {% if case_saving_pct > 0 and cases_available > 0 %}
      <div class="tw-font-semibold">
        Buy a Case of {{ case_size }} for {{ case_saving_pct }}% Off
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "PDP Box Quantity",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "PDP Box Quantity"
    }
  ]
}
{% endschema %}
