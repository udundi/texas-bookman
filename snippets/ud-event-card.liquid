{%- comment -%}
  Renders a single event card. Accepts:
    - section: the parent section (for settings.*)
    - shopify_attributes: optional block.shopify_attributes string
    - image, image_alt
    - title, title_url
    - location
    - start_time, end_time: date/time values (metafield or similar); rendered as
      data-start-time/data-end-time attributes for JS sorting & past-event detection
    - date_month, date_day, date_year: optional badge override (defaults derive from start_time)
    - description: rich text / HTML string
    - cta_label, cta_url
{%- endcomment -%}
<article
  class="ud-event-card tw-relative tw-flex tw-flex-col tw-items-stretch tw-overflow-hidden tw-mb-5 last:tw-mb-0 md:tw-flex-row"
  style="border: 1px solid {{ section.settings.card_border_color }}; border-radius: {{ section.settings.card_border_radius }}px; background-color: {{ section.settings.card_bg }};"
  {%- if start_time != blank %}
    data-start-time="{{ start_time | date: '%Y-%m-%dT%H:%M:%S' }}"
  {% endif -%}
  {%- if end_time != blank %}
    data-end-time="{{ end_time | date: '%Y-%m-%dT%H:%M:%S' }}"
  {% endif -%}
  {{ shopify_attributes }}
>
  {%- comment -%} Past event badge, revealed by JS when end_time is before now {%- endcomment -%}
  <span class="ud-event-past-badge tw-hidden tw-absolute tw-top-2 tw-right-2 tw-z-10 tw-rounded tw-bg-offblack tw-text-white tw-text-[10px] tw-font-bold tw-uppercase tw-tracking-wide tw-px-2 tw-py-1">
    Past Event
  </span>
  {%- comment -%} Thumbnail {%- endcomment -%}
  {%- if image != blank -%}
    {%- assign thumb_alt = image_alt | default: title | default: '' | escape -%}
    <img
      src="{{ image | image_url: width: 380 }}"
      alt="{{ thumb_alt }}"
      class="tw-shrink-0 tw-self-start tw-rounded-[4px] tw-aspect-video tw-object-cover tw-object-center tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-max-w-[380px] tw-w-full md:tw-mx-0 md:tw-ml-5 md:tw-my-5 md:tw-min-h-0"
      loading="lazy"
      width="380"
      height="148"
    >
  {%- else -%}
    <div
      class="tw-shrink-0 tw-self-start tw-rounded-[4px] tw-aspect-video tw-object-cover tw-object-center tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-max-w-[380px] tw-w-full md:tw-mx-0 md:tw-ml-5 md:tw-my-5 md:tw-min-h-0"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <div class="tw-flex tw-flex-1 tw-flex-col tw-gap-2 tw-min-w-0 tw-p-5 md:tw-pl-6">
    <div class="tw-flex tw-items-start tw-justify-between tw-gap-4 tw-flex-wrap">
      <div class="tw-flex-1 tw-min-w-0">
        {%- if title != blank -%}
          {%- if title_url != blank -%}
            <a
              href="{{ title_url }}"
              class="tw-block tw-font-bold tw-leading-tight tw-mb-1 tw-no-underline hover:tw-underline tw-font-montserrat"
              style="color: {{ section.settings.event_title_color }}; font-size: {{ section.settings.event_title_size }}px;"
            >
              {{ title }}
            </a>
          {%- else -%}
            <span
              class="tw-block tw-font-bold tw-leading-tight tw-mb-1 tw-font-montserrat"
              style="color: {{ section.settings.event_title_color }}; font-size: {{ section.settings.event_title_size }}px;"
            >
              {{ title }}
            </span>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Reusable meta icon (time icon reused for all until swapped) {%- endcomment -%}

        {%- assign has_date_range = false -%}
        {%- if start_time != blank and end_time != blank -%}
          {%- assign has_date_range = true -%}
          {%- assign start_month = start_time | date: '%B' -%}
          {%- assign start_day = start_time | date: '%-d' -%}
          {%- assign start_year = start_time | date: '%Y' -%}
          {%- assign end_month = end_time | date: '%B' -%}
          {%- assign end_day = end_time | date: '%-d' -%}
          {%- assign end_year = end_time | date: '%Y' -%}
        {%- endif -%}
        {%- assign has_time = false -%}
        {%- if start_time != blank -%}{%- assign has_time = true -%}{%- endif -%}
        {%- assign has_location = false -%}
        {%- if location != blank -%}{%- assign has_location = true -%}{%- endif -%}

        {%- if has_date_range or has_time or has_location -%}
          <div
            class="tw-flex tw-items-center tw-gap-4 tw-flex-wrap tw-font-montserrat"
            style="color: {{ section.settings.meta_color }}; font-size: {{ section.settings.meta_size }}px;"
          >
            {%- if has_date_range -%}
              <span class="tw-flex tw-items-center tw-flex-row tw-gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 15 15"
                  fill="none"
                >
                  <g clip-path="url(#clip0_490_3446)">
                  <path d="M12.7229 14.0391H1.31616C0.587886 14.0391 0 13.4512 0 12.7229V2.1936C0 1.46533 0.587886 0.877441 1.31616 0.877441H12.7229C13.4512 0.877441 14.0391 1.46533 14.0391 2.1936V12.7229C14.0391 13.4512 13.4512 14.0391 12.7229 14.0391ZM1.31616 1.75488C1.07048 1.75488 0.877441 1.94792 0.877441 2.1936V12.7229C0.877441 12.9686 1.07048 13.1616 1.31616 13.1616H12.7229C12.9686 13.1616 13.1616 12.9686 13.1616 12.7229V2.1936C13.1616 1.94792 12.9686 1.75488 12.7229 1.75488H1.31616Z" fill="#5D616E"/>
                  <path d="M3.94849 3.50977C3.7028 3.50977 3.50977 3.31673 3.50977 3.07104V0.438721C3.50977 0.193037 3.7028 0 3.94849 0C4.19417 0 4.38721 0.193037 4.38721 0.438721V3.07104C4.38721 3.31673 4.19417 3.50977 3.94849 3.50977ZM10.0906 3.50977C9.84489 3.50977 9.65186 3.31673 9.65186 3.07104V0.438721C9.65186 0.193037 9.84489 0 10.0906 0C10.3363 0 10.5293 0.193037 10.5293 0.438721V3.07104C10.5293 3.31673 10.3363 3.50977 10.0906 3.50977ZM13.6003 5.26465H0.438721C0.193037 5.26465 0 5.07161 0 4.82593C0 4.58024 0.193037 4.38721 0.438721 4.38721H13.6003C13.846 4.38721 14.0391 4.58024 14.0391 4.82593C14.0391 5.07161 13.846 5.26465 13.6003 5.26465Z" fill="#5D616E"/>
                  </g>
                  <defs>
                  <clipPath id="clip0_490_3446">
                  <rect width="14.0391" height="14.0391" fill="white"/>
                  </clipPath>
                  </defs>
                </svg>
                <span>
                  {{ start_month }}
                  {%- if start_month == end_month and start_day == end_day -%}
                    {{ start_day }},
                  {%- else -%}
                    {{ start_day }}
                  {%- endif -%}
                  {%- if start_year != end_year -%}, {{ start_year }}{%- endif -%}
                  {%- if start_month != end_month -%}
                    - {{ end_month }}
                    {{ end_day }},
                  {%- elsif start_day != end_day -%}
                    - {{ end_day }},
                  {%- endif -%}
                  {{ end_year | prepend: ' ' }}
                </span>
              </span>
            {%- endif -%}
            {%- if has_time -%}
              <span class="tw-flex tw-items-center tw-gap-2 tw-flex-row">
                <svg
                  class="tw-shrink-0 tw-size-3.5 tw-fill-none"
                  style="stroke: {{ section.settings.meta_color }}; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>
                  {{- start_time | date: '%l:%M %p' | strip -}}
                  {%- if end_time != blank %} - {{ end_time | date: '%l:%M %p' | strip }}{% endif -%}
                </span>
              </span>
            {%- endif -%}
            {%- if has_location -%}
              <span class="tw-flex tw-flex-row tw-items-center tw-gap-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                >
                  <path d="M2.89283 1.85512C3.9847 0.849172 5.45622 0.288262 6.98707 0.294485C8.51792 0.300707 9.98419 0.873558 11.0667 1.88835C12.1493 2.90314 12.7604 4.27772 12.7672 5.7129C12.7739 7.14807 12.1758 8.52766 11.1028 9.55137L10.3108 10.2851C9.72772 10.8218 8.97083 11.512 8.04016 12.3557C7.76036 12.6092 7.38645 12.7508 6.99736 12.7507C6.60827 12.7506 6.23446 12.6088 5.95483 12.3551L3.62749 10.2326C3.33505 9.96346 3.09016 9.73637 2.89283 9.55137C1.80464 8.53057 1.19336 7.14644 1.19336 5.70325C1.19336 4.26006 1.80464 2.87593 2.89283 1.85512ZM10.3948 2.51887C9.94979 2.09592 9.4199 1.75968 8.83567 1.52952C8.25144 1.29936 7.62442 1.17983 6.99071 1.1778C6.35699 1.17577 5.72911 1.29129 5.14322 1.51771C4.55733 1.74413 4.02501 2.07698 3.5769 2.49707C3.1288 2.91717 2.77377 3.41623 2.53226 3.9655C2.29074 4.51477 2.16752 5.10341 2.16968 5.69751C2.17184 6.29162 2.29934 6.87945 2.54485 7.42717C2.79035 7.97488 3.14901 8.47165 3.60016 8.88887L4.59149 9.80575C5.2758 10.4326 5.96202 11.0576 6.65016 11.6807C6.74341 11.7653 6.86808 11.8126 6.99783 11.8126C7.12758 11.8126 7.25224 11.7653 7.34549 11.6807L9.60816 9.61825C9.92149 9.33075 10.1837 9.08762 10.3948 8.88887C11.2958 8.04415 11.802 6.89847 11.802 5.70387C11.802 4.50928 11.2958 3.3636 10.3948 2.51887ZM6.99816 3.68762C7.30462 3.68771 7.60807 3.74438 7.89116 3.8544C8.17426 3.96442 8.43148 4.12565 8.64812 4.32886C8.86476 4.53208 9.03658 4.77331 9.15378 5.03877C9.27097 5.30424 9.33125 5.58875 9.33116 5.87606C9.33107 6.16337 9.27062 6.44785 9.15326 6.71325C9.03591 6.97866 8.86394 7.2198 8.64717 7.4229C8.43041 7.626 8.1731 7.78708 7.88993 7.89695C7.60677 8.00682 7.30329 8.06333 6.99683 8.06325C6.3779 8.06308 5.78439 7.83242 5.34687 7.42201C4.90935 7.0116 4.66365 6.45506 4.66383 5.87481C4.664 5.29457 4.91004 4.73816 5.34781 4.32798C5.78559 3.9178 6.37923 3.68746 6.99816 3.68762ZM6.99749 4.62512C6.64387 4.62512 6.30473 4.75682 6.05468 4.99124C5.80464 5.22566 5.66416 5.5436 5.66416 5.87512C5.66416 6.20665 5.80464 6.52459 6.05468 6.75901C6.30473 6.99343 6.64387 7.12512 6.99749 7.12512C7.35112 7.12512 7.69025 6.99343 7.9403 6.75901C8.19035 6.52459 8.33083 6.20665 8.33083 5.87512C8.33083 5.5436 8.19035 5.22566 7.9403 4.99124C7.69025 4.75682 7.35112 4.62512 6.99749 4.62512Z" fill="#5D616E"/>
                </svg>
                <span>{{ location }}</span>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Date badge (falls back to start_time when not explicitly set) {%- endcomment -%}
      {%- assign badge_month = date_month -%}
      {%- assign badge_day = date_day -%}
      {%- assign badge_year = date_year -%}
      {%- if badge_month == blank and badge_day == blank and start_time != blank -%}
        {%- assign badge_month = start_time | date: '%b' | upcase -%}
        {%- assign badge_day = start_time | date: '%-d' -%}
        {%- assign badge_year = start_time | date: '%Y' -%}
      {%- endif -%}
      {% comment %}
        {%- if badge_month != blank or badge_day != blank -%}
          <div
            class="tw-flex tw-shrink-0 tw-flex-col tw-items-center tw-justify-center tw-text-center tw-rounded tw-py-1.5 tw-px-3 tw-min-w-16 max-md:tw-order-first"
            style="background-color: {{ section.settings.badge_bg }};"
            aria-label="{{ badge_month }} {{ badge_day }} {{ badge_year }}"
          >
            {%- if badge_month != blank -%}
              <span
                class="tw-text-[11px] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-leading-[1.2]"
                style="color: {{ section.settings.badge_text_color }};"
              >
                {{ badge_month }}
              </span>
            {%- endif -%}
            {%- if badge_day != blank -%}
              <span
                class="tw-text-28 tw-font-bold tw-leading-[1.1]"
                style="color: {{ section.settings.badge_text_color }};"
              >
                {{ badge_day }}
              </span>
            {%- endif -%}
            {%- if badge_year != blank -%}
              <span
                class="tw-text-[11px] tw-font-bold tw-leading-[1.2]"
                style="color: {{ section.settings.badge_text_color }};"
              >
                {{ badge_year }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endcomment %}
    </div>

    {%- if description != blank -%}
      <p
        class="tw-m-0 tw-leading-relaxed tw-font-montserrat"
        style="color: {{ section.settings.description_color }}; font-size: {{ section.settings.description_size }}px;"
      >
        {{ description }}
      </p>
    {%- endif -%}

    {%- if cta_label != blank -%}
      <a
        href="{{ cta_url | default: '#' }}"
        class="tw-inline-block tw-self-start tw-font-semibold tw-uppercase tw-tracking-wider tw-no-underline tw-mt-1 tw-py-1 tw-px-4 tw-rounded-[4px] tw-transition-opacity hover:tw-opacity-85 tw-font-montserrat"
        style="background-color: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_text_color }}; font-size: {{ section.settings.cta_font_size }}px; border-radius: {{ section.settings.cta_border_radius }}px;"
      >
        {{ cta_label }}
      </a>
    {%- endif -%}
  </div>
</article>
