          "default": "Austin Distribution Center"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Join our supply chain experts for an in-depth look at optimizing inventory for independent bookstores.</p>"
        },
        {
          "type": "header",
          "content": "Date Badge"
        },
        {
          "type": "text",
