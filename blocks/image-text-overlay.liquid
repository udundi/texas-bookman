{% assign object_fit_class = 'tw-object-cover' %}
{% if block.settings.object_fit == 'contain' %}
  {% assign object_fit_class = 'tw-object-contain' %}
{% endif %}

{% case block.settings.text_position %}
  {% when 'top-left' %}
    {% assign v_align_class = 'tw-items-start' %}
    {% assign h_align_class = 'tw-justify-start tw-text-left' %}
  {% when 'top-center' %}
    {% assign v_align_class = 'tw-items-start' %}
    {% assign h_align_class = 'tw-justify-center tw-text-center' %}
  {% when 'top-right' %}
    {% assign v_align_class = 'tw-items-start' %}
    {% assign h_align_class = 'tw-justify-end tw-text-right' %}
  {% when 'middle-left' %}
    {% assign v_align_class = 'tw-items-center' %}
    {% assign h_align_class = 'tw-justify-start tw-text-left' %}
  {% when 'middle-center' %}
    {% assign v_align_class = 'tw-items-center' %}
    {% assign h_align_class = 'tw-justify-center tw-text-center' %}
  {% when 'middle-right' %}
    {% assign v_align_class = 'tw-items-center' %}
    {% assign h_align_class = 'tw-justify-end tw-text-right' %}
  {% when 'bottom-center' %}
    {% assign v_align_class = 'tw-items-end' %}
    {% assign h_align_class = 'tw-justify-center tw-text-center' %}
  {% when 'bottom-right' %}
    {% assign v_align_class = 'tw-items-end' %}
    {% assign h_align_class = 'tw-justify-end tw-text-right' %}
  {% else %}
    {% assign v_align_class = 'tw-items-end' %}
    {% assign h_align_class = 'tw-justify-start tw-text-left' %}
{% endcase %}

<style>
  .block-{{ block.id }} {
    border-width: {{ block.settings.border }}px;
    border-style: solid;
    border-color: {{ block.settings.border_color }};
    max-width: {{ block.settings.max_width }}px;
    display: block;
    width: 100%;
  }
  @media screen and (max-width: 749px) {
    .block-{{ block.id }} {
      max-width: {{ block.settings.mobile_max_width }}px;
    }
  }
  .block-{{ block.id }}-text {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.mobile_text_size }}px;
  }
  @media screen and (min-width: 750px) {
    .block-{{ block.id }}-text {
      font-size: {{ block.settings.text_size }}px;
    }
  }
</style>

<div
  class="
    block-{{ block.id }}
    tw-relative tw-mx-auto tw-overflow-hidden

    {% if block.settings.aspect_ratio == 'none' %}
    {% elsif block.settings.aspect_ratio == 'square' %}
      md:tw-aspect-square
    {% elsif block.settings.aspect_ratio == 'video' %}
      md:tw-aspect-video
    {% elsif block.settings.aspect_ratio == '4/3' %}
      md:tw-aspect-4/3
    {% elsif block.settings.aspect_ratio == '5/4' %}
      md:tw-aspect-5/4
    {% elsif block.settings.aspect_ratio == '6/5' %}
      md:tw-aspect-6/5
    {% elsif block.settings.aspect_ratio == '7/6' %}
      md:tw-aspect-7/6
    {% elsif block.settings.aspect_ratio == '10/9' %}
      md:tw-aspect-10/9
    {% elsif block.settings.aspect_ratio == '9/10' %}
      md:tw-aspect-9/10
    {% elsif block.settings.aspect_ratio == '6/7' %}
      md:tw-aspect-6/7
    {% elsif block.settings.aspect_ratio == '5/6' %}
      md:tw-aspect-5/6
    {% elsif block.settings.aspect_ratio == '4/5' %}
      md:tw-aspect-4/5
    {% elsif block.settings.aspect_ratio == '3/2' %}
      md:tw-aspect-3/2
    {% elsif block.settings.aspect_ratio == '2/3' %}
      md:tw-aspect-2/3
    {% elsif block.settings.aspect_ratio == '3/4' %}
      md:tw-aspect-3/4
    {% elsif block.settings.aspect_ratio == '3/8' %}
      md:tw-aspect-3/8
    {% elsif block.settings.aspect_ratio == '9/16' %}
      md:tw-aspect-9/16
    {% elsif block.settings.aspect_ratio == '8/3' %}
      md:tw-aspect-8/3
    {% endif %}

    {% if block.settings.mobile_aspect_ratio == 'none' %}
    {% elsif block.settings.mobile_aspect_ratio == 'square' %}
      tw-aspect-square
    {% elsif block.settings.mobile_aspect_ratio == 'video' %}
      tw-aspect-video
    {% elsif block.settings.mobile_aspect_ratio == '4/3' %}
      tw-aspect-4/3
    {% elsif block.settings.mobile_aspect_ratio == '5/4' %}
      tw-aspect-5/4
    {% elsif block.settings.mobile_aspect_ratio == '6/5' %}
      tw-aspect-6/5
    {% elsif block.settings.mobile_aspect_ratio == '7/6' %}
      tw-aspect-7/6
    {% elsif block.settings.mobile_aspect_ratio == '10/9' %}
      tw-aspect-10/9
    {% elsif block.settings.mobile_aspect_ratio == '9/10' %}
      tw-aspect-9/10
    {% elsif block.settings.mobile_aspect_ratio == '6/7' %}
      tw-aspect-6/7
    {% elsif block.settings.mobile_aspect_ratio == '5/6' %}
      tw-aspect-5/6
    {% elsif block.settings.mobile_aspect_ratio == '4/5' %}
      tw-aspect-4/5
    {% elsif block.settings.mobile_aspect_ratio == '3/2' %}
      tw-aspect-3/2
    {% elsif block.settings.mobile_aspect_ratio == '2/3' %}
      tw-aspect-2/3
    {% elsif block.settings.mobile_aspect_ratio == '3/4' %}
      tw-aspect-3/4
    {% elsif block.settings.mobile_aspect_ratio == '3/8' %}
      tw-aspect-3/8
    {% elsif block.settings.mobile_aspect_ratio == '9/16' %}
      tw-aspect-9/16
    {% elsif block.settings.mobile_aspect_ratio == '8/3' %}
      tw-aspect-8/3
    {% endif %}

    {% if block.settings.rounded == 'full' %}
      tw-rounded-full
    {% elsif block.settings.rounded == 'sm' %}
      tw-rounded-[4px]
    {% elsif block.settings.rounded == 'md' %}
      tw-rounded-xl
    {% elsif block.settings.rounded == 'lg' %}
      tw-rounded-3xl
    {% else %}
      tw-rounded-none
    {% endif %}
  "
>
  {% if block.settings.image != blank %}
    <img
      srcset="
        {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
        {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
        {%- if block.settings.image.width >= 533 -%}{{ block.settings.image | image_url: width: 533 }} 533w,{%- endif -%}
        {%- if block.settings.image.width >= 720 -%}{{ block.settings.image | image_url: width: 720 }} 720w,{%- endif -%}
        {%- if block.settings.image.width >= 940 -%}{{ block.settings.image | image_url: width: 940 }} 940w,{%- endif -%}
        {%- if block.settings.image.width >= 1066 -%}{{ block.settings.image | image_url: width: 1066 }} 1066w,{%- endif -%}
        {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
      "
      sizes="(max-width: 749px) {{ block.settings.mobile_max_width }}px, {{ block.settings.max_width }}px"
      src="{{ block.settings.image | image_url: width: 2000 }}"
      alt="{% if block.settings.alt_text %}{{ block.settings.alt_text | escape }}{% else %}{{ block.settings.image.alt | escape }}{% endif %}"
      width="{{ block.settings.image.width }}"
      height="{{ block.settings.image.height }}"
      class="tw-h-full tw-w-full {{ object_fit_class }}"
      {% unless block.settings.lazy_load == false %}
        loading="lazy"
      {% endunless %}
      decoding="async"
    >
  {% else %}
    {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-contain' }}
  {% endif %}

  {% if block.settings.overlay_text != blank %}
    <div
      class="block-{{ block.id }}-text tw-absolute tw-inset-0 tw-flex tw-font-montserrat tw-p-6 {{ v_align_class }} {{ h_align_class }}"
    >
      <div class="tw-drop-shadow-md">{{ block.settings.overlay_text }}</div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image with Text Overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
