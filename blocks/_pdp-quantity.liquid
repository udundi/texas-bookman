<!-- Quantity Selector -->
<!-- Standard quantity selector -->
<div
  class="
    {% if block.settings.visibility contains 'mobile' %}
      tw-flex
      md:tw-hidden
    {% elsif block.settings.visibility contains "desktop" %}
      tw-hidden
      md:tw-flex
    {% else %}
      tw-flex
    {% endif %} tw-flex-col tw-gap-1
  "
>
  {% if customer == null %}
    <a
      href="{{ routes.account_login_url }}"
      class="tw-uppercase tw-bg-brand-primary tw-text-brand-eggshell tw-py-2.5 tw-px-4 tw-rounded-[4px] tw-text-center tw-font-semibold tw-text-14 tw-transition-all hover:tw-brightness-95 tw-block"
    >
      Sign in to shop
    </a>
  {% else %}
    {% comment %} Case-pack products: see blocks/_pdp-box-quantity.liquid {% endcomment %}
    {% assign single_variant = product.selected_or_first_available_variant %}
    {% assign case_variant = nil %}
    {% for variant in product.variants %}
      {% if variant.option1 == 'Case' %}
        {% assign case_variant = variant %}
      {% elsif single_variant.option1 == 'Case' %}
        {% assign single_variant = variant %}
      {% endif %}
    {% endfor %}
    {% assign case_size = product.metafields.custom.case_size.value
      | default: case_variant.metafields.custom.case_quantity.value
      | default: 1
    %}
    {% assign cases_available = 0 %}
    {% if case_variant and case_size > 1 %}
      {% assign cases_available = single_variant.inventory_quantity | at_least: 0 | divided_by: case_size %}
    {% endif %}
    {% if cases_available > 0 %}
      <fieldset class="tw-flex tw-flex-col tw-gap-1 tw-pb-2">
        <legend class="tw-font-montserrat tw-text-16 tw-font-semibold tw-text-offblack tw-pb-1">Pack Size</legend>
        <div class="tw-flex tw-flex-wrap tw-gap-2">
          <button
            type="button"
            @click="selectPack(singleVariantId)"
            :aria-pressed="!buyingCase"
            :class="!buyingCase ? 'tw-border-2 tw-border-black' : 'tw-border tw-border-brand-grey'"
            class="tw-rounded-[4px] tw-bg-brand-eggshell tw-py-2 tw-px-3 tw-text-14 tw-text-offblack"
          >
            Single &middot; {{ single_variant.price | money }}
          </button>
          <button
            type="button"
            @click="selectPack(caseVariantId)"
            :aria-pressed="buyingCase"
            :class="buyingCase ? 'tw-border-2 tw-border-black' : 'tw-border tw-border-brand-grey'"
            class="tw-rounded-[4px] tw-bg-brand-eggshell tw-py-2 tw-px-3 tw-text-14 tw-text-offblack"
          >
            Case of {{ case_size }} &middot; {{ case_variant.price | money }}
          </button>
        </div>
      </fieldset>
    {% endif %}
    <label class="tw-font-montserrat tw-text-16 tw-font-semibold tw-text-offblack"
      ><span v-if="buyingCase">CASES</span><span v-else>QTY</span> <span class="tw-font-normal">(Minimum Required {{  }})</span></label
    >
    <div class="tw-flex tw-w-full tw-pb-2">
      <div class="tw-relative tw-flex tw-max-w-28 tw-items-center tw-rounded-[4px] tw-bg-brand-eggshell tw-border tw-border-brand-grey">
        <button
          type="button"
          id="decrement-button"
          @click="quantity > 1 ? quantity-- : quantity"
          :disabled="quantity <= 1"
          :class="quantity <= 1 ? 'tw-cursor-not-allowed' : ''"
          class="tw-bg-brand-bg-dark tw-rounded-[4px] tw-pl-4 tw-pr-2"
        >
          {% render 'icon-minus' %}
        </button>
        <label class="tw-hidden" for="quantity-input">Quantity</label>
        <input
          type="integer"
          id="quantity-input"
          aria-label="quantity"
          name="quantity"
          min="1"
          max="100"
          @keydown="if (isNaN(parseInt(event.key)) && event.key != 'Backspace') { event.preventDefault(); }"
          @input="quantity < 1 ? quantity = 1 : quantity = quantity"
          max="{{ product.selected_or_first_available_variant.inventory_quantity }}"
          v-model="quantity"
          class="tw-text-sm tw-block tw-h-10 tw-w-full tw-py-1 tw-text-center tw-text-offblack"
          required
        >
        <button
          type="button"
          id="increment-button"
          aria-label="increase quantity by 1"
          @click="buyingCase && quantity >= casesAvailable ? quantity : quantity++"
          :disabled="buyingCase && quantity >= casesAvailable"
          class="tw-bg-brand-bg-dark tw-rounded-[4px] tw-pl-2 tw-pr-4"
        >
          {% render 'icon-plus' %}
        </button>
      </div>
      <!-- Add to Cart Button -->
      <button
        type="submit"
        @click="addToCart()"
        class="tw-ml-2 tw-w-full tw-rounded-[4px] tw-bg-brand-primary tw-py-2 tw-text-sm tw-font-semibold tw-text-brand-eggshell tw-flex tw-justify-center"
      >
        <span v-if="!addingToCart"> Add to Cart </span>
        <div v-if="addingToCart" class="tw-animate-spin tw-size-6 tw-fill-white">
          {% render 'icon-spin' %}
        </div>
      </button>
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "PDP Quantity",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "PDP Quantity"
    }
  ]
}
{% endschema %}
