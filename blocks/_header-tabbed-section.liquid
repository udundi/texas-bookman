<!-- Tab Group -->
<div class="tw-group tw-flex tw-h-full tw-bg-brand-eggshell tw-items-center tw-justify-center">
  <button
    class="tw-relative tw-hidden tw-border-y-2 tw-border-solid tw-border-white/0 group-hover:tw-border-b-brand-primary group-hover:tw-text-brand-primary tw-p-2 tw-font-brand-body !tw-text-12 tw-font-semibold md:tw-block lg:tw-p-2 lg:!tw-text-14 tw-text-navy tw-leading-4"
    @click="selectedTab = '{{ block.id }}';"
    @mouseenter="selectedTab = '{{ block.id }}'; selectedSubTab = ''"
  >
    {{ block.settings.header }}
  </button>
  <!-- Mobile Button -->
  <button
    class="tw-relative tw-px-3 tw-flex tw-justify-between tw-font-brand-body !tw-text-14 tw-font-semibold tw-text-navy tw-w-[70vw] tw-text-start tw-border-t tw-border-navy tw-border-solid tw-py-4 tw-border-0"
    @click="selectedTab = '{{ block.id }}';"
    :class="selectedTab ? 'tw-hidden' : 'md:tw-hidden'"
  >
    {{ block.settings.header }}
    <span class="tw-my-auto">
      {% comment %} {% render 'ud-arrow-icon' %} {% endcomment %}
    </span>
  </button>
  <!-- Dropdown -->
  <div
    v-show="selectedTab === '{{ block.id }}'"
    class="md:tw-absolute tw-flex tw-w-full tw-flex-col md:tw-flex-row md:tw-left-1/2 tw-top-full tw-max-w-screen-2xl md:-tw-translate-x-1/2 md:tw-z-50 tw-min-h-0 tw-text-black"
  >
    <div
      class="md:tw-flex-row tw-flex-col tw-flex tw-h-full tw-overflow-y-auto tw-w-full tw-min-h-0"
    >
      <div class="tw-flex tw-flex-row tw-h-full tw-min-h-0 tw-border-brand-grey tw-border md:tw-shadow-lg tw-bg-brand-eggshell tw-mx-auto">
        {% for sub_block in block.blocks %}
          {% render sub_block %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% comment %}
  link is just for buttons and using regular defaults
  Collection is the main huge section
  Tabbed Tab is the 1 Row CTA
{% endcomment %}
{% schema %}
{
  "name": "Tabbed Header Container",
  "blocks": [
    {
      "type": "_header-menu-links"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Section Header"
    },
    {
      "type": "checkbox",
      "label": "Drop down Full Width?",
      "id": "full_width"
    },

    {
      "type": "checkbox",
      "label": "Alt Section Header on Dropdown?",
      "default": true,
      "id": "display_header"
    },
    {
      "type": "url",
      "id": "header_url",
      "visible_if": "{{ block.settings.display_header != true }}",
      "label": "Section Header URL"
    },
    {
      "type": "checkbox",
      "label": "Alt Image Style?",
      "default": true,
      "id": "alt_image_style"
    },
    {
      "type": "header",
      "content": "Section 1"
    },
    {
      "type": "text",
      "id": "sec_1_title",
      "label": "Category 1 Title"
    },
    {
      "type": "select",
      "id": "s1t",
      "label": "Section 1 Type",
      "options": [
        {
          "value": "single_link",
          "label": "Single Link"
        },
        {
          "value": "l_o_l",
          "label": "List of Links (3)"
        },
        {
          "value": "l_o_l_4",
          "label": "List of Links (4)"
        },
        {
          "value": "s_color",
          "label": "Shop By Color"
        },
        {
          "value": "indi_tiles",
          "label": "Individual Tiles"
        },
        {
          "value": "1 row CTA",
          "label": "1rowcta"
        }
      ]
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 's_color' }}",
      "content": "Link 1"
    },
    {
      "type": "checkbox",
      "visible_if": "{{ block.settings.s1t != 's_color' }}",
      "label": "Use Product instead of Link?",
      "id": "products_enabled_1"
    },
    {
      "type": "image_picker",
      "id": "link_1_image",
      "visible_if": "{{ block.settings.s1t != 's_color' and block.settings.products_enabled_1 != true }}",
      "label": "Link Image"
    },
    {
      "type": "text",
      "id": "link_1_title",
      "visible_if": "{{ block.settings.s1t != 's_color' and block.settings.products_enabled_1 != true }}",
      "label": "Link Title"
    },
    {
      "type": "text",
      "id": "link_1_subtitle",
      "visible_if": "{{ block.settings.s1t != 's_color' and block.settings.products_enabled_1 != true }}",
      "label": "Link Subtitle"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "visible_if": "{{ block.settings.s1t != 's_color' and block.settings.products_enabled_1 != true }}",
      "label": "Link URL"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'l_o_l' and block.settings.s1t != 'l_o_l_4' }}",
      "content": "Section 2"
    },
    {
      "type": "text",
      "id": "sec_2_title",
      "visible_if": "{{ block.settings.s1t != 'l_o_l' and block.settings.s1t != 'l_o_l_4' }}",
      "label": "Section 2 Title"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'l_o_l' and block.settings.s1t != 'l_o_l_4' }}",
      "content": "Link 1"
    },

    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'single_link' and block.settings.s1t != 's_color' }}",
      "content": "Link 2"
    },
    {
      "type": "checkbox",
      "visible_if": "{{ block.settings.s1t != 's_color' }}",
      "label": "Use Product instead of Link?",
      "id": "products_enabled_2"
    },
    {
      "type": "image_picker",
      "id": "link_2_image",
      "visible_if": "{{ block.settings.products_enabled_2 != true }}",
      "label": "Link Image"
    },
    {
      "type": "text",
      "id": "link_2_title",
      "visible_if": "{{ block.settings.products_enabled_2 != true }}",
      "label": "Link Title"
    },
    {
      "type": "text",
      "id": "link_2_subtitle",
      "visible_if": "{{ block.settings.products_enabled_2 != true }}",
      "label": "Link Subtitle"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "visible_if": "{{ block.settings.products_enabled_2 != true }}",
      "label": "Link URL"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'l_o_l' and block.settings.s1t != 'l_o_l_4' }}",
      "content": "Link 2"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'single_link' and block.settings.s1t != 's_color' }}",
      "content": "Link 3"
    },
    {
      "type": "checkbox",
      "visible_if": "{{ block.settings.s1t != 's_color' }}",
      "label": "Use Product instead of Link?",
      "id": "products_enabled_3"
    },
    {
      "type": "image_picker",
      "id": "link_3_image",
      "visible_if": "{{ block.settings.products_enabled_3 != true }}",
      "label": "Link Image"
    },
    {
      "type": "text",
      "id": "link_3_title",
      "visible_if": "{{ block.settings.products_enabled_3 != true }}",
      "label": "Link Title"
    },
    {
      "type": "text",
      "id": "link_3_subtitle",
      "visible_if": "{{ block.settings.products_enabled_3 != true }}",
      "label": "Link Subtitle"
    },
    {
      "type": "url",
      "id": "link_3_url",
      "visible_if": "{{ block.settings.products_enabled_3 != true }}",
      "label": "Link URL"
    },

    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t == 'l_o_l' }}",
      "content": "Section 2"
    },
    {
      "type": "text",
      "id": "sec_2_title_alt",
      "visible_if": "{{ block.settings.s1t == 'l_o_l' }}",
      "label": "Section 2 Title"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t == 'l_o_l' }}",
      "content": "Link 1"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t != 'l_o_l' and block.settings.s1t != 'l_o_l_4' }}",
      "content": "Link 3"
    },
    {
      "type": "header",
      "visible_if": "{{ block.settings.s1t == 'l_o_l_4' }}",
      "content": "Link 4"
    },
    {
      "type": "checkbox",
      "visible_if": "{{ block.settings.s1t != 's_color' }}",
      "label": "Use Product instead of Link?",
      "id": "products_enabled_4"
    },
    {
      "type": "image_picker",
      "visible_if": "{{ block.settings.products_enabled_4 != true }}",
      "id": "link_4_image",
      "label": "Link Image"
    },
    {
      "type": "text",
      "visible_if": "{{ block.settings.products_enabled_4 != true }}",
      "id": "link_4_title",
      "label": "Link Title"
    },
    {
      "type": "text",
      "visible_if": "{{ block.settings.products_enabled_4 != true }}",
      "id": "link_4_subtitle",
      "label": "Link Subtitle"
    },
    {
      "type": "url",
      "visible_if": "{{ block.settings.products_enabled_4 != true }}",
      "id": "link_4_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Optional Buttons"
    },
    {
      "type": "checkbox",
      "label": "Add Optional Button for Section 1?",
      "id": "sec_1_button_enabled"
    },
    {
      "type": "text",
      "id": "sec_1_button_text",
      "label": "Button Text",
      "visible_if": "{{ block.settings.sec_1_button_enabled == true }}"
    },
    {
      "type": "url",
      "id": "sec_1_button_link",
      "visible_if": "{{ block.settings.sec_1_button_enabled == true }}",
      "label": "Button Url"
    },

    {
      "type": "checkbox",
      "label": "Add Optional Button for Section 2?",
      "visible_if": "{{ block.settings.s1t != 'l_o_l_4' }}",
      "id": "sec_2_button_enabled"
    },
    {
      "type": "text",
      "visible_if": "{{ block.settings.sec_2_button_enabled == true and block.settings.s1t != 'l_o_l_4' }}",
      "id": "sec_2_button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "visible_if": "{{ block.settings.sec_2_button_enabled == true and block.settings.s1t != 'l_o_l_4' }}",
      "id": "sec_2_button_link",
      "label": "Button Url"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    }
  ],
  "presets": [
    {
      "name": "Tabbed Header Container"
    }
  ]
}
{% endschema %}
