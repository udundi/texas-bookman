{% capture blocks %}  
  {% content_for 'blocks' %}
{% endcapture %}
<div
  class="block-{{ block.id }} tw-py-1 {% if block.settings.nested %}tw-pl-6{% endif %}"
  {% if block.settings.nested %}
    :class="{ ' tw-pt-1 tw-border-l-2 tw-border-brand-grey': {% if block.settings.collapsed == true %}!openFilters.includes('{{ block.id }}'){% else %}openFilters.includes('{{ block.id }}'){% endif %} }"
  {% endif %}
>
  {% if block.settings.collapsible %}
    <button
      class="tw-flex tw-w-full tw-justify-between tw-items-middle tw-cursor-pointer"
      @click="
        () => {
          if (openFilters.includes('{{ block.id }}')) {
            openFilters.splice(openFilters.indexOf('{{ block.id }}'), 1);
          } else {
            openFilters.push('{{ block.id }}')
          }
        }
      "
    >
      <div
        class="tw-my-auto tw-font-brand-header tw-text-offblack tw-text-14 tw-leading-tight{% unless block.settings.nested %} tw-font-semibold{% endunless %}"
        {% if block.settings.nested %}
          :class="{ 'tw-font-semibold': {% if block.settings.collapsed == true %}!openFilters.includes('{{ block.id }}'){% else %}openFilters.includes('{{ block.id }}'){% endif %} }"
        {% endif %}
      >
        {{ block.settings.title | default: 'Filter Section' }}
      </div>
      <div
        class="tw-fill-offblack tw-size-3"
        v-cloak
        v-if="{% if block.settings.collapsed == true %}openFilters.includes('{{ block.id }}'){% else %}!openFilters.includes('{{ block.id }}'){% endif %}"
      >
        {% render 'icon-arrow-up' %}
      </div>
      <div v-else class="tw-fill-offblack tw-size-3">{% render 'icon-arrow-down' %}</div>
    </button>
    <div
      v-if="{% if block.settings.collapsed == true %}!openFilters.includes('{{ block.id }}'){% else %}openFilters.includes('{{ block.id }}'){% endif %}"
      class="tw-flex tw-flex-col tw-pt-2 tw-justify-start tw-gap-[1px]"
    >
      {{ blocks }}
    </div>
  {% else %}
    {% if block.settings.title != blank %}
      <div class="tw-flex tw-w-full tw-border-b tw-border-black tw-justify-between tw-items-middle ">
        <div class="tw-my-auto tw-font-montserrat tw-font-semibold tw-text-offblack tw-text-16 tw-leading-tight">
          {{ block.settings.title }}
        </div>
      </div>
    {% endif %}
    <div class="tw-flex tw-flex-col tw-pt-4 tw-justify-start tw-gap-[1px] tw-mb-0">
      {{ blocks }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection Filter Box",
  "settings": [
    {
      "type": "checkbox",
      "label": "Collapsible?",
      "id": "collapsible",
      "default": true
    },
    {
      "type": "checkbox",
      "label": "Default Collapsed?",
      "id": "collapsed",
      "default": true,
      "visible_if": "{{ block.settings.collapsible == true }}"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "title"
    },
    {
      "type": "checkbox",
      "label": "Nested (tabbed indent)?",
      "id": "nested",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "_collection-filter"
    },
    {
      "type": "_collection-gate"
    },
    {
      "type": "_collection-filter-box-v2"
    }
  ],
  "presets": [
    {
      "name": "Collection Filter Box"
    }
  ]
}
{% endschema %}
