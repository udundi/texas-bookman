{% capture blocks %}  
  {% content_for 'blocks' %}
{% endcapture %}
{%- comment -%} Hide the group when every entry in it hid itself; open it when it holds the active filter. {%- endcomment -%}
{%- comment -%} Shopify wraps every block in a div, so look for rendered entries rather than any markup (but keep empty groups in the theme editor). {%- endcomment -%}
{%- assign blocks = blocks | strip -%}
{%- unless blocks contains 'data-filter-entry' or request.design_mode -%}
  {%- assign blocks = '' -%}
{%- endunless -%}
{%- comment -%} A top-level gate for the current collection unchecks to all products. {%- endcomment -%}
{%- if blocks contains 'ud-parent-collection-url' -%}
  {%- assign blocks = blocks | replace: 'ud-parent-collection-url', routes.all_products_collection_url -%}
{%- endif -%}
{%- assign box_collapsed = block.settings.collapsed | default: false -%}
{%- if blocks contains 'data-filter-active' -%}
  {%- assign box_collapsed = false -%}
{%- endif -%}
{%- if blocks != blank -%}
<div
  class="block-{{ block.id }} {% if block.settings.nested %}tw-py-1 tw-pl-6{% else %}tw-border-b tw-border-brand-grey tw-py-3 md:tw-py-2.5{% endif %}"
>
  {% if block.settings.collapsible %}
    <details
      class="tw-group/filter tw-w-full{% if block.settings.nested %} open:tw-border-l-2 open:tw-border-brand-grey{% endif %}"
      {% unless box_collapsed %}open{% endunless %}
    >
      <summary
        class="tw-flex tw-w-full tw-justify-between tw-items-center tw-cursor-pointer tw-list-none [&::-webkit-details-marker]:tw-hidden tw-bg-transparent tw-border-0 tw-p-0 tw-text-left"
      >
        <div
          class="tw-my-auto tw-font-brand-header tw-text-offblack tw-text-16 md:tw-text-14 tw-leading-tight{% unless block.settings.nested %} tw-font-semibold{% endunless %} group-open/filter:tw-font-semibold"
        >
          {{ block.settings.title | default: 'Filter Section' }}
        </div>
        <div class="tw-fill-offblack tw-size-4 md:tw-size-3.5 tw-flex-shrink-0 tw-transition-transform tw-duration-200 group-open/filter:tw-rotate-180">
          {% render 'icon-arrow-down' %}
        </div>
      </summary>
      <div class="tw-flex tw-flex-col tw-pt-2.5 tw-justify-start tw-gap-1 md:tw-gap-[1px]">
        {{ blocks }}
      </div>
    </details>
  {% else %}
    {% if block.settings.title != blank %}
      <div class="tw-flex tw-w-full tw-border-b tw-border-black tw-justify-between tw-items-center">
        <div class="tw-my-auto tw-font-montserrat tw-font-semibold tw-text-offblack tw-text-16 tw-leading-tight">
          {{ block.settings.title }}
        </div>
      </div>
    {% endif %}
    <div class="tw-flex tw-flex-col tw-pt-4 tw-justify-start tw-gap-[1px] tw-mb-0">
      {{ blocks }}
    </div>
  {% endif %}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Filter Box",
  "settings": [
    {
      "type": "checkbox",
      "label": "Collapsible?",
      "id": "collapsible",
      "default": true
    },
    {
      "type": "checkbox",
      "label": "Default Collapsed?",
      "id": "collapsed",
      "default": true,
      "visible_if": "{{ block.settings.collapsible == true }}"
    },
    {
      "type": "text",
      "label": "Title",
      "id": "title"
    },
    {
      "type": "checkbox",
      "label": "Nested (tabbed indent)?",
      "id": "nested",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "_collection-filter"
    },
    {
      "type": "_collection-gate"
    },
    {
      "type": "_collection-filter-box-v2"
    },
    {
      "type": "_collection-storefront-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Filter Box"
    }
  ]
}
{% endschema %}
