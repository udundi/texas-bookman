{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div
  class="section-cart-{{ section.id }} tw-flex tw-flex-col tw-w-full tw-gap-8 md:tw-gap-12 tw-pt-8 tw-mx-auto tw-justify-start tw-max-w-screen-lg tw-px-4 md:tw-px-0"
>
  <div class="tw-flex tw-items-center tw-justify-between tw-gap-2">
    <div class="tw-flex tw-gap-2 tw-items-baseline">
      <h1 class="tw-text-26 tw-font-semibold tw-font-brand-header tw-m-0">{{ 'cart.title' | t }}</h1>
      <div v-if="totalItemCount > 0" class="tw-text-26 tw-font-semibold tw-font-brand-header">([[ totalItemCount ]])</div>
    </div>
    <!-- Mobile Continue Shopping -->
    <a
      href="/"
      class="tw-bg-brand-primary tw-px-4 tw-py-2 tw-text-white tw-uppercase tw-text-12 tw-font-semibold tw-tracking-wide tw-text-center tw-rounded-md md:tw-hidden"
    >
      Continue Shopping
    </a>
  </div>
  <div class="tw-flex tw-flex-col md:tw-flex-row tw-relative tw-text-14 tw-w-full tw-gap-6 md:tw-gap-12 tw-mx-auto">
    <!-- Cart Items -->
    <div class="tw-w-full tw-flex tw-flex-col tw-gap-2">
      <div class="tw-bg-brand-eggshell tw-border tw-border-brand-grey tw-rounded-md">
        <div
          v-for="(item, index) in cartItems"
          :key="item.key"
          class="tw-flex tw-gap-4 tw-w-full tw-border-brand-grey tw-p-3"
          :class="index > 0 ? 'tw-border-t' : ''"
        >
          <a
            :href="item.url"
            class="tw-h-24 md:tw-h-32 tw-w-20 md:tw-w-24 tw-flex-shrink-0 tw-object-cover tw-aspect-3/4 tw-relative tw-py-2"
          >
            <img
              v-if="item.featured_image"
              :src="item.featured_image.url"
              :alt="item.title"
              loading="lazy"
              class="tw-size-full tw-aspect-3/4 tw-object-cover"
            >
          </a>
          <div class="tw-flex tw-min-w-0 tw-w-full tw-flex-col tw-gap-1">
            <!-- Out of Stock Badge -->
            <div
              v-if="isOutOfStock(item)"
              class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-rounded tw-border tw-border-brand-sale/20 tw-bg-red-100 tw-px-2 tw-py-1"
            >
              <span class="tw-text-12 tw-font-bold tw-text-brand-sale">Out of Stock</span>
              <button
                type="button"
                class="tw-size-3 tw-flex-shrink-0 tw-fill-brand-sale"
                @click="removeItem(item)"
                aria-label="Remove out of stock item"
              >
                {% render 'icon-close' %}
              </button>
            </div>
            <!-- Title -->
            <a
              :href="item.url"
              class="tw-flex tw-min-w-0 tw-flex-row tw-gap-2 tw-text-14 tw-font-semibold"
              :class="isOutOfStock(item) ? 'tw-text-gray-400 tw-pointer-events-none' : 'tw-text-brand-primary'"
            >
              <p class="tw-m-0 tw-truncate">[[ item.title ]]</p>
            </a>
            <!-- Item Identifiers -->
            <div
              class="tw-flex tw-flex-wrap tw-gap-x-4 tw-gap-y-0.5"
              :class="isOutOfStock(item) ? 'tw-text-gray-400' : ''"
            >
              <div v-if="item.properties && item.properties._isbn">ISBN: [[ item.properties._isbn ]]</div>
              <div v-if="item.properties && item.properties._tb">TB Code: [[ item.properties._tb ]]</div>
            </div>
            <!-- Quantity Editor -->
            <div class="tw-flex tw-items-center tw-w-fit tw-justify-start tw-gap-2">
              <div class="tw-font-semibold" :class="isOutOfStock(item) ? 'tw-text-gray-400' : ''">QTY:</div>
              <input
                type="number"
                :value="item.quantity"
                min="0"
                :disabled="isOutOfStock(item)"
                class="tw-p-0.5 tw-px-2 tw-border tw-border-brand-grey tw-w-16 tw-text-center disabled:tw-bg-gray-100 disabled:tw-text-gray-400 [appearance:textfield] [&::-webkit-outer-spin-button]:tw-appearance-none [&::-webkit-inner-spin-button]:tw-appearance-none"
                @input="onQtyInput(item, $event)"
              >
              <button class="tw-size-4 tw-ml-4 tw-flex-shrink-0" @click="removeItem(item)" aria-label="Remove item">
                {% render 'icon-trash' %}
              </button>
            </div>
            <!-- Prices -->
            <div
              class="tw-flex tw-flex-wrap tw-gap-x-4 tw-gap-y-0.5"
              :class="isOutOfStock(item) ? 'tw-text-gray-400' : ''"
            >
              <div v-if="item.original_price !== item.price">
                Price:
                <span class="tw-line-through">[[ formatMoney(item.original_price) ]]</span>
                <span class="tw-text-brand-sale">[[ formatMoney(item.price) ]]</span>
              </div>
              <div v-else>Price: [[ formatMoney(item.price) ]]</div>
              <div v-if="item.original_line_price !== item.line_price">
                Total:
                <span class="tw-line-through">[[ formatMoney(item.original_line_price) ]]</span>
                <span class="tw-text-brand-sale">[[ formatMoney(item.line_price) ]]</span>
              </div>
              <div v-else>Total: [[ formatMoney(item.line_price) ]]</div>
            </div>
            <!-- Discount Note -->
            <div v-if="lineDiscountLabel(item)" class="tw-font-semibold tw-text-brand-sale">
              [[ lineDiscountLabel(item) ]]
            </div>
          </div>
        </div>
      </div>
      <a
        href="/"
        class="tw-bg-brand-primary tw-p-1.5 tw-text-white tw-uppercase tw-text-18 tw-w-full tw-max-w-72 tw-text-center tw-rounded-md tw-mt-4 max-md:tw-hidden"
      >
        Continue Shopping
      </a>
    </div>

    <!-- Order Summary -->
    <div class="tw-w-full tw-font-semibold tw-font-brand-body tw-rounded-md md:tw-max-w-96 md:tw-sticky md:tw-top-4 tw-h-full tw-justify-start">
      <div class="tw-w-full tw-font-semibold tw-font-brand-body tw-border tw-border-brand-grey tw-rounded-md tw-bg-brand-eggshell md:tw-max-w-96 tw-flex tw-flex-col tw-gap-8 md:tw-gap-24 tw-h-full tw-justify-between">
        <div class="tw-flex tw-flex-col tw-gap-4">
          <div class="tw-p-4 tw-text-16 tw-border-b tw-border-brand-grey">Your Order</div>
          <div class="tw-flex tw-px-4 tw-flex-col tw-gap-1">
            <div class="tw-flex tw-justify-between tw-w-full tw-gap-4">
              <div>Subtotal:</div>
              <div>[[ formatMoney(subtotal) ]]</div>
            </div>
            <div class="tw-flex tw-justify-between tw-w-full tw-gap-4">
              <div>Shipping:</div>
              <div>FREE</div>
            </div>
          </div>
        </div>

        <div class="tw-flex tw-flex-col tw-gap-2 tw-p-4 tw-border-t tw-border-brand-grey">
          <div class="tw-flex tw-justify-between tw-w-full tw-gap-4">
            <div>Total:</div>
            <div>[[ formatMoney(total) ]]</div>
          </div>
          <div v-if="totalSavings > 0" class="tw-flex tw-justify-between tw-w-full tw-gap-4 tw-text-brand-sale">
            <div>Total Savings:</div>
            <div>-[[ formatMoney(totalSavings) ]]</div>
          </div>
        </div>
      </div>
      <!-- Checkout button / spinner -->
      <a
        v-if="!updatingCart"
        href="{{ routes.checkout_url }}"
        class="tw-flex tw-gap-3 tw-rounded-md tw-items-center tw-justify-center tw-bg-brand-secondary tw-p-1.5 tw-text-offblack tw-uppercase tw-text-20 tw-w-full tw-text-center tw-mt-4"
      >
        <span class="tw-size-4 tw-mb-1">{% render 'icon-lock' %}</span>
        Checkout
      </a>
      <div
        v-else
        class="tw-bg-brand-secondary tw-rounded-md tw-p-1.5 tw-cursor-wait tw-flex tw-items-center tw-justify-center tw-mt-4"
      >
        <div class="tw-size-6 tw-animate-spin">
          {% render 'icon-spin' %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  Vue.createApp({
    delimiters: ['[[', ']]'],
    mixins: [global, cart],
    data() {
      return {
        cartItems: {{ cart.items | json }},
        cartData: {{ cart | json }},
        subtotal: {{ cart.items_subtotal_price }},
        total: {{ cart.total_price }},
        totalSavings: {{ cart.total_discount | default: 0 }},
        updatingCart: false,
        debounceTimers: {},
        moneyFmt: {{ shop.money_format | json }},
      };
    },
    computed: {
      totalItemCount() {
        return this.cartItems.reduce((sum, item) => sum + item.quantity, 0);
      },
    },
    methods: {
      formatMoney(cents) {
        const amount = (cents / 100).toFixed(2);
        return this.moneyFmt
          .replace(/\{\{amount\}\}/g, amount)
          .replace(/\{\{amount_no_decimals\}\}/g, String(Math.round(cents / 100)))
          .replace(/\{\{amount_with_comma_separator\}\}/g, amount.replace('.', ','));
      },
      isOutOfStock(item) {
        return !!(item.variant && item.variant.available === false);
      },
      lineDiscountLabel(item) {
        const allocation = item.line_level_discount_allocations && item.line_level_discount_allocations[0];
        if (!allocation) return null;
        const application = allocation.discount_application;
        const amountLabel = application.value_type === 'percentage'
          ? `${parseFloat(application.value)}%`
          : this.formatMoney(allocation.amount);
        return `-${amountLabel} ${application.title} Applied`;
      },
      onQtyInput(item, event) {
        const qty = parseInt(event.target.value, 10);
        if (isNaN(qty) || qty < 0) return;
        clearTimeout(this.debounceTimers[item.key]);
        this.debounceTimers[item.key] = setTimeout(() => this.updateQuantity(item, qty), 800);
      },
      updateQuantity(item, qty) {
        this.updatingCart = true;
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: item.key, quantity: qty }),
        })
          .then((r) => r.json())
          .then((updatedCart) => {
            item.quantity = qty;
            item.line_price = item.price * qty;
            this.subtotal = updatedCart.items_subtotal_price;
            this.total = updatedCart.total_price;
            this.totalSavings = updatedCart.total_discount;
            this.bus.$emit('refreshCart');
          })
          .catch(() => {})
          .finally(() => { this.updatingCart = false; });
      },
      removeItem(item) {
        this.updatingCart = true;
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: item.key, quantity: 0 }),
        })
          .then((r) => r.json())
          .then((updatedCart) => {
            this.cartItems = this.cartItems.filter((i) => i.key !== item.key);
            this.subtotal = updatedCart.items_subtotal_price;
            this.total = updatedCart.total_price;
            this.totalSavings = updatedCart.total_discount;
            this.bus.$emit('refreshCart');
          })
          .catch(() => {})
          .finally(() => { this.updatingCart = false; });
      },
    },
  }).mount('.section-cart-{{ section.id }}');
</script>
{% schema %}
{
  "name": "t:general.cart",
  "class": "tw-px-8 tw-mb-24 tw-mx-auto tw-w-full",
  "settings": []
}
{% endschema %}
