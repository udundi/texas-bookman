{% style %}
  /* Dynamic desktop/mobile section padding driven by theme settings */
  .ud-events-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .ud-events-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section
  class="ud-events-{{ section.id }} tw-border-t tw-border-solid tw-border-brand-grey tw-w-full"
  id="ud-events-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tw-mx-auto tw-px-6 tw-max-w-screen-2xl tw-w-full">
    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="tw-font-semibold tw-text-center tw-mb-2 tw-font-montserrat"
        style="color: {{ section.settings.heading_color }}; font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);"
      >
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p
        class="tw-text-center tw-mb-9 tw-font-montserrat"
        style="color: {{ section.settings.subtext_color }}; font-size: {{ section.settings.subtext_size }}px;"
      >
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- comment -%} Event cards {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="tw-flex tw-flex-col">
        {%- for block in section.blocks -%}
          {%- render 'ud-event-card',
            section: section,
            shopify_attributes: block.shopify_attributes,
            image: block.settings.image,
            image_alt: block.settings.image.alt,
            title: block.settings.title,
            title_url: block.settings.title_url,
            location: block.settings.location,
            start_time: block.settings.blog.metafields.custom.start_time,
            end_time: block.settings.blog.metafields.custom.end_time,
            date_month: block.settings.date_month,
            date_day: block.settings.date_day,
            date_year: block.settings.date_year,
            description: block.settings.description,
            cta_label: block.settings.cta_label,
            cta_url: block.settings.cta_url
          -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} View All button {%- endcomment -%}
    {%- if section.settings.view_all_label != blank -%}
      <div class="tw-text-center tw-mt-8">
        <a
          href="{{ section.settings.view_all_url | default: '#' }}"
          class="tw-inline-block tw-font-semibold tw-uppercase tw-no-underline tw-py-2 tw-px-10 tw-rounded-[4px] tw-border tw-border-solid md:tw-text-12 tw-text-10 tw-bg-transparent tw-transition-colors hover:tw-bg-[var(--view-all-color)] hover:!tw-text-white tw-font-montserrat"
          style="
            --view-all-color: {{ section.settings.view_all_border_color }};
            border-color: {{ section.settings.view_all_border_color }};
            color: {{ section.settings.view_all_text_color }};
            font-size: {{ section.settings.view_all_font_size }}px;
          "
        >
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Events List",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
