<style>
  .column-padding-{{ block.id }} {
    padding: {{ block.settings.padding-top }}rem {{ block.settings.padding-right }}rem {{ block.settings.padding-bottom }}rem {{ block.settings.padding-left }}rem;
  }
</style>

{% assign list_tag = 'ul' %}
{% if block.settings['list-type'] == 'ordered' %}
  {% assign list_tag = 'ol' %}
{% endif %}

{% assign list_class = 'tw-w-full tw-flex tw-flex-col tw-gap-4 tw-items-start tw-text-start column-padding-{{ block.id }}' %}
{% if block.settings['list-type'] == 'unordered' %}
  {% assign list_class = list_class | append: ' tw-list-disc' %}
{% elsif block.settings['list-type'] == 'ordered' %}
  {% assign list_class = list_class | append: ' tw-list-decimal' %}
{% else %}
  {% assign list_class = list_class | append: ' tw-list-none' %}
{% endif %}

<{{ list_tag }} class="{{ list_class }}">
  {% for block in block.blocks %}
    <li>
      {% render block %}
    </li>
  {% endfor %}
</{{ list_tag }}>

{% schema %}
{
  "name": "List",
  "settings": [
    {
      "type": "select",
      "id": "list-type",
      "label": "List Type",
      "options": [
        { "value": "unordered", "label": "Unordered (bullet points)" },
        { "value": "ordered", "label": "Ordered (numbered)" },
        { "value": "none", "label": "None (no bullets)" }
      ],
      "default": "unordered"
    },
    {
      "type": "checkbox",
      "id": "gap-border",
      "label": "Add Gap Border",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-left",
      "label": "padding left",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-right",
      "label": "padding right",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "padding top",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "padding bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "_list-item"
    }
  ],
  "presets": [
    {
      "name": "List",
      "category": "Text Blocks",
      "blocks": [
        {
          "type": "_list-item",
          "settings": {
            "text": "Lorem ipsum dolor sit amet."
          }
        },
        {
          "type": "_list-item",
          "settings": {
            "text": "Lorem ipsum dolor sit amet."
          }
        }
      ]
    }
  ]
}
{% endschema %}
