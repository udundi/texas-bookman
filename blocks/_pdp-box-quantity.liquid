<div
  class="
    {% if block.settings.visibility contains 'mobile' %}
      tw-contents
      md:tw-hidden
    {% elsif block.settings.visibility contains "desktop" %}
      tw-hidden
      md:tw-contents
    {% else %}
      tw-contents
    {% endif %}
  "
>
  {% assign case_size = 8 %}
  {% assign available = product.selected_or_first_available_variant.inventory_quantity %}
  {% assign cases_available = available | divided_by: case_size %}
  {% assign case_size_discount = 8 %}
  <div class="tw-flex tw-flex-col tw-py-2 tw-px-3 tw-rounded-md tw-bg-brand-eggshell tw-border tw-border-brand-grey tw-items-start tw-gap-1">
    <div>
      <span class="tw-font-bold">Availability:</span>
      {{ available | default: 0 }} in stock
    </div>
    <div>
      <span class="tw-font-bold">Cases Available:</span> {{ cases_available | default: 0 }} |
      <span class="tw-font-bold">Cases Include:</span> {{ case_size | default: 0 }} books
    </div>
    <div class="tw-font-bold">
      Order in Multiples of {{ case_size | default: 0 }} for {{ case_size_discount | default: 0 }}% Off
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP Box Quantity",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "PDP Box Quantity"
    }
  ]
}
{% endschema %}
