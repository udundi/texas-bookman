{%- if block.settings.collection_gate != blank -%}
  {%- liquid
    assign gate = block.settings.collection_gate

    # When the store has a storefront filter for this subcategory (Search & Discovery,
    # e.g. the custom.category metafield), the gate is a multi-select checkbox on the
    # current collection. Otherwise it links to the gate's own collection.
    assign filter_param = block.settings.filter_param | default: 'filter.p.m.custom.category'
    assign filter_value = block.settings.filter_value | default: gate.title
    assign filter_found = false
    assign gate_value = nil
    unless collection == gate
      for filter in collection.filters
        if filter.param_name == filter_param
          assign filter_found = true
          for value in filter.values
            if value.value == filter_value
              assign gate_value = value
              break
            endif
          endfor
        endif
      endfor
    endunless
  -%}
  {%- if filter_found -%}
    {%- liquid
      # Hide subcategories with no results, unless already selected.
      assign show_gate = false
      if gate_value
        if gate_value.active or gate_value.count > 0
          assign show_gate = true
        endif
      endif
    -%}
    {%- if show_gate -%}
      <div class="tw-p-1">
        {%- if gate_value.active -%}
          {%- assign gate_href = gate_value.url_to_remove -%}
        {%- else -%}
          {%- assign gate_href = gate_value.url_to_add -%}
        {%- endif -%}
        {% render 'collection-filter-checkbox',
          href: gate_href,
          checked: gate_value.active,
          label: block.settings.title,
          count: gate_value.count
        %}
      </div>
    {%- endif -%}
  {%- elsif collection == gate or gate.all_products_count > 0 -%}
    <div class="tw-p-1">
      {%- liquid
        # theme-check-disable
        capture content_for_query_string
          echo content_for_header
        endcapture
      -%}

      {% assign get_full_url = content_for_query_string
        | split: '"pageurl":"'
        | last
        | split: '"'
        | first
        | split: '.myshopify.com'
        | last
        | replace: '\/', '/'
        | replace: '%20', ' '
        | replace: '\u0026', '&'
        | replace: collection.url, ''
        | replace: 'feltright.com', ''
      %}
      {% assign query_params = get_full_url | replace: '?', '' | replace: '_fd=0&pb=0&', '' | split: '&' %}
      {%- liquid
        assign is_current_gate = false
        if collection == gate
          assign is_current_gate = true
          assign gate_href = routes.all_products_collection_url
          assign gate_count = collection.all_products_count
        else
          assign gate_href = gate.url
          assign gate_count = gate.all_products_count
        endif
        if query_params != blank
          assign joined_params = query_params | join: '&'
          assign gate_href = gate_href | append: '?' | append: joined_params
        endif
      -%}
      {% render 'collection-filter-checkbox',
        href: gate_href,
        checked: is_current_gate,
        label: block.settings.title,
        count: gate_count
      %}
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection Gate",
  "settings": [
    {
      "type": "collection",
      "id": "collection_gate",
      "label": "Linked Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Link Title",
      "default": "Filter Title"
    },
    {
      "type": "text",
      "id": "filter_param",
      "label": "Storefront filter",
      "info": "Search & Discovery filter that selects this subcategory. When the store has it enabled, the gate becomes a multi-select checkbox instead of a link to the collection.",
      "placeholder": "filter.p.m.custom.category"
    },
    {
      "type": "text",
      "id": "filter_value",
      "label": "Filter value",
      "info": "Defaults to the linked collection's title.",
      "placeholder": "Art"
    }
  ],
  "presets": [
    {
      "name": "Collection Gate"
    }
  ]
}
{% endschema %}
