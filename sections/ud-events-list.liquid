{% style %}
  .ud-events-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .ud-events-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }

  .ud-events-{{ section.id }} .events-inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .ud-events-{{ section.id }} .events-heading {
    font-weight: 700;
    text-align: center;
    color: {{ section.settings.heading_color }};
    font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);
    margin-bottom: 0.5rem;
  }

  .ud-events-{{ section.id }} .events-subtext {
    text-align: center;
    color: {{ section.settings.subtext_color }};
    font-size: {{ section.settings.subtext_size }}px;
    margin-bottom: 2.25rem;
  }

  /* Event Cards */
  .ud-events-{{ section.id }} .event-card {
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-bottom: 1.25rem;
    overflow: hidden;
    background: {{ section.settings.card_bg }};
  }

  .ud-events-{{ section.id }} .event-card:last-child {
    margin-bottom: 0;
  }

  .ud-events-{{ section.id }} .event-thumbnail {
    flex-shrink: 0;
    width: 220px;
    margin: 1.25rem 0 1.25rem 1.25rem;
    border-radius: 6px;
    object-fit: cover;
    object-position: center;
    align-self: flex-start;
  }

  .ud-events-{{ section.id }} .event-thumbnail-placeholder {
    flex-shrink: 0;
    width: 220px;
    margin: 1.25rem 0 1.25rem 1.25rem;
    border-radius: 6px;
    background: #e5e7eb;
    align-self: flex-start;
    min-height: 148px;
  }

  .ud-events-{{ section.id }} .event-content {
    flex: 1;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .ud-events-{{ section.id }} .event-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .ud-events-{{ section.id }} .event-titles {
    flex: 1;
    min-width: 0;
  }

  .ud-events-{{ section.id }} .event-title {
    display: block;
    font-weight: 700;
    color: {{ section.settings.event_title_color }};
    font-size: {{ section.settings.event_title_size }}px;
    line-height: 1.3;
    margin-bottom: 0.4rem;
    text-decoration: none;
  }

  .ud-events-{{ section.id }} .event-title:hover {
    text-decoration: underline;
  }

  .ud-events-{{ section.id }} .event-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.meta_color }};
    font-size: {{ section.settings.meta_size }}px;
    flex-wrap: wrap;
  }

  .ud-events-{{ section.id }} .event-meta-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    stroke: {{ section.settings.meta_color }};
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ud-events-{{ section.id }} .event-meta-divider {
    color: {{ section.settings.meta_color }};
    opacity: 0.5;
  }

  /* Date Badge */
  .ud-events-{{ section.id }} .event-date-badge {
    flex-shrink: 0;
    background-color: {{ section.settings.badge_bg }};
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.75rem;
    min-width: 64px;
    text-align: center;
  }

  .ud-events-{{ section.id }} .badge-month {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ section.settings.badge_text_color }};
    line-height: 1.2;
  }

  .ud-events-{{ section.id }} .badge-day {
    font-size: 28px;
    font-weight: 700;
    color: {{ section.settings.badge_text_color }};
    line-height: 1.1;
  }

  .ud-events-{{ section.id }} .badge-year {
    font-size: 11px;
    font-weight: 700;
    color: {{ section.settings.badge_text_color }};
    line-height: 1.2;
  }

  /* Description */
  .ud-events-{{ section.id }} .event-description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  /* CTA Button */
  .ud-events-{{ section.id }} .event-cta {
    display: inline-block;
    background-color: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_text_color }};
    font-weight: 700;
    font-size: {{ section.settings.cta_font_size }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    border-radius: {{ section.settings.cta_border_radius }}px;
    margin-top: 0.25rem;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .ud-events-{{ section.id }} .event-cta:hover {
    opacity: 0.85;
  }

  /* View All Button */
  .ud-events-{{ section.id }} .events-view-all-wrap {
    text-align: center;
    margin-top: 2rem;
  }

  .ud-events-{{ section.id }} .events-view-all {
    display: inline-block;
    border: 1.5px solid {{ section.settings.view_all_border_color }};
    color: {{ section.settings.view_all_text_color }};
    background: transparent;
    font-weight: 700;
    font-size: {{ section.settings.view_all_font_size }}px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.55rem 2.5rem;
    transition: background 0.2s, color 0.2s;
  }

  .ud-events-{{ section.id }} .events-view-all:hover {
    background: {{ section.settings.view_all_border_color }};
    color: #fff;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .ud-events-{{ section.id }} .event-card {
      flex-direction: column;
    }

    .ud-events-{{ section.id }} .event-thumbnail,
    .ud-events-{{ section.id }} .event-thumbnail-placeholder {
      width: calc(100% - 2rem);
      margin: 1rem 1rem 0;
      min-height: 180px;
    }

    .ud-events-{{ section.id }} .event-header-row {
      flex-wrap: wrap;
    }

    .ud-events-{{ section.id }} .event-date-badge {
      order: -1;
    }
  }
{% endstyle %}

<section
  class="ud-events-{{ section.id }} tw-border-t tw-border-solid tw-border-brand-grey"
  id="ud-events-{{ section.id }}"
>
  <div class="events-inner">
    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="events-heading tw-font-montserrat">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="events-subtext tw-font-montserrat">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- comment -%} Event cards {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="events-list">
        {%- for block in section.blocks -%}
          <article class="event-card" {{ block.shopify_attributes }}>
            {%- comment -%} Thumbnail {%- endcomment -%}
            {%- if block.settings.image != blank -%}
              {%- assign thumb_alt = block.settings.image.alt | default: block.settings.title | default: '' | escape -%}
              <img
                src="{{ block.settings.image | image_url: width: 440 }}"
                alt="{{ thumb_alt }}"
                class="event-thumbnail"
                loading="lazy"
                width="220"
                height="148"
              >
            {%- else -%}
              <div class="event-thumbnail-placeholder" aria-hidden="true"></div>
            {%- endif -%}

            <div class="event-content">
              <div class="event-header-row">
                <div class="event-titles">
                  {%- if block.settings.title != blank -%}
                    {%- if block.settings.title_url != blank -%}
                      <a href="{{ block.settings.title_url }}" class="event-title tw-font-montserrat">
                        {{ block.settings.title }}
                      </a>
                    {%- else -%}
                      <span class="event-title tw-font-montserrat">{{ block.settings.title }}</span>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.time != blank or block.settings.location != blank -%}
                    <div class="event-meta tw-font-montserrat">
                      {%- comment -%} Clock icon {%- endcomment -%}
                      <svg class="event-meta-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      {%- if block.settings.time != blank -%}
                        <span>{{ block.settings.time }}</span>
                      {%- endif -%}
                      {%- if block.settings.time != blank and block.settings.location != blank -%}
                        <span class="event-meta-divider">|</span>
                      {%- endif -%}
                      {%- if block.settings.location != blank -%}
                        <span>{{ block.settings.location }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

                {%- comment -%} Date badge {%- endcomment -%}
                {%- if block.settings.date_month != blank or block.settings.date_day != blank -%}
                  <div
                    class="event-date-badge"
                    aria-label="{{ block.settings.date_month }} {{ block.settings.date_day }} {{ block.settings.date_year }}"
                  >
                    {%- if block.settings.date_month != blank -%}
                      <span class="badge-month">{{ block.settings.date_month }}</span>
                    {%- endif -%}
                    {%- if block.settings.date_day != blank -%}
                      <span class="badge-day">{{ block.settings.date_day }}</span>
                    {%- endif -%}
                    {%- if block.settings.date_year != blank -%}
                      <span class="badge-year">{{ block.settings.date_year }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.description != blank -%}
                <p class="event-description tw-font-montserrat">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.cta_label != blank -%}
                <a
                  href="{{ block.settings.cta_url | default: '#' }}"
                  class="event-cta tw-font-montserrat tw-rounded-md"
                >
                  {{ block.settings.cta_label }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} View All button {%- endcomment -%}
    {%- if section.settings.view_all_label != blank -%}
      <div class="events-view-all-wrap">
        <a
          href="{{ section.settings.view_all_url | default: '#' }}"
          class="events-view-all tw-font-montserrat tw-rounded-md"
        >
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
