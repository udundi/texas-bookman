{% style %}
  /* Dynamic desktop/mobile section padding driven by theme settings */
  .ud-events-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .ud-events-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section
  class="ud-events-{{ section.id }} tw-w-full"
  id="ud-events-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tw-mx-auto tw-px-6" style="max-width: {{ section.settings.content_max_width }}px;">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="tw-font-bold tw-mb-2 tw-font-montserrat"
        style="
          color: {{ section.settings.heading_color }};
          font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);
          text-align: {{ section.settings.heading_alignment }};
        "
      >
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p
        class="tw-mb-9 tw-font-montserrat"
        style="color: {{ section.settings.subtext_color }}; font-size: {{ section.settings.subtext_size }}px; text-align: {{ section.settings.subtext_alignment }};"
      >
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- assign selected_blog = section.settings.blog -%}
    {%- if selected_blog != blank -%}
      {%- assign event_count = blogs[selected_blog].articles | size -%}
      <div class="tw-flex tw-items-center tw-justify-between tw-mb-6">
        <p class="tw-font-semibold tw-text-18 tw-text-offblack tw-m-0 tw-font-montserrat">
          Showing {{ event_count }} Scheduled Event{% if event_count != 1 %}s{% endif %}
        </p>
      </div>

      <div class="tw-flex tw-flex-col">
        {%- for article in blogs[selected_blog].articles -%}
          {%- assign date_str = article.published_at | date: '%b|%d|%Y' | split: '|' -%}
          <article
            class="tw-flex tw-flex-col tw-items-stretch tw-overflow-hidden tw-mb-5 last:tw-mb-0 md:tw-flex-row"
            style="border: 1px solid {{ section.settings.card_border_color }}; border-radius: {{ section.settings.card_border_radius }}px; background-color: {{ section.settings.card_bg }};"
          >
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 440 }}"
                alt="{{ article.title | escape }}"
                class="tw-shrink-0 tw-self-start tw-rounded-md tw-object-cover tw-object-center tw-w-[calc(100%-2rem)] tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-w-[600px] md:tw-mx-0 md:tw-ml-5 md:tw-my-5 md:tw-min-h-0"
                loading="lazy"
                width="220"
                height="148"
              >
            {%- else -%}
              <div
                class="tw-shrink-0 tw-self-start tw-rounded-md tw-bg-grey-light tw-w-[calc(100%-2rem)] tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-w-[600px] md:tw-mx-0 md:tw-ml-5 md:tw-my-5"
                aria-hidden="true"
              ></div>
            {%- endif -%}

            <div class="tw-flex tw-flex-1 tw-flex-col tw-gap-2 tw-min-w-0 tw-p-5 md:tw-pl-6">
              <div class="tw-flex tw-min-w-0 tw-flex-1 tw-items-start tw-justify-between tw-gap-4 tw-flex-wrap">
                <a
                  href="{{ article.url }}"
                  class="tw-block tw-font-bold tw-leading-tight tw-mb-1 tw-no-underline hover:tw-underline tw-font-montserrat"
                  style="color: {{ section.settings.event_title_color }}; font-size: {{ section.settings.event_title_size }}px;"
                >
                  {{ article.title }}
                </a>
              </div>

              {%- assign start_time = article.metafields.custom.start_time.value -%}
              {%- assign end_time = article.metafields.custom.end_time.value -%}
              {%- assign location = article.metafields.custom.location.value -%}
              {%- if start_time != blank or location != blank -%}
                <div
                  class="tw-flex tw-items-center tw-gap-1 tw-flex-wrap tw-font-montserrat"
                  style="color: {{ section.settings.meta_color }}; font-size: {{ section.settings.meta_size }}px;"
                >
                  <svg
                    class="tw-shrink-0 tw-size-3.5 tw-fill-none"
                    style="stroke: {{ section.settings.meta_color }}; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  {%- if start_time != blank -%}
                    <span>
                      {{- start_time | date: '%I:%M %p' -}}
                      {%- if end_time != blank %} - {{ end_time | date: '%I:%M %p' }}{% endif -%}
                    </span>
                  {%- endif -%}
                  {%- if start_time != blank and location != blank -%}
                    <span class="tw-opacity-50">|</span>
                  {%- endif -%}
                  {%- if location != blank -%}
                    <span>{{ location }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if article.excerpt != blank -%}
                <p
                  class="tw-m-0 tw-leading-relaxed tw-font-montserrat"
                  style="color: {{ section.settings.description_color }}; font-size: {{ section.settings.description_size }}px;"
                >
                  {{ article.excerpt | strip_html | truncatewords: 30 }}
                </p>
              {%- endif -%}

              {%- assign cta_text = article.metafields.custom.cta_text.value -%}
              {%- assign cta_link = article.metafields.custom.cta_link.value -%}
              {%- if cta_text != blank -%}
                <a
                  href="{{ cta_link | default: article.url }}"
                  class="tw-inline-block tw-self-start tw-font-bold tw-uppercase tw-tracking-wider tw-no-underline tw-mt-1 tw-py-2 tw-px-5 tw-transition-opacity hover:tw-opacity-85 tw-font-montserrat"
                  style="background-color: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_text_color }}; font-size: {{ section.settings.cta_font_size }}px; border-radius: {{ section.settings.cta_border_radius }}px;"
                >
                  {{ cta_text }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "All Events",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#212121"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Min Size (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Max Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 40
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join us at our upcoming events and trade shows"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#212121"
    },
    {
      "type": "select",
      "id": "subtext_alignment",
      "label": "Subtext Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext Font Size (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Blog Selection"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog",
      "info": "Choose the blog containing your events"
    },
    {
      "type": "header",
      "content": "Event Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "color",
      "id": "event_title_color",
      "label": "Event Title Color",
      "default": "#20448F"
    },
    {
      "type": "range",
      "id": "event_title_size",
      "label": "Event Title Size (px)",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta (time/location) Color",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta Font Size (px)",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Date Badge"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#F0BA3A"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#212121"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA Background",
      "default": "#20448F"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_font_size",
      "label": "CTA Font Size (px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "cta_border_radius",
      "label": "CTA Border Radius (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 2
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FDFBF8"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width (px)",
      "min": 600,
      "max": 1600,
      "step": 40,
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "All Events"
    }
  ]
}
{% endschema %}
