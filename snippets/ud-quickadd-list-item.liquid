{% assign product_id = section.id | append: '-' | append: product.handle | append: '-list-atc' %}
{% assign product_atc_id = product_id | append: '-atc' %}

<div
  id="{{ product_id }}"
  class="{{ class }} tw-flex tw-flex-row tw-items-center tw-border tw-mb-[-1px] tw-border-gray-400 tw-p-4 tw-gap-4 tw-w-full"
>
  <!-- Product Image -->
  <a
    href="{% if product.metafields.custom.alt_gallery_link != blank %}{{ product.metafields.custom.alt_gallery_link.value.url }}{% else %}{{ product.url | default: "/" }}{% endif %}"
    class="tw-flex-shrink-0"
  >
    <div class="tw-w-24 tw-h-24 tw-aspect-square tw-object-contain tw-relative">
      {% if product.featured_image != blank %}
        {{
          product.featured_image
          | image_url: width: 200
          | image_tag: loading: 'lazy', class: 'tw-size-full tw-aspect-square tw-object-contain'
        }}
      {% else %}
        <div class="tw-size-full">
          {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover' }}
        </div>
      {% endif %}
      {% if product.tags contains 'New Product' %}
        <div class="tw-absolute tw-top-1 tw-right-1 tw-text-10 tw-px-2 tw-py-0.5 tw-bg-black tw-rounded-full tw-text-white tw-font-semibold">
          New
        </div>
      {% endif %}
    </div>
  </a>

  <!-- Product Info -->
  <div class="tw-flex-1 tw-flex tw-flex-col tw-justify-start tw-gap-2 tw-min-w-0">
    <!-- Title and Product Details -->
    <div class="tw-flex tw-flex-col tw-gap-1">
      <a href="{{ product.url | default: "/" }}" class="tw-max-w-xs">
        <h3 class="tw-font-semibold tw-text-13 tw-text-brand-primary tw-leading-tight tw-m-0 tw-truncate">
          {{ product.title | default: 'Product title' }}
        </h3>
      </a>

      <!-- Product Details Row -->
      <div class="tw-flex tw-flex-wrap tw-gap-x-3 tw-gap-y-0.5 tw-text-12">
        st
        {% if product.metafields.custom.isbn != blank %}
          <span class="tw-text-gray-600"> ISBN: {{ product.metafields.custom.isbn.value }} </span>
        {% endif %}
        <span class="tw-text-gray-600">
          QTY: {{ product.selected_or_first_available_variant.inventory_quantity }}
        </span>
      </div>
    </div>

    <!-- Pricing Info -->
    <div class="tw-flex tw-flex-wrap tw-gap-x-4 tw-gap-y-0.5 tw-text-12">
      {% if product.compare_at_price != blank %}
        <span class="tw-text-gray-600"> List: {{ product.compare_at_price | money }} </span>
      {% endif %}
      <span class="tw-font-semibold tw-text-brand-sale"> Your Net Price: {{ product.price | money }} </span>
    </div>
  </div>

  <!-- Action Section -->
  <div class="tw-flex-shrink-0">
    {% if show_button_type != 'none' %}
      {% if show_button_type == 'quick-add' %}
        <div class="tw-flex tw-items-center tw-gap-2 tw-h-full">
          <div class="tw-flex tw-items-center tw-gap-1">
            <label for="{{ product_id }}-qty" class="tw-text-12 tw-font-semibold">QTY:</label>
            <input
              id="{{ product_id }}-qty"
              type="number"
              min="1"
              placeholder="1"
              v-model.number="quantity"
              class="tw-w-14 tw-text-center tw-leading-none tw-py-1 tw-px-1 tw-border tw-border-gray-400 tw-rounded tw-text-12 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
              :disabled="addingToCart"
            >
          </div>
          <button
            type="button"
            id="{{ product_atc_id }}"
            class="tw-bg-brand-secondary tw-cursor-pointer tw-pointer-events-auto tw-text-11 tw-text-black tw-rounded-md tw-flex tw-justify-center tw-leading-none tw-px-3 tw-py-1 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center"
            @click="addToCart()"
            :disabled="addingToCart"
          >
            [[ addingToCart ? 'Adding...' : '{{ button_text | default: 'Add' }}' ]]
          </button>
        </div>
      {% else %}
        <a
          href="{{ product.url }}"
          class="tw-bg-white tw-cursor-pointer tw-pointer-events-auto tw-text-11 tw-text-black tw-rounded-full tw-flex tw-justify-center tw-border-black tw-border tw-py-1 tw-px-3 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap"
        >
          <span>{{ button_text | default: 'View' }}</span>
        </a>
      {% endif %}
    {% endif %}
  </div>
</div>

<script>
  new Vue({
    el: '#{{ product_id }}',
    data() {
      return {
        addingToCart: false,
        productPrice: '{{ product.price }}',
        quantity: 1,
      };
    },
    methods: {
      addToCart() {
        this.addingToCart = true;
        let items = [
          {
            quantity: this.quantity,
            'properties': {
              '_tags': {{ product.tags | json }},
            },
            id: '{{ product.selected_or_first_available_variant.id }}',
          },
        ];
        console.log(items);

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw data;
          return data;
        }).then((data) => {
          console.log(data);
          this.bus.$emit('showCart');
          this.bus.$emit('refreshCart');
          this.addingToCart = false;
          this.$forceUpdate();
        }).catch((error) => {
          console.log(error, 'caught error');
          Swal.fire({
            icon: 'error',
            text: error && error.description ? error.description : 'Unable to add item to cart.',
          });
          this.addingToCart = false;
        }).finally(() => {
          this.addingToCart = false;
        });
      },
    },
  });
</script>
