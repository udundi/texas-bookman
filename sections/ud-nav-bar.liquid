<div id="nav-bar-{{ section.id }}" class="tw-border-b tw-bg-brand-eggshell tw-border-brand-grey">
  <div class="tw-relative tw-z-[80] tw-mx-auto tw-flex tw-w-full tw-max-w-screen-2xl tw-items-center tw-justify-between ">
    <nav
      v-cloak
      @mouseleave="handleMouseLeave"
      role="navigation"
      aria-label="Main Menu"
      class="tw-w-full md:tw-h-full"
      :class="showMobile ? 'tw-block max-md:tw-absolute max-md:tw-left-0 max-md:tw-right-0 max-md:tw-top-full max-md:tw-z-[900] max-md:tw-overflow-y-auto max-md:tw-bg-brand-eggshell max-md:tw-shadow-lg' : 'md:tw-flex tw-hidden'"
      :style="showMobile ? { maxHeight: `calc(100dvh - ${mobileMenuTop}px)`, WebkitOverflowScrolling: 'touch', overscrollBehavior: 'contain' } : {}"
    >
      <!-- Nav Container: max-height + overflow-y-auto live on the nav itself so scrolling doesn't depend on child percentage heights -->
      <div
        class=" tw-p-0 tw-w-full"
      >
        <!-- Nav Container: Centered horizontal AutoLayout with exact 30px gap matching Figma node 92:1483 / Frame 1 -->
        <div class="tw-flex tw-h-full tw-w-full tw-flex-col tw-justify-start tw-text-12 md:tw-flex-row md:tw-justify-center md:tw-items-center md:tw-gap-[30px]">
          {% for block in section.blocks %}
            {% render block %}
          {% endfor %}
        </div>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Backdrop: starts below the nav so it doesn't cover the menu itself -->
  <div
    v-cloak
    v-if="showMobile"
    :style="{ top: mobileMenuTop + 'px' }"
    class="tw-fixed tw-left-0 tw-right-0 tw-bottom-0 !tw-z-20 tw-bg-black tw-bg-opacity-50 md:tw-hidden"
    @click="closeMobileNav()"
  ></div>
</div>
<script>
  new Vue({
    el: '#nav-bar-{{ section.id }}',
    delimiters: ['[[', ']]'],
    mixins: [],
    data() {
      return {
        selectedTab: '',
        selectedSubTab: '',
        showMobile: false,
        showMobileMenu: false,
        mobileMenuTop: 0,
        mobileDropdown: null,
        mobileSection: null,
        mobileSubSection: null,
        hoverTimer: null,
      };
    },

    async mounted() {
      const vw = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
      const vh = Math.max(document.documentElement.clientHeight || 0, window.innerHeight || 0);

      setTimeout(() => {
        const el = document.getElementById('nav-bar-{{ section.id }}');
        this.sectionHeight = el ? el.offsetHeight : 0;
        const spacer = document.getElementById('header-spacer-{{ section.id }}');
        if (spacer) {
          spacer.style.height = `${this.sectionHeight}px`;
        }
        document.documentElement.style.setProperty('--site-header-height', `${this.sectionHeight}px`);
      }, 10);
      window.addEventListener('resize', this.resizeSpacer);
      this.bus.$on('mobileNavToggle', (isOpen) => {
        this.showMobile = isOpen;
        const stickyHeader = document.getElementById('sticky-header-group');
        if (isOpen) {
          document.body.classList.add('mobile-nav-open');
          if (stickyHeader) {
            stickyHeader.classList.add('mobile-menu--open');
            stickyHeader.classList.remove('header-group--faded');
          }
          const el = document.getElementById('nav-bar-{{ section.id }}');
          this.mobileMenuTop = el ? el.getBoundingClientRect().bottom : 0;
        } else {
          document.body.classList.remove('mobile-nav-open');
          if (stickyHeader) {
            stickyHeader.classList.remove('mobile-menu--open');
          }
          this.selectedTab = '';
          this.selectedSubTab = '';
        }
      });
    },
    unmounted() {
      window.removeEventListener('resize', this.resizeSpacer);
    },

    watch: {
      showMobileMenu() {
        this.$nextTick(() => {
          // a/b test specific logic
          const currentVariant = document.documentElement.dataset.testVariant || 'a';
          if (this.showMobileMenu) {
            this.$refs.mobileNavMenu?.querySelector(`[data-test-show='${currentVariant}'] :is(a, button)`)?.focus();
          }
        });
      },
    },

    methods: {
      // Only auto-closes on hover-out for desktop; mobile nav is click/tap driven and shouldn't close on "mouseleave"
      handleMouseLeave() {
        if (window.innerWidth < 768) return;
        this.showMobile = false;
        this.selectedTab = '';
        this.selectedSubTab = '';
      },

      // Closes the mobile menu here and tells the header's hamburger/backdrop to close too
      closeMobileNav() {
        this.showMobile = false;
        this.selectedTab = '';
        this.selectedSubTab = '';
        document.body.classList.remove('mobile-nav-open');
        const stickyHeader = document.getElementById('sticky-header-group');
        if (stickyHeader) {
          stickyHeader.classList.remove('mobile-menu--open');
        }
        this.bus.$emit('mobileNavToggle', false);
      },

      resizeSpacer(e) {
        if (window.innerWidth >= 768 && this.showMobile) {
          this.closeMobileNav();
        }
        const el = document.getElementById('nav-bar-{{ section.id }}');
        this.sectionHeight = el ? el.offsetHeight : 0;
        const spacer = document.getElementById('header-spacer-{{ section.id }}');
        const navContainer = document.getElementById('nav-container');
        if (spacer) {
          spacer.style.height = `${this.sectionHeight}px`;
        }
        if (navContainer) {
          navContainer.style.height = `${this.sectionHeight}px`;
        }
        document.documentElement.style.setProperty('--site-header-height', `${this.sectionHeight}px`);
        if (this.showMobile) {
          this.mobileMenuTop = el ? el.getBoundingClientRect().bottom : 0;
        }
        if (this.selectedTab) {
          this.positionDropdown(this.selectedTab);
        }
      },

      refocusMenu(event) {
        this.$refs.mobileMenuButton.focus();
        console.log(event, 'refocusing menu');
      },

      // Keeps the dropdown centered under its tab, nudging it back on screen if it would overflow the viewport
      positionDropdown(blockId) {
        this.$nextTick(() => {
          const navBar = document.getElementById('nav-bar-{{ section.id }}');
          const dropdown = navBar ? navBar.querySelector(`.nav-dropdown[data-tab-id="${blockId}"]`) : null;
          if (!dropdown) return;
          // Mobile dropdown is a static, full-width panel (no centering transform needed/wanted)
          if (window.innerWidth < 768) {
            dropdown.style.transform = '';
            return;
          }
          const manualOffset = parseFloat(dropdown.dataset.offset) || 0;
          dropdown.style.transform = manualOffset ? `translateX(calc(-50% + ${manualOffset}px))` : '';
          const rect = dropdown.getBoundingClientRect();
          const margin = 16;
          if (rect.left < margin) {
            dropdown.style.transform = `translateX(calc(-50% + ${manualOffset + (margin - rect.left)}px))`;
          } else if (rect.right > window.innerWidth - margin) {
            dropdown.style.transform = `translateX(calc(-50% + ${
              manualOffset - (rect.right - (window.innerWidth - margin))
            }px))`;
          }
        });
      },

      hoverSubTab(subTabClass) {
        clearTimeout(this.hoverTimer);
        this.hoverTimer = setTimeout(() => {
          this.selectedSubTab = subTabClass;
        }, 150);
      },

      showCart() {
        this.bus.$emit('showCart');
      },
    },
  });
</script>

<style>
  /* Prevent flash of uninitialized Vue content */
  [v-cloak] {
    display: none !important;
    visibility: hidden !important;
  }
  .ud-mobileMenuV2 {
    top: 48px;
    z-index: 1000;
  }

  .mobileMenuBG {
    z-index: -1000;
  }

  .ud-mobileMenuV2::backdrop {
    height: 100%;
    margin: 0;
    background: rgba(0, 0, 0, 0.5);
    width: 100%;
    padding: 0;
  }
</style>

