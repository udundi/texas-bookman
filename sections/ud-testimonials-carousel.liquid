{% style %}
  .ud-testimonials-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .ud-testimonials-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }

  .ud-testimonials-{{ section.id }} .testimonials-heading {
    text-align: center;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);
    margin-bottom: 2rem;
    padding: 0 1.5rem;
  }

  /* Outer wrapper: holds arrows + swiper side-by-side */
  .ud-testimonials-{{ section.id }} .testimonials-slider-outer {
    position: relative;
    display: flex;
    align-items: center;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  @media screen and (max-width: 749px) {
    .ud-testimonials-{{ section.id }} .testimonials-slider-outer {
      padding: 0 2.5rem;
    }
  }

  /* Swiper container */
  .ud-testimonials-{{ section.id }} .swiper {
    width: 100%;
    overflow: hidden;
  }

  /* Cards */
  .ud-testimonials-{{ section.id }} .testimonial-card {
    background: #fff;
    border: 1px solid {{ section.settings.card_border_color }};
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  .ud-testimonials-{{ section.id }} .testimonial-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 1rem;
  }

  .ud-testimonials-{{ section.id }} .testimonial-star {
    color: {{ section.settings.star_color }};
    font-size: 1.1rem;
    line-height: 1;
  }

  .ud-testimonials-{{ section.id }} .testimonial-title {
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size }}px;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .ud-testimonials-{{ section.id }} .testimonial-quote {
    color: {{ section.settings.card_body_color }};
    font-size: {{ section.settings.card_body_size }}px;
    line-height: 1.6;
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .ud-testimonials-{{ section.id }} .testimonial-logo {
    margin-top: auto;
    max-height: {{ section.settings.logo_max_height }}px;
    max-width: {{ section.settings.logo_max_width }}px;
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  /* Arrows */
  .ud-testimonials-{{ section.id }} .swiper-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    color: {{ section.settings.arrow_color }};
    background: none;
    border: none;
    padding: 0;
    transition: opacity 0.2s;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .ud-testimonials-{{ section.id }} .swiper-btn:hover {
    opacity: 0.6;
  }

  .ud-testimonials-{{ section.id }} .swiper-btn.swiper-prev-{{ section.id }} {
    left: 0;
  }

  .ud-testimonials-{{ section.id }} .swiper-btn.swiper-next-{{ section.id }} {
    right: 0;
  }

  .ud-testimonials-{{ section.id }} .swiper-btn svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ud-testimonials-{{ section.id }} .swiper-btn.swiper-button-disabled {
    opacity: 0.25;
    cursor: default;
  }
{% endstyle %}

<div class="ud-testimonials-{{ section.id }} tw">

  {%- if section.settings.heading != blank -%}
    <{{ section.settings.heading_tag }} class="testimonials-heading">
      {{ section.settings.heading }}
    </{{ section.settings.heading_tag }}>
  {%- endif -%}

  <div class="testimonials-slider-outer">

    {%- comment -%} Prev arrow {%- endcomment -%}
    <button
      class="swiper-btn swiper-prev-{{ section.id }}"
      aria-label="Previous testimonial">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    {%- comment -%} Swiper {%- endcomment -%}
    <div class="swiper testimonials-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="testimonial-card">

              {%- comment -%} Stars {%- endcomment -%}
              {%- assign star_count = block.settings.star_count | default: 5 -%}
              <div class="testimonial-stars" aria-label="{{ star_count }} out of 5 stars">
                {%- for i in (1..star_count) -%}
                  <span class="testimonial-star" aria-hidden="true">&#9733;</span>
                {%- endfor -%}
              </div>

              {%- comment -%} Title {%- endcomment -%}
              {%- if block.settings.title != blank -%}
                <p class="testimonial-title">{{ block.settings.title }}</p>
              {%- endif -%}

              {%- comment -%} Quote {%- endcomment -%}
              {%- if block.settings.quote != blank -%}
                <p class="testimonial-quote">{{ block.settings.quote }}</p>
              {%- endif -%}

              {%- comment -%} Logo {%- endcomment -%}
              {%- if block.settings.logo != blank -%}
                {%- assign logo_alt = block.settings.logo.alt | default: block.settings.attribution | default: '' | escape -%}
                {{ block.settings.logo | image_url: width: 300 | image_tag: class: 'testimonial-logo', alt: logo_alt, loading: 'lazy' }}
              {%- elsif block.settings.attribution != blank -%}
                <p class="testimonial-title" style="font-style: italic; font-weight: 400;">— {{ block.settings.attribution }}</p>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Next arrow {%- endcomment -%}
    <button
      class="swiper-btn swiper-next-{{ section.id }}"
      aria-label="Next testimonial">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

  </div>
</div>

<script>
  (function () {
    function initTestimonialsSwiper() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initTestimonialsSwiper, 100);
        return;
      }

      new Swiper('.testimonials-swiper-{{ section.id }}', {
        slidesPerView: 1,
        spaceBetween: {{ section.settings.card_gap }},
        loop: {{ section.settings.loop }},
        navigation: {
          prevEl: '.swiper-prev-{{ section.id }}',
          nextEl: '.swiper-next-{{ section.id }}',
          disabledClass: 'swiper-button-disabled',
        },
        a11y: {
          prevSlideMessage: 'Previous testimonial',
          nextSlideMessage: 'Next testimonial',
        },
        breakpoints: {
          750: {
            slidesPerView: {{ section.settings.slides_per_view_tablet }},
            spaceBetween: {{ section.settings.card_gap }},
          },
          1024: {
            slidesPerView: {{ section.settings.slides_per_view_desktop }},
            spaceBetween: {{ section.settings.card_gap }},
          },
        },
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestimonialsSwiper);
    } else {
      initTestimonialsSwiper();
    }
  })();
</script>

{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted Wholesale Distribution Since 1983"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Min Size (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Max Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Section Max Width (px)",
      "min": 600,
      "max": 1600,
      "step": 40,
      "default": 1280
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Slides Visible — Desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "label": "Slides Visible — Tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards (px)",
      "min": 8,
      "max": 60,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Infinitely",
      "default": true
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding (px)",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 28
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F0BA3A"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card Title Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "color",
      "id": "card_body_color",
      "label": "Quote Text Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "card_body_size",
      "label": "Quote Text Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo Max Height (px)",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 52
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo Max Width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 160
    },
    {
      "type": "header",
      "content": "Arrows"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#212121"
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "star_count",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Great Selection at Great Prices"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"We've been ordering from Texas Bookman for years. Their inventory is always changing, the pricing is competitive, and orders arrive quickly.\""
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution (if no logo)",
          "info": "Shown as a text fallback when no logo image is set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Carousel",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "title": "Great Selection at Great Prices",
            "quote": "\"We've been ordering from Texas Bookman for years. Their inventory is always changing, the pricing is competitive, and orders arrive quickly. It's become one of our go-to wholesale suppliers.\""
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "Easy to Work With",
            "quote": "\"The ordering process was straightforward, and their team was incredibly helpful throughout. We found exactly what we needed and appreciated the fast turnaround.\""
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "title": "Reliable Wholesale Partner",
            "quote": "\"We're always impressed by the variety of titles available and the value we receive. Texas Bookman makes it easy to keep our shelves stocked with books our customers love.\""
          }
        }
      ]
    }
  ]
}
{% endschema %}
