<!-- Direct Link (no dropdown) -->
<div class="tw-group tw-relative tw-flex tw-h-full tw-bg-brand-eggshell tw-items-center tw-justify-center">
  <a
    href="{{ block.settings.link_url }}"
    class="tw-relative tw-hidden tw-border-y-2 tw-border-solid tw-border-transparent hover:tw-border-b-brand-primary hover:tw-text-brand-primary md:tw-py-[7px] tw-py-3 md:tw-px-0 tw-px-1.5 tw-font-brand-body !tw-text-12 tw-font-semibold md:tw-block tw-text-offblack hover:tw-text-brand-primary tw-leading-[15px] tw-tracking-[0.05em] tw-whitespace-nowrap tw-transition-colors tw-no-underline tw-uppercase"
  >
    {{ block.settings.link_text }}
  </a>
  <!-- Mobile Link -->
  <a
    href="{{ block.settings.link_url }}"
    class="tw-relative tw-flex tw-w-full tw-items-center tw-justify-between tw-gap-2 tw-border-0 tw-border-b tw-border-brand-grey tw-border-solid tw-bg-white tw-px-4 tw-py-4 tw-text-start tw-font-brand-body !tw-text-14 tw-font-semibold tw-uppercase tw-text-offblack tw-no-underline"
    :class="selectedTab ? 'tw-hidden' : 'md:tw-hidden'"
  >
    {{ block.settings.link_text }}
  </a>
</div>

{% schema %}
{
  "name": "Nav Direct Link",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ]
}
{% endschema %}
