<style>
  .video-block-{{ block.id }} {
    border-width: {{ block.settings.border }}px;
    border-style: solid;
    border-color: {{ block.settings.border_color }};
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
  }

  .video-block-media-{{ block.id }} {
    object-position: {{ block.settings.object_position }};
  }

  @media screen and (max-width: 749px) {
    .video-block-{{ block.id }} {
      max-width: {{ block.settings.mobile_max_width }}px;
    }

    .video-block-media-{{ block.id }} {
      object-position: {{ block.settings.mobile_object_position }};
    }
  }
</style>

{% assign allow_attributes = '' %}
{% if block.settings.autoplay %}
  {% assign allow_attributes = allow_attributes | append: 'autoplay; ' %}
{% endif %}
{% if block.settings.controls %}
  {% assign allow_attributes = allow_attributes | append: 'encrypted-media; ' %}
{% endif %}
{% if block.settings.loop %}
  {% assign allow_attributes = allow_attributes | append: 'loop; ' %}
{% endif %}
{% if block.settings.muted %}
  {% assign allow_attributes = allow_attributes | append: 'mute; ' %}
{% endif %}
{% assign allow_attributes = allow_attributes | append: 'accelerometer; clipboard-write; gyroscope; picture-in-picture; web-share' %}

<div class="
    video-block-{{ block.id }}
    tw-relative
    tw-overflow-hidden
    tw-mx-auto
    {% if block.settings.aspect_ratio == 'square' %}
      md:tw-aspect-square
    {% elsif block.settings.aspect_ratio == 'video' %}
      md:tw-aspect-video
    {% elsif block.settings.aspect_ratio == '4/3' %}
      md:tw-aspect-4/3
    {% elsif block.settings.aspect_ratio == '5/4' %}
      md:tw-aspect-5/4
    {% elsif block.settings.aspect_ratio == '6/5' %}
      md:tw-aspect-6/5
    {% elsif block.settings.aspect_ratio == '7/6' %}
      md:tw-aspect-7/6
    {% elsif block.settings.aspect_ratio == '10/9' %}
      md:tw-aspect-10/9
    {% elsif block.settings.aspect_ratio == '9/10' %}
      md:tw-aspect-9/10
    {% elsif block.settings.aspect_ratio == '6/7' %}
      md:tw-aspect-6/7
    {% elsif block.settings.aspect_ratio == '5/6' %}
      md:tw-aspect-5/6
    {% elsif block.settings.aspect_ratio == '4/5' %}
      md:tw-aspect-4/5
    {% elsif block.settings.aspect_ratio == '3/2' %}
      md:tw-aspect-3/2
    {% elsif block.settings.aspect_ratio == '2/3' %}
      md:tw-aspect-2/3
    {% elsif block.settings.aspect_ratio == '3/4' %}
      md:tw-aspect-3/4
    {% elsif block.settings.aspect_ratio == '3/8' %}
      md:tw-aspect-3/8
    {% elsif block.settings.aspect_ratio == '9/16' %}
      md:tw-aspect-9/16
    {% elsif block.settings.aspect_ratio == '8/3' %}
      md:tw-aspect-8/3
    {% endif %}

    {% if block.settings.mobile_aspect_ratio == 'square' %}
      tw-aspect-square
    {% elsif block.settings.mobile_aspect_ratio == 'video' %}
      tw-aspect-video
    {% elsif block.settings.mobile_aspect_ratio == '4/3' %}
      tw-aspect-4/3
    {% elsif block.settings.mobile_aspect_ratio == '5/4' %}
      tw-aspect-5/4
    {% elsif block.settings.mobile_aspect_ratio == '6/5' %}
      tw-aspect-6/5
    {% elsif block.settings.mobile_aspect_ratio == '7/6' %}
      tw-aspect-7/6
    {% elsif block.settings.mobile_aspect_ratio == '10/9' %}
      tw-aspect-10/9
    {% elsif block.settings.mobile_aspect_ratio == '9/10' %}
      tw-aspect-9/10
    {% elsif block.settings.mobile_aspect_ratio == '6/7' %}
      tw-aspect-6/7
    {% elsif block.settings.mobile_aspect_ratio == '5/6' %}
      tw-aspect-5/6
    {% elsif block.settings.mobile_aspect_ratio == '4/5' %}
      tw-aspect-4/5
    {% elsif block.settings.mobile_aspect_ratio == '3/2' %}
      tw-aspect-3/2
    {% elsif block.settings.mobile_aspect_ratio == '2/3' %}
      tw-aspect-2/3
    {% elsif block.settings.mobile_aspect_ratio == '3/4' %}
      tw-aspect-3/4
    {% elsif block.settings.mobile_aspect_ratio == '3/8' %}
      tw-aspect-3/8
    {% elsif block.settings.mobile_aspect_ratio == '9/16' %}
      tw-aspect-9/16
    {% elsif block.settings.mobile_aspect_ratio == '8/3' %}
      tw-aspect-8/3
    {% endif %}

    {% if block.settings.rounded == 'full' %}
      tw-rounded-full
    {% elsif block.settings.rounded == 'sm' %}
      tw-rounded-md
    {% elsif block.settings.rounded == 'md' %}
      tw-rounded-xl
    {% elsif block.settings.rounded == 'lg' %}
      tw-rounded-3xl
    {% else %}
      tw-rounded-none
    {% endif %}
  ">
  {% assign media_class = 'video-block-media-' | append: block.id | append: ' tw-h-full tw-w-full tw-object-cover' %}
  {% if block.settings.video_source == 'url' and block.settings.video_url != blank %}
    <iframe
      src="{{ block.settings.video_url }}"
      title="{{ block.settings.video_title | default: 'Video player' | escape }}"
      frameborder="0"
      allow="{{ allow_attributes }}"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      class="tw-absolute tw-inset-0 tw-h-full tw-w-full tw-object-cover"></iframe>
  {% elsif block.settings.video_source == 'shopify_file' and block.settings.shopify_video != blank %}

    {{ block.settings.shopify_video | video_tag: image_size: '2000x', class: media_class, autoplay: block.settings.autoplay, loop: block.settings.loop, muted: block.settings.muted, controls: block.settings.controls }}
  {% elsif block.settings.fallback_image != blank %}
    {{ block.settings.fallback_image | image_url: width: 2000 | image_tag: class: media_class, loading: 'lazy', alt: block.settings.fallback_alt }}
  {% else %}
    <div class="tw-flex tw-h-full tw-w-full tw-items-center tw-justify-center tw-bg-offblack tw-text-white">
      {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-max-w-96 tw-aspect-square tw-h-full tw-object-contain tw-fill-white' }}
    </div>
  {% endif %}
</div>

