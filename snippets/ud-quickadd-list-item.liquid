{% assign product_id = section.id | append: '-' | append: product.handle | append: '-list-atc' %}
{% assign product_atc_id = product_id | append: '-atc' %}
{% assign isbn = product.metafields.facts.isbn | default: product.metafields.custom.isbn %}
{% assign is_sale_badge = false %}
{% if product.tags contains 'SALE' or product.tags contains 'Sale' or product.tags contains 'sale' %}
  {% assign is_sale_badge = true %}
{% elsif settings.flash_sale %}
  {% for flash_sale_product in settings.flash_sale_products %}
    {% if flash_sale_product.id == product.id %}
      {% assign is_sale_badge = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign product_author = product.metafields.custom.author.value | strip %}
{% assign product_author_lower = product_author | downcase %}
{% if product_author_lower == 'not available' %}
  {% assign product_author = '' %}
{% endif %}

<div
  id="{{ product_id }}"
  class="{{ class }} tw-grid tw-grid-cols-[5.5rem_1fr] md:tw-grid-cols-[7.5rem_1fr] tw-items-start tw-border tw-mb-[-1px] tw-border-brand-grey tw-p-4 tw-gap-x-3 md:tw-gap-x-4 tw-gap-y-2 md:tw-gap-y-1 tw-w-full"
>
  <!-- Product Image -->
  <a
    href="{% if product.metafields.custom.alt_gallery_link != blank %}{{ product.metafields.custom.alt_gallery_link.value.url }}{% else %}{{ product.url | default: '/' }}{% endif %}"
    class="tw-col-start-1 tw-row-start-1 md:tw-row-span-3 tw-block tw-w-full"
  >
    <div class="tw-w-full tw-aspect-5/6 tw-object-cover tw-relative">
      {% if product.featured_image != blank %}
        {{
          product.featured_image
          | image_url: width: 200
          | image_tag: loading: 'lazy', class: 'tw-size-full tw-aspect-5/6 tw-object-cover'
        }}
      {% else %}
        <div class="tw-size-full">
          {% render 'placeholder-image', width: 400, class: 'tw-size-full tw-object-contain' %}
        </div>
      {% endif %}
      {% if is_sale_badge or product.tags contains 'New Product' %}
        <div class="tw-absolute tw-top-1 tw-left-1 tw-flex tw-flex-col tw-gap-1">
          {% if is_sale_badge %}
            <div class="tw-text-9 tw-px-2 tw-py-0.5 tw-bg-brand-sale tw-rounded-[4px] tw-text-white tw-font-semibold tw-uppercase tw-leading-none">
              SALE
            </div>
          {% endif %}
          {% if product.tags contains 'New Product' %}
            <div class="tw-text-9 tw-px-2 tw-py-0.5 tw-bg-brand-primary tw-rounded-[4px] tw-text-white tw-font-semibold tw-uppercase tw-leading-none">
              NEW
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </a>

  <!-- Top-right info block -->
  <div class="tw-col-start-2 tw-row-start-1 tw-min-w-0 tw-flex tw-flex-col tw-gap-1">
    <div class="tw-flex tw-w-full tw-flex-row tw-justify-between tw-items-start tw-gap-x-3 tw-gap-y-0.5">
      <a href="{{ product.url | default: '/' }}" class="tw-min-w-0 tw-flex-1">
        <h3 v-pre class="tw-font-semibold tw-text-brand-primary tw-text-14 tw-leading-tight tw-m-0 md:tw-truncate">
          {{ product.title | default: 'Product title' }}
        </h3>
      </a>
      {%- unless product.type == 'Greeting Card' -%}
        <div class="tw-hidden md:tw-block tw-text-gray-500 tw-text-14 tw-font-normal tw-whitespace-nowrap">
          List: <span class="tw-font-normal">{{ product.compare_at_price | default: product.price | money }}</span>
        </div>
      {%- endunless -%}
    </div>
    <div class="tw-flex tw-w-full tw-flex-wrap tw-justify-between tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
      {% if product_author != blank %}
        <div v-pre>
          <span class="tw-font-medium">by</span>
          <span class="tw-font-medium tw-capitalize">{{- product_author -}}</span>
        </div>
      {% else %}
        <div></div>
      {% endif %}
      <div class="tw-hidden md:tw-block tw-font-semibold">
        {% if customer %}Your{% endif %} Net Price: <span class="tw-font-semibold">{{ product.price | money }}</span>
      </div>
    </div>
    <div class="md:tw-hidden tw-flex tw-flex-col tw-gap-0.5 tw-text-14 tw-text-offblack">
      <div class="tw-flex tw-flex-wrap tw-gap-x-3 tw-gap-y-0.5">
        {% if isbn != blank %}
          <div v-pre><span class="tw-font-semibold">ISBN:</span> {{ isbn }}</div>
        {% endif %}
        {% if product.metafields.custom.tb_code != blank and customer and customer.tags contains 'Staff' %}
          <div v-pre><span class="tw-font-semibold">TB CODE:</span> {{ product.metafields.custom.tb_code }}</div>
        {% endif %}
      </div>
      <div>
        <span class="tw-font-semibold">QTY:</span> {{ product.selected_or_first_available_variant.inventory_quantity }}
      </div>
    </div>
  </div>

  <!-- Product Description Row -->
  <div v-pre class="tw-col-span-2 md:tw-col-span-1 md:tw-col-start-2 tw-text-14 tw-line-clamp-3 tw-text-gray-500">
    {{ product.description | strip_html | default: 'No description available.' }}
  </div>

  <!-- Prices (mobile) + Desktop Meta + Action Row -->
  <div class="tw-col-span-2 md:tw-col-span-1 md:tw-col-start-2 tw-flex tw-flex-col tw-gap-2">
    <div class="md:tw-hidden tw-flex tw-flex-wrap tw-items-baseline tw-gap-x-4 tw-gap-y-0.5 tw-text-14">
      {%- unless product.type == 'Greeting Card' -%}
        <div class="tw-text-offblack tw-font-normal tw-whitespace-nowrap">
          List: {{ product.compare_at_price | default: product.price | money }}
        </div>
      {%- endunless -%}
      <div class="tw-font-semibold tw-text-offblack">
        {% if customer %}Your{% endif %} Net Price: {{ product.price | money }}
      </div>
    </div>
    <div class="tw-flex tw-w-full max-md:tw-flex-col max-md:tw-items-stretch tw-justify-between md:tw-items-end tw-gap-x-3 tw-gap-y-2 md:tw-gap-y-0.5 tw-text-14">
      <!-- Desktop Product Details Section -->
      <div class="tw-hidden md:tw-flex tw-w-full tw-flex-wrap tw-text-gray-700 tw-font-semibold tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
        {% if isbn != blank %}
          <div v-pre>
            ISBN: <span class="tw-font-normal">{{ isbn }}</span>
          </div>
        {% endif %}
        {% if product.metafields.custom.tb_code != blank and customer and customer.tags contains 'Staff' %}
          <div v-pre>
            TB Code: <span class="tw-font-normal">{{ product.metafields.custom.tb_code }}</span>
          </div>
        {% endif %}
        <div>
          QTY:
          <span class="tw-font-normal">{{ product.selected_or_first_available_variant.inventory_quantity }}</span>
        </div>
      </div>
      <!-- Action Section -->
      <div class="tw-flex-shrink-0 max-md:tw-w-full">
        {% if customer == null %}
          <a
            href="{{ routes.account_login_url }}"
            class="tw-bg-brand-secondary tw-cursor-pointer tw-text-12 tw-text-offblack tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4 tw-py-2.5 tw-transition-all duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-brightness-95 tw-whitespace-nowrap tw-items-center tw-uppercase tw-no-underline max-md:tw-w-full"
          >
            Sign in to shop
          </a>
        {% elsif show_button_type != 'none' %}
          {% if show_button_type == 'quick-add' %}
            <div class="tw-flex max-md:tw-flex-wrap tw-items-center tw-gap-2 tw-h-full">
              <div class="tw-flex tw-items-center tw-gap-2">
                <label for="{{ product_id }}-qty" class="tw-text-14 tw-font-semibold">QTY:</label>
                <input
                  id="{{ product_id }}-qty"
                  type="number"
                  min="1"
                  placeholder="1"
                  v-model.number="quantity"
                  class="tw-w-16 tw-text-center tw-leading-none tw-py-1.5 tw-px-1 tw-border tw-border-brand-grey tw-rounded tw-text-14 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
                  :disabled="addingToCart"
                >
              </div>
              <button
                type="button"
                id="{{ product_atc_id }}"
                class="tw-bg-brand-secondary tw-cursor-pointer tw-pointer-events-auto tw-text-12 tw-text-offblack tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-6 tw-py-2.5 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center tw-uppercase max-md:tw-grow"
                @click="addToCart()"
                :disabled="addingToCart"
              >
                [[ addingToCart ? 'Adding...' : '{{ button_text | default: 'QUICK ADD' }}' ]]
              </button>
            </div>
          {% else %}
            <a
              href="{{ product.url }}"
              class="tw-bg-white tw-cursor-pointer tw-pointer-events-auto tw-text-11 tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-border-black tw-border tw-py-2 tw-px-10 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap"
            >
              <span>{{ button_text | default: 'View' }}</span>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  new Vue({
    el: '#{{ product_id }}',
    delimiters: ['[[', ']]'],
    mixins: [global],
    data() {
      return {
        addingToCart: false,
        productPrice: '{{ product.price }}',
        quantity: 1,
      };
    },
    methods: {
      addToCart() {
        this.addingToCart = true;
        let items = [
          {
            quantity: this.quantity,
            properties: {
              '_tags': {{ product.tags | json }},
              {%- if isbn != blank %}
              '_isbn': {{ isbn | append: '' | json }},
              {%- endif %}
            },
            id: {{ product.selected_or_first_available_variant.id }},
          },
        ];

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw data;
          return data;
        }).then((data) => {
          console.log(data);
          this.bus.$emit('showCart');
          this.bus.$emit('refreshCart');
          this.addingToCart = false;
          const recentItem = data.items?.[0];
          this.bus.$emit('cartItemAdded', recentItem);
          this.$forceUpdate();
        }).catch((error) => {
          console.log(error, 'caught error');
          Swal.fire({
            icon: 'error',
            text: error && error.description ? error.description : 'Unable to add item to cart.',
          });
          this.addingToCart = false;
        }).finally(() => {
          this.addingToCart = false;
        });
      },
    },
  });
</script>
