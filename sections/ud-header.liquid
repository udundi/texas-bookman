{% capture search_bar %}  
  <!-- Search Input Icon -->
  <div class="tw-absolute tw-left-4 tw-top-2">
    {% render 'icon-search' %}
  </div>
  <!-- Search Input -->
  <input
    type="text"
    v-model="search"
    class="searchInput tw-h-full tw-w-full tw-border tw-border-brand-grey tw-pl-10 tw-p-2 tw-font-montserrat tw-text-16"
    @input="startSearch()"
    placeholder="Search for anything..."
  >
  <!-- Clear Search Icon -->
  <button
    v-if="search"
    class="tw-absolute tw-right-0.5 tw-top-2.5 tw-z-[2] tw-flex tw-h-6 tw-cursor-pointer tw-items-center tw-justify-center tw-bg-white tw-p-2 tw-font-montserrat tw-text-16 tw-leading-none"
    @click="
      () => {
        search = ''
        showSearch = false
      }
    "
  >
    {% render 'icon-times' %}
  </button>
  <!-- Search Results -->
  <div
    v-cloak
    class="tw-absolute tw-left-1/2 tw-top-full tw-z-[95] tw-h-20 tw-mx-auto tw-w-full tw-max-w-screen-2xl -tw-translate-x-1/2 tw-bg-white tw-p-0 tw-shadow-md"
    {% comment %} {% render 'ud-search-v2' %} {% endcomment %}
    v-if="showSearch"
    @click.stop
  >
    {% render 'ud-search-v2' %}
  </div>
{% endcapture %}
{% capture region_dropdown %}  
  <button
    type="button"
    class="tw-flex tw-items-center tw-gap-1.5 tw-cursor-pointer"
    @click="showCountryDropdown = !showCountryDropdown"
    :aria-expanded="showCountryDropdown.toString()"
    aria-haspopup="listbox"
    aria-label="Change country. Current: {{ localization.country.name }}"
  >
    <img
      src="https://flagcdn.com/w40/{{ localization.country.iso_code | downcase }}.png"
      width="40"
      height="40"
      alt="{{ localization.country.name }}"
      class="tw-rounded-full tw-object-cover tw-object-left-top tw-h-5 tw-w-5 tw-flex-shrink-0"
      loading="eager"
    >
    <span class="tw-hidden lg:tw-inline tw-font-montserrat tw-text-14 tw-text-offblack tw-whitespace-nowrap">
      {{- localization.country.name -}}
    </span>
    <svg class="tw-w-3 tw-h-3 tw-flex-shrink-0 max-md:tw-hidden" viewBox="0 0 512 512" aria-hidden="true" fill="currentColor">
      <path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/>
    </svg>
  </button>
  <!-- Country Dropdown -->
  <div
    v-cloak
    v-if="showCountryDropdown"
    role="listbox"
    aria-label="Select country"
    class="tw-absolute md:tw-right-0 max-md:tw-left-0 tw-top-full tw-z-[20] tw-mt-1 tw-max-h-72 tw-overflow-y-auto tw-bg-white tw-border tw-border-brand-grey tw-shadow-lg tw-min-w-[210px]"
    @click.stop
  >
    {% form 'localization', id: 'CountryForm-{{ section.id }}' %}
      {% for country in localization.available_countries %}
        <button
          type="submit"
          name="country_code"
          value="{{ country.iso_code }}"
          role="option"
          {% if country.iso_code == localization.country.iso_code %}
            aria-selected="true"
          {% else %}
            aria-selected="false"
          {% endif %}
          class="tw-flex tw-w-full tw-items-center tw-gap-2.5 tw-px-4 tw-py-2.5 tw-text-left tw-font-montserrat tw-text-14 tw-transition-colors hover:tw-bg-gray-50{% if country.iso_code == localization.country.iso_code %} tw-font-semibold tw-bg-gray-50{% endif %}"
        >
          <img
            src="https://flagcdn.com/w40/{{ country.iso_code | downcase }}.png"
            width="20"
            height="20"
            alt=""
            aria-hidden="true"
            class="tw-rounded-full tw-object-cover tw-object-left-top tw-h-5 tw-w-5 tw-flex-shrink-0"
            loading="lazy"
          >
          <span>{{ country.name }}</span>
          <span class="tw-ml-auto tw-pl-2 tw-text-12 tw-text-gray-400">{{ country.currency.iso_code }}</span>
        </button>
      {% endfor %}
    {% endform %}
  </div>

  <!-- Backdrop to close dropdown -->
  <div
    v-if="showCountryDropdown"
    class="tw-fixed tw-inset-0 tw-z-[19]"
    @click="showCountryDropdown = false"
    aria-hidden="true"
  ></div>
{% endcapture %}

{% unless customer %}
  <div class="tw-w-full tw-bg-brand-secondary tw-h-10 tw-flex tw-justify-center tw-items-center">
    <div>
      You’re Not Logged In |
      <a class="tw-font-semibold tw-py-4 tw-underline" href="{{ routes.account_login_url }}">Sign In to Shop</a>
    </div>
  </div>
{% endunless %}
<div id="nav-bar-{{ section.id }}" class="tw-border-b tw-border-brand-grey">
  <div class="tw-relative tw-z-90 tw-mx-auto tw-flex tw-w-full tw-max-w-screen-2xl tw-items-center tw-justify-between tw-bg-white tw-px-4">
    <div class="md:tw-hidden tw-h-full tw-flex tw-gap-2">
      <!-- Mobile Menu Icon -->
      <button
        aria-haspopup="true"
        aria-label="Menu"
        @click="toggleMobileNav()"
        class="tw-block tw-justify-center tw-px-2 tw-align-middle md:tw-hidden"
      >
        <div :style="showMobile ? 'display: none;' : 'display: contents;'">
          {% render 'icon-bars' %}
        </div>
        <div :style="!showMobile ? 'display: none;' : 'display: contents;'">
          {% render 'icon-times' %}
        </div>
      </button>
      <!-- Mobile Region / Market Selector -->
      <div class="tw-relative tw-my-auto ">
        {{ region_dropdown }}
      </div>
    </div>
    <!-- Logo -->
    <div class="logo tw-flex tw-gap-4 md:tw-py-2">
      <a
        href="/"
        aria-label="Home"
        class="tw-h-16 md:tw-w-24 tw-w-full tw-max-w-40"
      >
        {% if section.settings.site_logo != blank %}
          {{
            section.settings.site_logo
            | image_url: width: 400
            | image_tag: alt: 'Site Logo', class: 'md:tw-block tw-hidden tw-h-16 tw-w-full tw-object-contain'
          }}
          {{
            section.settings.mobile_site_logo
            | image_url: width: 400
            | image_tag: alt: 'Site Logo', class: 'tw-block md:tw-hidden tw-h-16 tw-w-full tw-object-contain'
          }}
        {% endif %}
      </a>
    </div>
    <!-- Desktop Search Bar -->
    <div class="tw-w-full tw-max-w-2xl tw-relative md:tw-block tw-hidden">{{ search_bar }}</div>

    <div>
      {% comment %}
        <nav
          v-cloak
          @mouseleave="handleMouseLeave"
          role="navigation"
          aria-label="Main Menu"
          class="tw-h-full md:tw-h-12"
          :class="showMobile ? 'tw-block' : 'md:tw-flex tw-hidden'"
        >
          <!-- Nav Container -->
          <div
            class="tw-absolute tw-right-0 tw-top-[60px] tw-max-h-[600px] tw-min-w-[200px] tw-bg-white tw-p-0 max-md:tw-overflow-y-auto md:tw-static md:tw-z-auto md:tw-h-full"
            :class="showMobile ? 'tw-z-[900]' : ''"
          >
            <!-- Nav Container -->
            <div class="tw-flex tw-h-full tw-flex-col tw-text-12 max-md:tw-p-4 md:tw-flex-row md:tw-gap-2">
              {% for block in block.blocks %}
                {% render block %}
              {% endfor %}
            </div>
          </div>
        </nav>
      {% endcomment %}

      <div class="mobileDivider mobileShow"></div>

      <div class="tw-my-auto tw-flex tw-h-fit tw-items-end md:tw-gap-4 tw-gap-2 tw-pl-2 lg:tw-gap-6" role="search">
        <!-- Desktop Region / Market Selector -->
        <div class="tw-relative tw-my-auto max-md:tw-hidden">
          {{ region_dropdown }}
        </div>

        <!-- Account Icon -->
        {% if customer.id == null -%}
          <a
            class="tw-my-auto tw-w-6"
            aria-label="Log In"
            href="{{ routes.account_login_url }}"
          >
            {% render 'icon-account' %}
          </a>
        {% else %}
          <a
            class="tw-my-auto tw-w-6"
            aria-label="Log Out"
            href="{{ routes.account_url }}"
          >
            {% render 'icon-account' %}
          </a>
        {%- endif %}

        <!-- Cart Icon -->
        <a
          class="tw-w-6"
          href="{{ routes.cart_url }}"
          aria-haspopup="true"
          class="tw-mb-4"
          aria-label="Cart"
          tabindex="0"
        >
          {% render 'icon-cart' %}
          <div
            v-cloak
            class="tw-absolute tw-flex tw-items-center tw-justify-center tw-rounded-full tw-bg-offblack tw-text-center tw-text-12 tw-font-bold tw-text-white"
            :class="[totalCartItems > 9 ? 'tw-w-6 tw-h-6 md:tw-top-3 tw-top-1.5 md:tw-right-0 tw-right-0.5' : ' tw-w-5 tw-h-5 md:tw-top-4 tw-top-2 tw-right-1']"
            v-if="totalCartItems"
          >
            [[totalCartItems]]
          </div>
        </a>
      </div>
      {% comment %}
        <div
          v-cloak
          v-if="showSearch"
          class="tw-fixed tw-inset-0 tw-z-[14] tw-h-screen tw-bg-black tw-bg-opacity-50"
          @click="showSearch = false"
        ></div>
      {% endcomment %}
    </div>
  </div>
  <!-- Desktop Search Bar -->
  <div class="tw-w-full tw-max-w-2xl tw-relative tw-block md:tw-hidden tw-px-2 tw-pb-2">{{ search_bar }}</div>
</div>
<script>
  new Vue({
    el: '#nav-bar-{{ section.id }}',
    delimiters: ['[[', ']]'],
    mixins: [],
    data() {
      return {
        selectedTab: '',
        selectedSubTab: '',
        showMobile: false,
        showMobileMenu: false,
        showSearch: null,
        search: null,
        searching: false,
        searchingDesigns: false,
        searchResults: [],
        searchObject: {
          collections: [],
          pages: [],
          products: [],
          articles: [],
          queries: [],
        },
        totalSearchResults: 0,
        searchTimeout: null,
        mobileDropdown: null,
        accountPopup: false,
        searchCategory: null,
        hideSearchResults: false,
        totalCartItems: 0,
        mobileSection: null,
        mobileSubSection: null,
        hoverTimer: null,
        showSuggestions: true,
        showCountryDropdown: false,
        openMenuSection: null,
      };
    },

    async mounted() {
      const vw = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
      const vh = Math.max(document.documentElement.clientHeight || 0, window.innerHeight || 0);

      if (vw < 900) {
        this.hideSearchResults = true;
      }
      setTimeout(() => {
        const el = document.getElementById('nav-bar-{{ section.id }}');
        this.sectionHeight = el ? el.offsetHeight : 0;
        const spacer = document.getElementById('header-spacer-{{ section.id }}');
        if (spacer) {
          spacer.style.height = `${this.sectionHeight}px`;
        }
        document.documentElement.style.setProperty('--site-header-height', `${this.sectionHeight}px`);
      }, 10);
      window.addEventListener('resize', this.resizeSpacer);
      this.refreshCart();

      this.bus.$on('refreshCart', () => {
        this.refreshCart();
      });
      this.bus.$on('mobileNavToggle', (isOpen) => {
        this.showMobile = isOpen;
      });
    },
    unmounted() {
      window.removeEventListener('resize', this.resizeSpacer);
    },

    watch: {
      showMobileMenu() {
        this.$nextTick(() => {
          // a/b test specific logic
          const currentVariant = document.documentElement.dataset.testVariant || 'a';
          if (this.showMobileMenu) {
            this.$refs.mobileNavMenu?.querySelector(`[data-test-show='${currentVariant}'] :is(a, button)`)?.focus();
          }
        });
      },
    },

    methods: {
      handleMouseLeave() {
        this.showMobile = false;
        this.selectedTab = '';
        this.selectedSubTab = '';
      },

      // Keeps this header's hamburger in sync with the separate nav-bar section's own mobile menu state
      toggleMobileNav() {
        this.showMobile = !this.showMobile;
        this.bus.$emit('mobileNavToggle', this.showMobile);
      },

      resizeSpacer(e) {
        const el = document.getElementById('nav-bar-{{ section.id }}');
        this.sectionHeight = el ? el.offsetHeight : 0;
        const spacer = document.getElementById('header-spacer-{{ section.id }}');
        const navContainer = document.getElementById('nav-container');
        if (spacer) {
          spacer.style.height = `${this.sectionHeight}px`;
        }
        if (navContainer) {
          navContainer.style.height = `${this.sectionHeight}px`;
        }
        document.documentElement.style.setProperty('--site-header-height', `${this.sectionHeight}px`);
      },

      refocusMenu(event) {
        this.$refs.mobileMenuButton.focus();
        console.log(event, 'refocusing menu');
      },

      hoverSubTab(subTabClass) {
        clearTimeout(this.hoverTimer);
        this.hoverTimer = setTimeout(() => {
          this.selectedSubTab = subTabClass;
        }, 150);
      },

      clearHover() {
        console.log('clearing timer');
        clearTimeout(this.hoverTimer);
      },

      refreshCart() {
        const EXCLUDE_TITLES = [
          'Adhesive Tab',
          'Mini Adhesive Tab',
          'Commercial Adhesive Tab',
          'Freight Shipping',
          'Drywall Screws',
        ];
        fetch('/cart.js')
          .then((r) => r.json())
          .then((data) => {
            let total = 0;
            for (const item of data.items) {
              if (!EXCLUDE_TITLES.includes(item.title) && !item.title.includes('Permanent Adhesive Tape Strips')) {
                total += item.quantity || 0;
              }
            }
            this.totalCartItems = total;
            this.$forceUpdate();
          });
      },

      searchFilter(filter) {
        if (this.searchCategory != filter) this.searchCategory = filter;
        else {
          this.searchCategory = null;
        }
        this.startSearch();
      },

      openSearch() {
        this.showSearch = true;
        this.startSearch();
        setTimeout(() => {
          const searchInput = document.querySelector('.searchInput');
          if (searchInput) {
            searchInput.focus();
          }
        }, 100);
      },

      isDesktop() {
        return window.innerWidth > 1130;
      },

      showCart() {
        this.bus.$emit('showCart');
      },

      toggleMenuSection(sectionId) {
        this.openMenuSection = this.openMenuSection === sectionId ? null : sectionId;
      },

      async startSearch() {
        // Clear Debounce if it exists
        this.showSearch = true;
        this.searchingDesigns = true;
        try {
          clearTimeout(this.searchTimeout);
        } catch (error) {}

        this.searchTimeout = setTimeout(() => {
          let searchQuery;

          fetch(`/search/suggest.json?q={${this.search}}&resources[type]=page,collection,article,query,`)
            .then((r) => r.json())
            .then(async (data) => {
              this.searchObject.pages = data.resources.results.pages;
              this.searchObject.collections = data.resources.results.collections;
              this.searchObject.articles = data.resources.results.articles || [];
              this.searchObject.queries = data.resources.results.queries;
              this.searchingDesigns = false;
              this.$forceUpdate();
            });

          fetch(`/search/suggest.json?q={${this.search}}&resources[type]=product`)
            .then((r) => r.json())
            .then(async (data) => {
              // Filter products to only include vendor "felt right"
              this.searchObject.products = data.resources.results.products;
              this.searchingDesigns = false;
              this.$forceUpdate();
            });
        }, 100);
      },

      searchQueryClicked(query) {
        this.search = query;
        this.showSuggestions = false;
        this.startSearch();
        // Optional: focus back on input after selecting
        setTimeout(() => {
          const searchInput = document.querySelector('.searchInput');
          if (searchInput) {
            searchInput.focus();
          }
        }, 100);
      },
    },
  });
</script>

<style>
  /* Prevent flash of uninitialized Vue content */
  [v-cloak] {
    display: none !important;
    visibility: hidden !important;
  }
  {% assign spacing =  block.blocks | size | times: 42 | plus: 48 %}
  .ud-mobileMenuV2 {
    top: 48px;
    height: calc(100vh - {{ spacing }}px);
    z-index: 1000;
  }

  .mobileMenuBG {
    top: {{ spacing }}
    px !important;
    z-index: -1000;
  }

  .ud-mobileMenuV2::backdrop {
    height: 100%;
    margin: 0;
    background: rgba(0, 0, 0, 0.5);
    width: 100%;
    padding: 0;
  }
</style>

{% comment %} We are no longer using Simple or Lists Blocks {% endcomment %}
{% schema %}
{
  "name": "Header Block",
  "blocks": [
    {
      "type": "_header-tabbed-section"
    },
    {
      "type": "_header-tabbed-1-row"
    }
  ],
  "settings": [
    {
      "type": "link_list",
      "id": "trending_searches",
      "label": "Trending Searches"
    },
    {
      "type": "text",
      "id": "featured_collection_title",
      "label": "Featured Collection Title"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "image_picker",
      "id": "site_logo",
      "label": "Site Logo"
    },
    {
      "type": "image_picker",
      "id": "mobile_site_logo",
      "label": "Mobile Site Logo"
    }
  ],
  "presets": [
    {
      "name": "Header Block",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
