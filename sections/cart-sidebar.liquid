<div class="cartSidebar-{{ section.id }} tw-relative tw-z-[901]">
  <div
    v-if="showCartSidebar"
    :class="fading ? 'tw-animate-fade-out' : 'tw-animate-fade-down'"
    class="tw-fixed tw-pointer-events-auto tw-z-[999] tw-top-4 tw-right-4 tw-left-4 md:tw-left-auto"
  >
    <div class="md:tw-w-[570px] tw-w-full tw-bg-brand-eggshell tw-rounded-[4px] tw-border tw-border-brand-grey tw-flex tw-flex-col">
      <!-- Recently Added Banner -->
      <div
        v-if="recentlyAddedItem"
        class="tw-mb-2 tw-flex tw-items-center tw-gap-3 tw-p-3 tw-text-sm"
      >
        <div
          :class="failed && !partial ? 'tw-bg-red-500 tw-rotate-45 tw-text-white' : 'tw-bg-amber-400 tw-text-offblack'"
          class="tw-p-2 tw-rounded-full"
        >
          {% render 'icon-plus' %}
        </div>
        <div class="tw-min-w-0 tw-flex-1">
          <p v-if="!failed" class="tw-text-16 tw-text-black">Added to cart</p>
          <p v-else-if="partial" class="tw-text-16 tw-text-black tw-font-semibold">Partially added to cart</p>
          <p v-else class="tw-text-16 tw-text-black tw-font-semibold">Unable to add to cart</p>
        </div>
        <button
          @click="hideCart"
          class="tw-shrink-0 tw-text-green-600 hover:tw-text-green-900"
        >
          {% render 'icon-times' %}
        </button>
      </div>

      <!-- Error message block -->
      <div v-if="failed" class="tw-px-4 tw-pb-6 tw-pt-2 tw-text-start">
        <p class="tw-text-brand-sale tw-font-semibold tw-text-14">[[ errorMessage ]]</p>
      </div>

      <div
        v-if="!failed"
        id="{{ product_id }}"
        class="{{ class }} tw-flex tw-flex-row tw-items-center tw-p-4 tw-gap-4 tw-w-full"
      >
        <!-- Product Image -->
        <div
          class="tw-flex-shrink-0"
        >
          <div class="tw-h-28 tw-object-cover tw-aspect-5/6 tw-relative">
            <img
              v-if="recentlyAddedItem.featured_image?.url"
              :src="recentlyAddedItem.featured_image.url"
              :alt="recentlyAddedItem.title"
              class="tw-size-full tw-aspect-5/6 tw-object-cover"
            >
          </div>
        </div>

        <!-- Product Info -->
        <div class="tw-py-1 tw-w-full tw-flex tw-flex-col tw-justify-between tw-gap-2 tw-min-w-0 tw-grow">
          <!-- Title and Product Details -->
          <div class="tw-flex tw-grow tw-flex-col tw-justify-between tw-gap-1">
            <div class="tw-flex tw-w-full tw-flex-row tw-justify-between tw-gap-x-3 tw-gap-y-0.5 tw-text-12">
              <a :href="recentlyAddedItem.url" class="">
                <h3 class="tw-font-semibold tw-text-13 tw-text-brand-primary tw-text-14 tw-leading-tight tw-m-0 tw-truncate">
                  [[ recentlyAddedItem.title ]]
                </h3>
              </a>
            </div>

            <!-- Product Details -->
            <div class="tw-flex tw-w-full tw-justify-between tw-items-end tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
              <!-- Product Details Section -->
              <div class="tw-flex tw-w-full tw-flex-col tw-text-gray-700 tw-font-semibold tw-gap-y-0.5 tw-text-14">
                <div
                  v-if="recentlyAddedItem.properties && recentlyAddedItem.properties._isbn"
                  class="tw-text-[#312F30] tw-text-opacity-80"
                >
                  ISBN:
                  <span class="tw-font-normal">[[ recentlyAddedItem.properties._isbn ]]</span>
                </div>
                <div>
                  QTY:
                  <span class="tw-font-normal"> [[ recentlyAddedItem.quantity ]] </span>
                </div>
                <div class="tw-font-semibold">[[ recentlyAddedItem.price / 100 | currency ]]</div>
                <div v-if="recentCaseLabel" class="tw-font-semibold tw-text-brand-sale">[[ recentCaseLabel ]]</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        v-if="!failed"
        class="tw-px-4 tw-pb-8"
      >
        <div class="tw-w-full tw-block">
          <div class="tw-bg-white tw-pt-4">
            <div
              :class="[disabledCart ? 'tw-cursor-wait' : '', disableCartActions ? 'tw-opacity-50 tw-pointer-events-none' : '']"
              class="tw-w-full"
            >
              <div
                :class="[disabledCart ? 'tw-pointer-events-none' : '', disableCartActions ? 'tw-pointer-events-none' : '']"
                class="tw-w-full tw-px-2 tw-flex tw-flex-row tw-gap-2"
              >
                <button
                  :class="disableCartActions ? 'tw-opacity-50 tw-pointer-events-none' : ''"
                  class="tw-block tw-p-2 tw-text-brand-primary tw-border tw-border-brand-primary tw-rounded-[4px] tw-text-16 tw-text-center tw-w-full tw-uppercase tw-bg-white"
                  @click="hideCart"
                >
                  Keep Shopping
                </button>
                <a
                  :class="disableCartActions ? 'tw-opacity-50 tw-pointer-events-none' : ''"
                  class="tw-block tw-p-2 tw-text-white tw-rounded-[4px] tw-text-16 tw-text-center tw-w-full tw-uppercase tw-bg-brand-primary"
                  href="{{ routes.cart_url }}"
                >
                  View Cart
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart Sidebar",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "Cart Sidebar"
    }
  ]
}
{% endschema %}

<script>
  new Vue({
    el: '.cartSidebar-{{ section.id }}',
    delimiters: ['[[', ']]'],
    mixins: [global, cart],

    data() {
      return {
        cartItems: {{ cart.items | json }},
        cartData: {{ cart | json  }},
        failed: false,
        partial: false,
        errorMessage: '',
        testVariant: '',
        recentlyAddedItem: null,
        recentCaseLabel: '',
        fading: false,
        fadingTimeout: null,
        hideCartTimeout: null,
      };
    },
    mounted() {
      //For If On Cart Page don't run parse Cart twice
      {% unless canonical_url contains routes.cart_url %}
        this.parseCart();
      {% endunless %}

      //Track recently added item
      this.bus.$on("cartItemAdded", (item) => {
        clearTimeout(this.fadingTimeout);
        clearTimeout(this.hideCartTimeout);
        this.failed = false;
        this.partial = false;
        this.errorMessage = '';
        this.fading = false;
        this.recentlyAddedItem = item;
        this.recentCaseLabel = '';
        this.loadCaseLabel(item);
        this.showCartSidebar = true;
        this.fadingTimeout = setTimeout(() => { this.fading = true }, 3500);
        this.hideCartTimeout = setTimeout(() => { this.recentlyAddedItem = null; this.showCartSidebar = false; this.fading = false; }, 4000);
      });

      this.bus.$on("cartFailedToAdd", (error) => {
        clearTimeout(this.fadingTimeout);
        clearTimeout(this.hideCartTimeout);
        this.failed = true;
        this.errorMessage = error?.description || error?.message || error?.error || 'This item could not be added to your cart.';
        // Shopify's 422 for over-stock ("Only N items were added to your cart due to availability.") still adds the N
        this.partial = /added to your cart/i.test(this.errorMessage);
        if (this.partial) this.bus.$emit('refreshCart');
        this.fading = false;
        this.recentlyAddedItem = {};
        this.showCartSidebar = true;
        this.fadingTimeout = setTimeout(() => { this.fading = true }, 3500);
        this.hideCartTimeout = setTimeout(() => { this.recentlyAddedItem = null; this.showCartSidebar = false; this.fading = false; }, 4000);
      });
    },
    methods: {
      // Case lines get their pack size and saving (templates/product.case-info.liquid)
      loadCaseLabel(item) {
        const isCase = item && (item.options_with_values || []).some((option) => option.value === 'Case');
        if (!isCase || !item.handle) return;
        fetch(`${window.Shopify.routes.root}products/${item.handle}?view=case-info`)
          .then((r) => r.json())
          .then((info) => {
            // Skip if another item was added meanwhile (compare keys: data is a reactive proxy)
            if (!this.recentlyAddedItem || this.recentlyAddedItem.key !== item.key) return;
            this.recentCaseLabel = this.caseSavingLabel(info, item.original_price ?? item.price, (cents) => `$${(cents / 100).toFixed(2)}`);
          })
          .catch(() => {});
      },
      hideCart() {
        clearTimeout(this.fadingTimeout);
        clearTimeout(this.hideCartTimeout);
        this.fadingTimeout = null;
        this.fading = true;
        this.hideCartTimeout = setTimeout(() => { this.recentlyAddedItem = null; this.showCartSidebar = false; this.fading = false; }, 500);
      },
    }
  });
</script>
