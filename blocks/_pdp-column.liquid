<div
  id="inner-{{ block.id }}"
  class=" tw-flex-col tw-flex-grow {% if block.settings.desktop == '33%' %} md:tw-w-1/3 {% elsif block.settings.desktop == '50%' %} md:tw-w-1/2 {% elsif block.settings.desktop == '66%' %} md:tw-w-2/3 {% else %}tw-w-full{% endif %} tw-gap-2 {% if block.settings.visibility contains 'mobile' %} tw-flex md:tw-hidden {% elsif block.settings.visibility contains "desktop" %} tw-hidden md:tw-flex {% else %} tw-flex {% endif %} md:tw-sticky md:tw-z-[1] md:tw-h-fit md:tw-self-start tw-w-full"
>
  <style>
    @media (min-width: 768px) {
      #inner-{{ block.id }} {
        top: var(--site-header-height, 7rem);
      }
    }
  </style>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Main Details Column",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "desktop",
      "label": "Column Size on Desktop",
      "options": [
        {
          "value": "33%",
          "label": "1 / 3 of Screen"
        },
        {
          "value": "50%",
          "label": "1 / 2 of Screen"
        },
        {
          "value": "66%",
          "label": "2 / 3 of Screen"
        }
      ],
      "default": "33%"
    }
  ],
  "blocks": [
    {
      "type": "_pdp-checkout-buttons"
    },
    {
      "type": "_pdp-description"
    },
    {
      "type": "_pdp-price"
    },
    {
      "type": "_pdp-quantity"
    },
    {
      "type": "_pdp-related-products"
    },
    {
      "type": "_pdp-title-rating"
    },
    {
      "type": "_pdp-image-gallery"
    },
    {
      "type": "_pdp-variants"
    },
    {
      "type": "_pdp-description-drawers"
    },
    {
      "type": "_pdp-value-options"
    },
    {
      "type": "_pdp-info"
    }
  ],
  "presets": [
    {
      "name": "Main Details Column",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
