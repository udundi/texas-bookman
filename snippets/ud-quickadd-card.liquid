{% assign product_id = section.id | append: '-' | append: cur_product.handle %}
{% assign product_atc_id = product_id | append: '-atc' %}
{% assign min_qty = cur_product.selected_or_first_available_variant.quantity_rule.min | default: 1 %}
{% assign qty_step = cur_product.selected_or_first_available_variant.quantity_rule.increment | default: 1 %}
{%- liquid
  # Cap at stock only when Shopify refuses to oversell, and at the B2B rule max
  assign qty_variant = cur_product.selected_or_first_available_variant
  assign qty_max = null
  if qty_variant.inventory_management == 'shopify' and qty_variant.inventory_policy == 'deny'
    assign qty_max = qty_variant.inventory_quantity | at_least: 1
  endif
  if qty_variant.quantity_rule.max
    if qty_max == null or qty_variant.quantity_rule.max < qty_max
      assign qty_max = qty_variant.quantity_rule.max
    endif
  endif
  assign qty_max = qty_max | default: 'Infinity'
  capture stock_info
    render 'stock-state', product: cur_product
  endcapture
  assign stock_info = stock_info | split: ' '
  assign stock_state = stock_info[0]
  assign stock_qty = stock_info[1]
-%}
{% assign isbn = cur_product.metafields.facts.isbn | default: cur_product.metafields.custom.isbn %}

<div
  id="{{ product_id }}"
  class="{{ class }} tw-justify-between tw-flex tw-flex-col tw-p-4 {%  unless no_border %}tw-border tw-border-brand-grey tw-mr-[-1px] tw-mb-[-1px]{% endunless %}"
>
  <a href="{{ cur_product.url | default: '/' }}">
    <div class=" tw-aspect-3/4 tw-h-96 tw-object-cover md:tw-mb-3 tw-mb-2 tw-relative">
      {% if cur_product.featured_image != blank %}
        {% if small_image == true %}
          {{
            cur_product.featured_image
            | image_url: width: 400
            | image_tag: loading: 'lazy', class: ' tw-object-cover tw-h-96 tw-aspect-3/4'
          }}
        {% else %}
          {{
            cur_product.featured_image
            | image_url: width: 800
            | image_tag: loading: 'lazy', class: 'tw-size-full tw-object-cover tw-aspect-3/4'
          }}
        {% endif %}
      {% else %}
        <div class=" tw-size-full">
          {{
            settings.placeholder_image
            | image_url: width: 400
            | image_tag: 'tw-w-full tw-max-w-[450px] tw-mx-auto tw-object-cover'
          }}
        </div>
      {% endif %}
      {% if cur_product.tags contains 'New Product' %}
        <div class="tw-absolute tw-top-2.5 tw-right-2 tw-text-12 tw-px-4 tw-py-1 tw-bg-black tw-rounded-[4px] tw-text-white tw-font-semibold">
          New
        </div>
      {% endif %}
    </div>
  </a>
  <div class="tw-flex tw-flex-col tw-justify-between tw-h-full tw-w-full tw-gap-x-4 tw-gap-y-3 tw-items-start">
    <div class="tw-w-full">
      <!-- Title Container -->
      <div class="tw-flex tw-gap-x-4 tw-gap-y-1 tw-pb-2 tw-items-center tw-flex-wrap tw-w-full tw-justify-between">
        <!-- Title -->
        <div class="tw-flex tw-w-full tw-flex-row tw-gap-2 tw-items-start tw-justify-between">
          <a class="tw-w-full tw-h-fit tw-max-w-96" href="{{ cur_product.url | default: "/" }}">
            <h3 class="tw-font-semibold tw-text-14 tw-text-brand-primary tw-w-full tw-leading-tight tw-h-fit tw-m-0">
              {{ cur_product.title | default: 'Product title' }}
            </h3>
          </a>
        </div>
        <!-- TB Code (staff only) -->
        {% if cur_product.metafields.custom.tb_code != blank and customer and customer.tags contains 'Staff' %}
          <h3 class="tw-font-semibold tw-text-14 tw-text-brand-greyer/50 tw-w-full tw-leading-tight tw-h-fit tw-m-0">
            TB Code: {{ cur_product.metafields.custom.tb_code }}
          </h3>
        {% endif %}
        <!-- ISBN -->
        {% if isbn != blank %}
          <h3 class="tw-font-semibold tw-text-14 tw-text-brand-greyer/50 tw-w-full tw-leading-tight tw-h-fit tw-m-0">
            ISBN: {{ isbn }}
          </h3>
        {% endif %}
        <h3 class="tw-font-semibold tw-text-14 tw-text-brand-greyer tw-w-full tw-leading-tight tw-h-fit tw-m-0">
          QTY:
          <span class="tw-font-normal">{{ stock_qty }}</span>
        </h3>
        {% render 'stock-label', state: stock_state %}
        <div class="tw-flex tw-flex-col">
          {%- unless cur_product.type == 'Greeting Card' -%}
            <div class="tw-text-brand-greyer tw-text-14 tw-font-semibold">
              List:
              <span class="tw-font-normal">
                {{- cur_product.compare_at_price | default: cur_product.price | money -}}
              </span>
            </div>
          {%- endunless -%}
          <div class="tw-font-semibold tw-text-14 tw-text-black">
            {% if customer %}Your{% endif %} Net Price:
            <span class="tw-font-normal">{{ cur_product.price | money }}</span>
          </div>
        </div>
      </div>
    </div>

    {% if customer == null %}
      <a
        href="{{ routes.account_login_url }}"
        class="tw-bg-brand-primary tw-w-full tw-cursor-pointer tw-text-12 tw-text-white tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-py-2 tw-px-3 tw-transition-all duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-brightness-95 tw-whitespace-nowrap tw-items-center tw-uppercase tw-no-underline"
      >
        Sign in to shop
      </a>
    {% elsif show_button_type != 'none' %}
      {% if show_button_type == 'quick-add' and stock_state == 'out_of_stock' %}
        <button
          type="button"
          disabled
          class="tw-bg-brand-secondary tw-w-full tw-text-12 tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4 tw-py-2 tw-font-semibold tw-font-montserrat tw-whitespace-nowrap tw-items-center tw-opacity-50 tw-cursor-not-allowed"
        >
          Out of Stock
        </button>
      {% elsif show_button_type == 'quick-add' %}
        <div class="tw-flex tw-gap-2 tw-items-stretch tw-w-full tw-h-full">
          <div class="tw-flex tw-items-center tw-gap-2 tw-w-full tw-h-full tw-text-brand-greyer">
            <span class="tw-whitespace-nowrap"
              >QTY
              {%- if min_qty > 1 %}
                (Min {{ min_qty -}}
                {%- if qty_step > 1 %}, x{{ qty_step }}{% endif %})
              {%- elsif qty_step > 1 %}
                (x{{ qty_step }})
              {%- endif -%}
              :</span
            >
            <input
              type="number"
              min="{{ min_qty }}"
              step="{{ qty_step }}"
              {% if qty_max != 'Infinity' %}
                max="{{ qty_max }}"
              {% endif %}
              placeholder="{{ min_qty }}"
              v-model.number="quantity"
              @change="quantity = validQuantity(quantity, {{ min_qty }}, {{ qty_step }}, {{ qty_max }})"
              class="tw-w-full tw-text-center tw-leading-none tw-py-0.5 tw-border tw-border-brand-grey tw-rounded tw-h-full tw-text-12 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
              :disabled="addingToCart"
            >
          </div>
          <button
            type="button"
            id="{{ product_atc_id }}"
            class="tw-bg-brand-secondary tw-w-full tw-cursor-pointer tw-pointer-events-auto tw-text-12 tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-leading-none tw-px-4  tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center"
            @click="addToCart()"
            :disabled="addingToCart"
          >
            [[ addingToCart ? 'Adding...' : '{{ button_text | default: 'Add to Cart' }}' ]]
          </button>
        </div>
      {% else %}
        <a
          href="{{ cur_product.url }}"
          class="tw-bg-white tw-cursor-pointer tw-pointer-events-auto md:tw-text-12 tw-text-10 tw-text-black tw-rounded-[4px] tw-flex tw-justify-center tw-border-black tw-border-2 tw-py-1 tw-px-4 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-uppercase"
        >
          <span>{{ button_text | default: 'QUICK ADD' }}</span>
        </a>
      {% endif %}
    {% endif %}
  </div>
</div>

<script>
  new Vue({
    el: '#{{ product_id }}',
    delimiters: ['[[', ']]'],
    data() {
      return {
        addingToCart: false,
        productPrice: '{{ cur_product.price }}',
        quantity: {{ min_qty }},
      };
    },
    mounted() {
      console.log("Card Mounted")
    },
    methods: {
      addToCart() {
        this.addingToCart = true;
        this.quantity = this.validQuantity(this.quantity, {{ min_qty }}, {{ qty_step }}, {{ qty_max }});
        let items = [
          {
            quantity: this.quantity,
            'properties': {
              '_tags': {{ cur_product.tags | json }},
              {%- if isbn != blank %}
              '_isbn': {{ isbn | append: '' | json }},
              {%- endif %}
            },
            id: '{{ cur_product.selected_or_first_available_variant.id }}',
          },
        ];
        console.log(items);

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw data;
          return data;
        }).then((data) => {
          console.log(data);
          this.bus.$emit('showCart');
          this.bus.$emit('refreshCart');
          this.addingToCart = false;
          const recentItem = data.items?.[0];
          this.bus.$emit('cartItemAdded', recentItem);
          this.$forceUpdate();
        }).catch((error) => {
          console.log(error, 'caught error');
          Swal.fire({
            icon: 'error',
            text: error && error.description ? error.description : 'Unable to add item to cart.',
          });
          this.addingToCart = false;
        }).finally(() => {
          this.addingToCart = false;
        });
      },
    },
  });
</script>
