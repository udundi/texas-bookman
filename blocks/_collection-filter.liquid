{%- liquid
  assign filter_param = block.settings.filter_param | strip
  assign filter_value = block.settings.filter_value | strip
  assign link_text = block.settings.link_text | strip

  # Read existing theme-editor content saved before the block was simplified.
  if link_text == blank
    assign link_text = block.settings.title | strip
  endif
  if filter_value == blank
    assign filter_value = block.settings.tag | strip
  endif
  if filter_param == blank
    assign legacy_filter_type = block.settings.filter_type | strip
    if legacy_filter_type contains '='
      assign filter_param = legacy_filter_type | split: '=' | first | strip
      if filter_value == blank
        assign legacy_filter_value = legacy_filter_type | split: '=' | last | strip
        if legacy_filter_value != filter_param
          assign filter_value = legacy_filter_value
        endif
      endif
    elsif legacy_filter_type != blank
      assign filter_param = legacy_filter_type
    endif
  endif

  capture filter_state
    if filter_param != blank and filter_value != blank
      render 'collection-filter-state', param: filter_param, values: filter_value
    endif
  endcapture
  assign filter_state = filter_state | split: '@@'
  assign filter_active = false
  if filter_state[1] == 'true'
    assign filter_active = true
  endif
  assign filter_count = nil
  if filter_state[0] == 'value'
    assign filter_count = filter_state[2] | plus: 0
  endif
  assign filter_href = filter_state[3]
  if filter_href == blank and filter_param != blank and filter_value != blank and filter_active == false
    assign filter_values = filter_value | split: '|'
    assign filter_href = collection.url | default: routes.all_products_collection_url
    assign separator = '?'
    for filter_value_part in filter_values
      assign encoded_value = filter_value_part | strip | url_encode
      assign filter_href = filter_href | append: separator | append: filter_param | append: '=' | append: encoded_value
      assign separator = '&'
    endfor
  endif

  capture child_blocks
    content_for 'blocks'
  endcapture
  assign child_blocks = child_blocks | strip
  unless child_blocks contains 'data-filter-entry'
    assign child_blocks = ''
  endunless

  assign children_collapsed = block.settings.children_collapsed | default: true
  if filter_active or child_blocks contains 'data-filter-active'
    assign children_collapsed = false
  endif
-%}

<div
  class="tw-p-0.5"
  {% if filter_active %}
    data-filter-active
  {% endif %}
>
  <div class="tw-flex tw-w-full tw-flex-col">
    <div class="tw-flex tw-w-full tw-items-center tw-gap-1">
      {%
        render 'collection-filter-checkbox',
        href: filter_href,
        checked: filter_active,
        label: link_text | default: filter_value | default: 'Filter link',
        count: filter_count
      %}

      {%- unless child_blocks == blank -%}
        <button
          type="button"
          class="tw-size-3 tw-flex-shrink-0 tw-m-0 tw-cursor-pointer tw-border-0 tw-bg-transparent tw-p-0 tw-fill-offblack"
          aria-label="Show nested filters"
          @click="toggleFilter('{{ block.id }}', {{ children_collapsed }})"
        >
          <span class="tw-size-3 tw-fill-offblack" v-if="isFilterOpen('{{ block.id }}', {{ children_collapsed }})">
            {% render 'icon-arrow-up' %}
          </span>
          <span class="tw-size-3 tw-fill-offblack" v-else>
            {% render 'icon-arrow-down' %}
          </span>
        </button>
      {%- endunless -%}
    </div>

    {%- unless child_blocks == blank -%}
      <div
        class="tw-flex tw-flex-col tw-gap-[1px] tw-pl-4 tw-pt-1"
        v-show="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
      >
        {{ child_blocks }}
      </div>
    {%- endunless -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Filter",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Filter link"
    },
    {
      "type": "text",
      "id": "filter_param",
      "label": "Filter parameter",
      "placeholder": "filter.p.m.custom.category",
      "info": "Search & Discovery filter parameter, without an equals sign."
    },
    {
      "type": "text",
      "id": "filter_value",
      "label": "Filter value",
      "placeholder": "Art",
      "info": "Exact value to add when this link is selected. Separate multiple values with |."
    },
    {
      "type": "checkbox",
      "id": "children_collapsed",
      "label": "Nested filters collapsed",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "_collection-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Filter"
    }
  ]
}
{% endschema %}
