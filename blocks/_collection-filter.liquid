<div class="tw-p-0.5">
  {%- liquid
    # theme-check-disable
    capture content_for_query_string
      echo content_for_header
    endcapture
  -%}

  {% assign get_full_url = content_for_query_string
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | split: '.myshopify.com'
    | last
    | replace: '\/', '/'
    | replace: '%20', ' '
    | replace: '\u0026', '&'
    | replace: collection.url, ''
    | replace: 'feltright.com', ''
    | replace: '%2F', '/'
    | replace: '%27', "'"
  %}
  {% if block.settings.filter_type != 'color' %}
    {%- assign filter_change = block.settings.filter_type
      | append: block.settings.tag
      | replace: ' ', '+'
      | replace: '&', '%26'
    -%}
    {%- assign query_params = get_full_url
      | replace: 'pb=0', ''
      | replace: '_fd=0', ''
      | replace: '&&', '&'
      | replace: '?&', '?'
      | replace: '?', ''
      | split: '&'
    -%}

    {%- if get_full_url contains '?' -%}
      {%- if query_params contains filter_change -%}
        {%- assign new_params = '' -%}
        {%- for param in query_params -%}
          {%- if param == filter_change -%}{%- continue -%}{%- endif -%}
          {%- if new_params != blank -%}{%- assign new_params = new_params | append: '&' -%}{%- endif -%}
          {%- assign new_params = new_params | append: param -%}
        {%- endfor -%}
        {%- if new_params != blank -%}
          {%- assign filter_href = collection.url | append: '?' | append: new_params -%}
        {%- else -%}
          {%- assign filter_href = collection.url -%}
        {%- endif -%}
      {%- elsif filter_change contains 'filter.v.price' -%}
        {%- assign new_params = '' -%}
        {%- for param in query_params -%}
          {%- if param contains 'filter.v.price' -%}{%- continue -%}{%- endif -%}
          {%- if new_params != blank -%}{%- assign new_params = new_params | append: '&' -%}{%- endif -%}
          {%- assign new_params = new_params | append: param -%}
        {%- endfor -%}
        {%- if new_params != blank -%}
          {%- assign filter_href = collection.url
            | append: '?'
            | append: new_params
            | append: '&'
            | append: filter_change
          -%}
        {%- else -%}
          {%- assign filter_href = collection.url | append: '?' | append: filter_change -%}
        {%- endif -%}
      {%- else -%}
        {%- assign new_params = '' -%}
        {%- for param in query_params -%}
          {%- if param != blank -%}
            {%- if param contains 'filter.' and filter_change contains 'filter.p.tag' and param == filter_change -%}
              {%- continue -%}
            {%- endif -%}
            {%- if new_params != blank -%}{%- assign new_params = new_params | append: '&' -%}{%- endif -%}
            {%- assign new_params = new_params | append: param -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if new_params != blank -%}
          {%- assign filter_href = collection.url
            | append: '?'
            | append: new_params
            | append: '&'
            | append: filter_change
          -%}
        {%- else -%}
          {%- assign filter_href = collection.url | append: '?' | append: filter_change -%}
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {%- if block.settings.tag == 'all' -%}
        {%- assign filter_href = collection.url -%}
      {%- else -%}
        {%- assign filter_href = collection.url | append: '?' | append: filter_change -%}
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      assign filter_active = false
      if query_params contains filter_change
        assign filter_active = true
      endif
      assign filter_count = nil

      # When the store has this filter enabled (Search & Discovery), take the selected
      # state, URLs and result count from Shopify instead of the URL string. Selecting
      # several values of one filter ORs them.
      assign filter_param = block.settings.filter_type | remove_last: '='
      assign filter_found = false
      assign filter_value = nil
      for filter in collection.filters
        if filter.param_name == filter_param
          assign filter_found = true
          for value in filter.values
            if value.value == block.settings.tag
              assign filter_value = value
              break
            endif
          endfor
        endif
      endfor
      if filter_value
        assign filter_active = filter_value.active
        assign filter_count = filter_value.count
        if filter_active
          assign filter_href = filter_value.url_to_remove
        else
          assign filter_href = filter_value.url_to_add
        endif
      endif
    -%}

    {%- capture child_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}

    {%- liquid
      # Hide values with no results, unless already selected or they hold sub-filters.
      assign hide_filter = false
      if filter_found and child_blocks == blank
        if filter_value == nil
          assign hide_filter = true
        elsif filter_active == false and filter_count == 0
          assign hide_filter = true
        endif
      endif
    -%}

    {%- unless hide_filter -%}
    <div class="tw-flex tw-w-full tw-flex-col">
      <div class="tw-flex tw-w-full tw-items-center tw-gap-1">
        {% render 'collection-filter-checkbox',
          href: filter_href,
          checked: filter_active,
          label: block.settings.title,
          count: filter_count
        %}
        {%- unless child_blocks == blank -%}
          <button
            type="button"
            class="tw-flex-shrink-0 tw-fill-offblack tw-size-3 tw-cursor-pointer tw-bg-transparent tw-border-0 tw-p-0 tw-m-0"
            @click="toggleFilter('{{ block.id }}', {{ block.settings.children_collapsed | default: false }})"
          >
            <div
              class="tw-fill-offblack tw-size-3"
              v-if="isFilterOpen('{{ block.id }}', {{ block.settings.children_collapsed | default: false }})"
            >
              {% render 'icon-arrow-up' %}
            </div>
            <div v-else class="tw-fill-offblack tw-size-3">{% render 'icon-arrow-down' %}</div>
          </button>
        {%- endunless -%}
      </div>
      {%- unless child_blocks == blank -%}
        <div
          class="tw-pl-4 tw-pt-1 tw-flex tw-flex-col tw-gap-[1px]"
          v-show="isFilterOpen('{{ block.id }}', {{ block.settings.children_collapsed | default: false }})"
        >
          {{ child_blocks }}
        </div>
      {%- endunless -%}
    </div>
    {%- endunless -%}
  {% else %}
    <div class="tw-flex tw-flex-wrap tw-gap-2 tw-w-full ">
      {% for color in metaobjects.tile_colors.values %}
        {% assign color_index = forloop.index %}
        {% for ref in metaobjects.tile_colors.values %}
          {% if color_index == ref.position %}
            {% assign color_ref = ref %}
          {% endif %}
        {% endfor %}
        {% assign filter_change = 'filter.p.tag=' | append: color_ref.name | replace: ' ', '+' %}
        <a
          {% assign query_params = get_full_url
            | replace: 'pb=0', ''
            | replace: '_fd=0', ''
            | replace: '&&', '&'
            | replace: '?&', '?'
            | replace: '?', ''
            | split: '&'
          %}
          {% if get_full_url contains color_ref.name %}
            {% assign new_params = '' %}
            {% for param in query_params %}
              {% unless forloop.last and param == filter_change %}
                {% assign new_params = new_params | append: '&' %}
              {% endunless %}
              {% if param != filter_change %}
                {% assign new_params = new_params | append: param %}
              {% endif %}
            {% endfor %}
            {% if new_params != blank %}
              href="{{ collection.url |  append: '?' |  append: new_params | replace: '&&', '&' | replace: '?&', '?' }}"
            {% else %}
              href="{{ collection.url }}"
            {% endif %}
          {% else %}
            href="{{ collection.url }}{{ query_params |  join: '&' | prepend: '?' | append: '&' | append: filter_change | replace: '&&', '&' | replace: '?&', '?' }}"
          {% endif %}
          class="tw-group tw-h-fit tw-w-fit"
        >
          {% assign filter_border_check = 'filter.p.tag=' | append: color_ref.name %}
          <div
            class="
              tw-size-6 tw-border {% if color_ref.bordered %}tw-border-black/100{% else %}tw-border-black/0{% endif %}
              {% if get_full_url contains filter_border_check %} tw-ring-4 tw-ring-black {% endif %}  tw-rounded-full
            "
            style="background-color: {{ color_ref.color }};"
          ></div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection Filter",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Collection Tag"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Tag Title"
    },
    {
      "type": "text",
      "id": "filter_type",
      "label": "Filter Type",
      "default": "filter.p.tag="
    },
    {
      "type": "checkbox",
      "id": "children_collapsed",
      "label": "Children Collapsed",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "_collection-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Filter"
    }
  ]
}
{% endschema %}
