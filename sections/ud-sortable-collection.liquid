{%- liquid
  # theme-check-disable
  capture content_for_query_string
    echo content_for_header
  endcapture
-%}
{% assign get_full_url = content_for_query_string
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
  | replace: collection.url, ''
  | replace: 'feltright.com', ''
%}
{% comment %} {% assign get_full_url = content_for_query_string | split: '"pageurl":"' | last | split: '?' | last %} {% endcomment %}
{% assign query_params = get_full_url
  | replace: 'pb=0', ''
  | replace: '_fd=0', ''
  | replace: '&&', '&'
  | replace: '?&', '?'
  | replace: '?', ''
  | split: '&'
%}
{%- assign items_per_page = 20 -%}
{%- for param in query_params -%}
  {%- assign param_parts = param | split: '=' -%}
  {%- if param_parts[0] == 'limit' -%}
    {%- assign items_per_page = param_parts[1] | plus: 0 -%}
  {%- endif -%}
{%- endfor -%}
{%- if items_per_page == 0 -%}{%- assign items_per_page = 20 -%}{%- endif -%}
<style>
  select {
    /* for Firefox */
    -moz-appearance: none;
    /* for Chrome */
    -webkit-appearance: none;
    text-indent: 1px;
    text-overflow: '';
  }

  /* For IE10 */
  select::-ms-expand {
    display: none;
  }
</style>
<div v-cloak class="section-{{ section.id }}-props tw-border-gray-400 tw-border-b">
  <style>
    #filters-{{ block.id }} {
      height: 100%;
      background-color: {{ block.settings.background_color }};
      max-height: 100px;
      transition: max-height 0.25s ease
    }

    #filters-{{ block.id }}
    .collapsed {
      max-height: 0;
    }
  </style>
  <div class="tw-w-full tw-flex tw-justify-center tw-border-y tw-border-gray-400 tw-border-solid tw-p-2 tw-my-[-1px]">
    <div class="tw-flex tw-gap-2 tw-w-full tw-max-w-screen-2xl tw-justify-between tw-items-center">
      <!-- Title and description Container -->
      <div class=" tw-flex tw-flex-col tw-items-start tw-justify-start tw-gap-2 tw-text-center max-md:tw-px-4 md:tw-text-left">
        <!-- Title -->
        <h1 class="tw-m-0 tw-font-brand-primary tw-text-24 tw-font-semibold tw-capitalize tw-leading-normal tw-text-offblack">
          {{ collection.title }} ({{ collection.all_products_count }})
        </h1>
        <span class="tw-text-14">Home / {{ collection.title }}</span>
      </div>
      <div>
        <!-- Sort By Selector -->
        <div class="tw-flex tw-items-center tw-justify-start tw-gap-4 tw-p-4 md:tw-p-0">
          <!-- View Toggle Buttons -->
          <div class="tw-hidden md:tw-flex tw-items-center tw-gap-2">
            <button
              type="button"
              @click="toggleViewMode('grid')"
              :class="viewMode === 'grid' ? '  tw-border-gray-600' : '  tw-border-gray-400'"
              class="duration-200 tw-p-2 tw-size-10 tw-rounded tw-transition-colors tw-flex tw-text-black tw-items-center tw-justify-center tw-border tw-bg-white hover:tw-bg-gray-100"
              title="Grid View"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 19 19"
                fill="none"
                style="width: 20px; height: 20px;"
              >
                <path d="M7.46388 1.7561H2.48808C2.08396 1.7561 1.75635 2.08371 1.75635 2.48784V7.46364C1.75635 7.86776 2.08396 8.19537 2.48808 8.19537H7.46388C7.86801 8.19537 8.19562 7.86776 8.19562 7.46364V2.48784C8.19562 2.08371 7.86801 1.7561 7.46388 1.7561Z" stroke="currentColor" stroke-width="1.17078" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16.2446 1.7561H11.2688C10.8647 1.7561 10.5371 2.08371 10.5371 2.48784V7.46364C10.5371 7.86776 10.8647 8.19537 11.2688 8.19537H16.2446C16.6488 8.19537 16.9764 7.86776 16.9764 7.46364V2.48784C16.9764 2.08371 16.6488 1.7561 16.2446 1.7561Z" stroke="currentColor" stroke-width="1.17078" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7.46388 10.5371H2.48808C2.08396 10.5371 1.75635 10.8647 1.75635 11.2688V16.2446C1.75635 16.6488 2.08396 16.9764 2.48808 16.9764H7.46388C7.86801 16.9764 8.19562 16.6488 8.19562 16.2446V11.2688C8.19562 10.8647 7.86801 10.5371 7.46388 10.5371Z" stroke="currentColor" stroke-width="1.17078" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16.2446 10.5371H11.2688C10.8647 10.5371 10.5371 10.8647 10.5371 11.2688V16.2446C10.5371 16.6488 10.8647 16.9764 11.2688 16.9764H16.2446C16.6488 16.9764 16.9764 16.6488 16.9764 16.2446V11.2688C16.9764 10.8647 16.6488 10.5371 16.2446 10.5371Z" stroke="currentColor" stroke-width="1.17078" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              @click="toggleViewMode('list')"
              :class="viewMode === 'list' ? ' tw-border-gray-600' : ' tw-border-gray-400'"
              class="duration-200 tw-p-2 tw-size-10 tw-rounded tw-text-black tw-transition-colors tw-flex tw-items-center tw-justify-center tw-border tw-bg-white hover:tw-bg-gray-100"
              title="List View"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 27 27"
                fill="none"
                style="width: 20px; height: 20px;"
              >
                <path d="M19.5335 13.2323H10.7119M19.5335 18.2733H10.7119M19.5335 8.19141H10.7119" stroke="currentColor" stroke-width="1.26023" stroke-linecap="round" stroke-linejoin="round"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M6.92987 9.45161C7.55998 9.45161 8.1901 8.8215 8.1901 8.19138C8.1901 7.56127 7.55998 6.93115 6.92987 6.93115C6.29975 6.93115 5.6709 7.56127 5.6709 8.19138C5.6709 8.8215 6.29975 9.45161 6.92987 9.45161ZM6.92987 14.4925C7.55998 14.4925 8.1901 13.8624 8.1901 13.2323C8.1901 12.6022 7.55998 11.9721 6.92987 11.9721C6.29975 11.9721 5.6709 12.6022 5.6709 13.2323C5.6709 13.8624 6.29975 14.4925 6.92987 14.4925ZM6.92987 19.5335C7.55998 19.5335 8.1901 18.9033 8.1901 18.2732C8.1901 17.6431 7.55998 17.013 6.92987 17.013C6.29975 17.013 5.6709 17.6431 5.6709 18.2732C5.6709 18.9033 6.29975 19.5335 6.92987 19.5335Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
          <div class="tw-hidden tw-whitespace-nowrap tw-font-brand-primary tw-text-16 tw-font-semibold tw-text-offblack tw-leading-tight md:tw-block">
            Sort By:
          </div>
          <div class="tw-relative tw-hidden tw-w-full md:tw-flex tw-items-center">
            <div class="tw-absolute tw-right-3 tw-top-1/2 tw-size-3 -tw-translate-y-1/2">
              {% render 'icon-arrow-down' %}
            </div>
            <select
              aria-label="Sort By"
              class="tw-w-full tw-rounded-md tw-border tw-border-solid tw-border-gray-400 tw-p-2 tw-pr-8 tw-text-14"
              @change="sortByChange($event)"
            >
              <option
                {% unless get_full_url contains 'sort_by' %}
                  selected
                {% endunless %}
                value="manual"
              >
                Featured
              </option>
              <option
                {% if get_full_url contains 'best-selling' %}
                  selected
                {% endif %}
                value="best-selling"
              >
                Best Selling
              </option>
              <option
                {% if get_full_url contains 'created-descending' %}
                  selected
                {% endif %}
                value="created-descending"
              >
                New Arrivals
              </option>
              <option
                {% if get_full_url contains 'title-ascending' %}
                  selected
                {% endif %}
                value="title-ascending"
              >
                Alphabetically, A-Z
              </option>
              <option
                {% if get_full_url contains 'title-descending' %}
                  selected
                {% endif %}
                value="title-descending"
              >
                Alphabetically, Z-A
              </option>
              <option
                {% if get_full_url contains 'price-ascending' %}
                  selected
                {% endif %}
                value="price-ascending"
              >
                Price, low to high
              </option>
              <option
                {% if get_full_url contains 'price-descending' %}
                  selected
                {% endif %}
                value="price-descending"
              >
                Price, high to low
              </option>
            </select>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    id="sortable-collection"
    class="tw-flex tw-w-full tw-items-center tw-justify-center tw-max-w-screen-2xl tw-mx-auto "
  >
    <div class="tw-flex tw-w-full tw-flex-col md:tw-flex-row">
      <!-- Filter Container -->
      <div
        class="ud-filter-container tw-fixed tw-z-50 tw-w-full tw-flex-col tw-justify-start tw-px-2 tw-py-4 tw-top-0 md:tw-sticky md:tw-w-96 md:tw-gap-2 tw-border-r tw-border-gray-400 tw-mr-[-1px] tw-my-[-1px]"
        :class="mobileFiltersOpen ? 'tw-flex' : 'md:tw-flex tw-hidden'"
      >
        <div
          :class="mobileFiltersOpen ? 'tw-static tw-top-0 tw-left-0 tw-w-full ' : 'md:tw-flex tw-hidden'"
          class="tw-z-[500] tw-h-full tw-w-screen tw-overflow-y-auto tw-pb-8 md:tw-w-full  md:tw-px-4"
        >
          {% comment %}
            <div class="tw-w-full">
              <!-- Filter Header -->
              <div class="tw-flex tw-w-full tw-items-center tw-justify-between tw-p-4 md:tw-hidden md:tw-justify-center md:tw-p-2">
                <h3 class="tw-w-fit tw-text-black tw-text-center tw-text-24 tw-font-bold md:tw-w-full">Filter Designs</h3>
                <button @click="mobileFiltersOpen = false" class="">X</button>
              </div>
            </div>
          {% endcomment %}
          <div class="tw-flex tw-flex-col tw-w-full  tw-justify-start tw-gap-[2px] tw-bg-grey-medium">
            {% for block in section.blocks %}
              {% render block %}
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Right Side -->
      <div class="tw-flex tw-w-full tw-grow tw-flex-col tw-justify-start">
        <!-- Product Grid -->
        <div class="tw-flex tw-w-full tw-h-full tw-flex-col tw-justify-between">
          <div
            id="product-grid-{{ section.id }}"
            :class="viewMode === 'list' ? 'tw-flex tw-flex-col tw-w-full' : 'tw-mx-auto tw-grid tw-max-w-7xl tw-grid-cols-1 max-md:tw-px-4 tw-gap-[-1px] md:tw-grid-cols-2 lg:tw-grid-cols-3 xl:tw-grid-cols-4'"
            class="tw-mx-auto tw-max-w-7xl max-md:tw-px-4"
          >
            {% paginate collection.products by items_per_page -%}
              <span
                data-current-page="{{ paginate.current_page }}"
                data-total-pages="{{ paginate.pages }}"
                data-infinite-scroll-meta
                class="tw-hidden"
              ></span>
              {% for product in collection.products -%}
                <div
                  data-product-grid-item
                  class="product-grid-card"
                  :style="{ display: viewMode === 'grid' ? 'block' : 'none' }"
                >
                  <!-- Inlined ud-quickadd-card -->
                  <div class="tw-justify-between tw-flex tw-flex-col tw-p-4 tw-border tw-border-gray-400 tw-mr-[-1px] tw-mb-[-1px]">
                    <a href="{{ product.url | default: '/' }}">
                      <div class="tw-w-full tw-aspect-square tw-object-contain md:tw-mb-3 tw-mb-2 tw-relative">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 400
                            | image_tag: loading: 'lazy', class: 'tw-size-full tw-aspect-square tw-object-contain'
                          }}
                        {% else %}
                          <div class="tw-size-full">
                            {{
                              'product-1'
                              | placeholder_svg_tag: 'tw-w-full tw-max-w-[450px] tw-mx-auto tw-object-cover'
                            }}
                          </div>
                        {% endif %}
                        {% if product.tags contains 'New Product' %}
                          <div class="tw-absolute tw-top-2.5 tw-right-2 tw-text-12 tw-px-4 tw-py-1 tw-bg-black tw-rounded-full tw-text-white tw-font-semibold">
                            New
                          </div>
                        {% endif %}
                      </div>
                    </a>
                    <div class="tw-flex tw-flex-col tw-justify-between tw-h-full tw-w-full tw-gap-x-4 tw-gap-y-3 tw-items-start">
                      <div class="tw-w-full">
                        <div class="tw-flex tw-gap-x-4 tw-gap-y-1 tw-pb-2 tw-items-center tw-flex-wrap tw-w-full tw-justify-between">
                          <div class="tw-flex tw-w-full tw-flex-row tw-gap-2 tw-items-start tw-justify-between">
                            <a class="tw-w-full tw-h-fit tw-max-w-96" href="{{ product.url | default: '/' }}">
                              <h3 class="tw-font-semibold tw-text-14 tw-text-brand-primary tw-w-full tw-leading-tight tw-h-fit tw-m-0">
                                {{ product.title | default: 'Product title' }}
                              </h3>
                            </a>
                          </div>
                          <h3 class="tw-font-semibold tw-text-14 tw-text-gray-600 tw-w-full tw-leading-tight tw-h-fit tw-m-0">
                            QTY:
                            <span class="tw-font-normal">
                              {{- product.selected_or_first_available_variant.inventory_quantity -}}
                            </span>
                          </h3>
                          <div class="tw-flex tw-flex-col">
                            <div class="tw-text-gray-600 tw-text-14 tw-font-semibold">
                              List:
                              <span class="tw-font-normal">
                                {{- product.compare_at_price | default: product.price | money -}}
                              </span>
                            </div>
                            <div class="tw-font-semibold tw-text-14">
                              Your Net Price: <span class="tw-font-normal">{{ product.price | money }}</span>
                            </div>
                          </div>
                        </div>
                      </div>
                      {% if section.settings.button_type != 'none' %}
                        {% if section.settings.button_type == 'quick-add' %}
                          <div class="tw-flex tw-gap-2 tw-items-stretch tw-w-full tw-h-full">
                            <div class="tw-flex tw-items-center tw-gap-2 tw-w-full tw-h-full">
                              <span>QTY:</span>
                              <input
                                type="number"
                                min="1"
                                placeholder="1"
                                :value="getQty({{ product.selected_or_first_available_variant.id }})"
                                @input="setQty({{ product.selected_or_first_available_variant.id }}, $event.target.value)"
                                class="tw-w-full tw-text-center tw-leading-none tw-py-0.5 tw-border tw-border-gray-400 tw-rounded tw-h-full tw-text-12 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
                                :disabled="isAdding({{ product.selected_or_first_available_variant.id }})"
                              >
                            </div>
                            <button
                              type="button"
                              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                              data-tags='{{ product.tags | json }}'
                              data-isbn="{{ product.metafields.facts.isbn }}"
                              class="tw-bg-brand-secondary tw-w-full tw-cursor-pointer tw-pointer-events-auto tw-text-12 tw-text-black tw-rounded-md tw-flex tw-justify-center tw-leading-none tw-px-4 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center"
                              @click="addToCart({{ product.selected_or_first_available_variant.id }}, $event.currentTarget)"
                              :disabled="isAdding({{ product.selected_or_first_available_variant.id }})"
                            >
                              [[ isAdding({{ product.selected_or_first_available_variant.id }}) ? 'Adding...' : '{{ section.settings.button_text | default: 'Add to Cart' }}' ]]
                            </button>
                          </div>
                        {% else %}
                          <a
                            href="{{ product.url }}"
                            class="tw-bg-white tw-cursor-pointer tw-pointer-events-auto tw-text-12 tw-text-black tw-rounded-full tw-flex tw-justify-center tw-border-black tw-border-2 tw-py-1 tw-px-4 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap"
                          >
                            <span>{{ section.settings.button_text | default: 'Shop Now' }}</span>
                          </a>
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                </div>
                <div
                  data-product-list-item
                  class="product-grid-list"
                  :style="{ display: viewMode === 'list' ? 'block' : 'none' }"
                >
                  <!-- Inlined ud-quickadd-list-item -->
                  <div class="tw-flex tw-flex-row tw-items-center tw-border tw-mb-[-1px] tw-border-gray-400 tw-p-4 tw-gap-4 tw-w-full">
                    <a
                      href="{% if product.metafields.custom.alt_gallery_link != blank %}{{ product.metafields.custom.alt_gallery_link.value.url }}{% else %}{{ product.url | default: '/' }}{% endif %}"
                      class="tw-flex-shrink-0"
                    >
                      <div class="tw-h-36 tw-object-cover tw-aspect-5/6 tw-relative">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 200
                            | image_tag: loading: 'lazy', class: 'tw-size-full tw-aspect-5/6 tw-object-cover'
                          }}
                        {% else %}
                          <div class="tw-size-full">
                            {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover' }}
                          </div>
                        {% endif %}
                        {% if product.tags contains 'New Product' %}
                          <div class="tw-absolute tw-top-1 tw-right-1 tw-text-10 tw-px-2 tw-py-0.5 tw-bg-black tw-rounded-full tw-text-white tw-font-semibold">
                            New
                          </div>
                        {% endif %}
                      </div>
                    </a>
                    <div class="tw-py-1 tw-w-full tw-flex tw-flex-col tw-justify-between tw-gap-2 tw-min-w-0 tw-grow">
                      <div class="tw-flex tw-grow tw-flex-col tw-justify-between tw-gap-1">
                        <div class="tw-flex tw-w-full tw-flex-row tw-justify-between tw-gap-x-3 tw-gap-y-0.5 tw-text-12">
                          <a href="{{ product.url | default: '/' }}">
                            <h3 class="tw-font-semibold tw-text-13 tw-text-brand-primary tw-text-14 tw-leading-tight tw-m-0 tw-truncate">
                              {{ product.title | default: 'Product title' }}
                            </h3>
                          </a>
                          <div class="tw-text-gray-500 tw-text-14 tw-font-normal">
                            List:
                            <span class="tw-font-normal">
                              {{- product.compare_at_price | default: product.price | money -}}
                            </span>
                          </div>
                        </div>
                        <div class="tw-flex tw-w-full tw-flex-wrap tw-justify-between tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
                          <div>
                            <span class="tw-font-medium">by</span>
                            <a class="tw-font-medium tw-capitalize">
                              {{- product.metafields.custom.author.value | default: 'Author Name' -}}
                            </a>
                          </div>
                          <div class="tw-font-semibold">
                            Your Net Price: <span class="tw-font-semibold">{{ product.price | money }}</span>
                          </div>
                        </div>
                        <div class="tw-grow tw-text-14 tw-text-gray-500">
                          {{ product.description | default: 'No description available.' }}
                        </div>
                        <div class="tw-flex tw-w-full tw-justify-between tw-items-end tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
                          <div class="tw-flex tw-w-full tw-flex-wrap tw-text-gray-700 tw-font-semibold tw-gap-x-3 tw-gap-y-0.5 tw-text-14">
                            <div>
                              ISBN:
                              <span class="tw-font-normal">
                                {{- product.metafields.facts.isbn | default: 'XXXXXXXX' -}}
                              </span>
                            </div>
                            <div>
                              QTY:
                              <span class="tw-font-normal">
                                {{- product.selected_or_first_available_variant.inventory_quantity -}}
                              </span>
                            </div>
                          </div>
                          <div class="tw-flex-shrink-0">
                            {% if section.settings.button_type != 'none' %}
                              {% if section.settings.button_type == 'quick-add' %}
                                <div class="tw-flex tw-items-center tw-gap-2 tw-h-full">
                                  <div class="tw-flex tw-items-center tw-gap-1">
                                    <label class="tw-text-14 tw-font-semibold">QTY:</label>
                                    <input
                                      type="number"
                                      min="1"
                                      placeholder="1"
                                      :value="getQty({{ product.selected_or_first_available_variant.id }})"
                                      @input="setQty({{ product.selected_or_first_available_variant.id }}, $event.target.value)"
                                      class="tw-w-14 tw-text-center tw-leading-none tw-py-0.5 tw-px-1 tw-border tw-border-gray-400 tw-rounded tw-text-14 tw-font-semibold [appearance:textfield] [&::-webkit-inner-spin-button]:tw-appearance-none [&::-webkit-outer-spin-button]:tw-appearance-none"
                                      :disabled="isAdding({{ product.selected_or_first_available_variant.id }})"
                                    >
                                  </div>
                                  <button
                                    type="button"
                                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                                    data-tags='{{ product.tags | json }}'
                                    data-isbn="{{ product.metafields.facts.isbn }}"
                                    class="tw-bg-brand-secondary tw-cursor-pointer tw-pointer-events-auto tw-text-10 tw-text-black tw-rounded-md tw-flex tw-justify-center tw-leading-none tw-px-6 tw-py-1.5 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-sans hover:tw-scale-[105%] tw-whitespace-nowrap tw-items-center"
                                    @click="addToCart({{ product.selected_or_first_available_variant.id }}, $event.currentTarget)"
                                    :disabled="isAdding({{ product.selected_or_first_available_variant.id }})"
                                  >
                                    [[ isAdding({{ product.selected_or_first_available_variant.id }}) ? 'Adding...' : '{{ section.settings.button_text | default: 'QUICK ADD' }}' ]]
                                  </button>
                                </div>
                              {% else %}
                                <a
                                  href="{{ product.url }}"
                                  class="tw-bg-white tw-cursor-pointer tw-pointer-events-auto tw-text-11 tw-text-black tw-rounded-full tw-flex tw-justify-center tw-border-black tw-border tw-py-1 tw-px-3 tw-transition-button duration-200 ease-in-out tw-font-semibold tw-font-montserrat hover:tw-scale-[105%] tw-whitespace-nowrap"
                                >
                                  <span>{{ section.settings.button_text | default: 'View' }}</span>
                                </a>
                              {% endif %}
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor %}
              {% if section.settings.enable_infinite_scroll %}
                {% if paginate.next %}
                  <div
                    id="infinite-scroll-sentinel-{{ section.id }}"
                    data-next-url="{{ paginate.next.url }}"
                    class="md:tw-col-span-2 xl:tw-col-span-3 tw-h-4"
                  ></div>
                {% endif %}
              {% endif %}
            {%- endpaginate %}
          </div>
          {% if section.settings.enable_infinite_scroll %}
            <div
              id="infinite-scroll-spinner-{{ section.id }}"
              class="tw-w-full tw-flex tw-justify-center tw-animate-spin tw-items-center tw-py-10 md:tw-col-span-2 xl:tw-col-span-3"
            >
              <div
                style="
                  width: 48px;
                  height: 48px;
                  border: 4px solid #e5e7eb;
                  border-top-color: #1e3a5f;
                  border-radius: 50%;
                  animation: ud-spin 0.75s linear infinite;
                "
              ></div>
            </div>
            <style>
              @keyframes ud-spin {
                to {
                  transform: rotate(360deg);
                }
              }
            </style>
          {% else %}
            {% render 'collection-pagination', paginate: paginate, items_per_page: items_per_page %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const filters = document.getElementById('filters-{{ block.id }}');
    let lastKnownScrollPosition = 0;
    let ticking = false;

    function doSomething(scrollPos) {
      if (window.scrollY > scrollPos) {
        filters.classList.add('collapsed');
      } else {
        filters.classList.remove('collapsed');
      }
    }

    document.addEventListener('scroll', (event) => {
      lastKnownScrollPosition = window.scrollY;

      if (!ticking) {
        setTimeout(() => {
          doSomething(lastKnownScrollPosition);
          ticking = false;
        }, 20);

        ticking = true;
      }
    });
  })();

  new Vue({
    el: '.section-{{ section.id }}-props',
    delimiters: ['[[', ']]'],
    mixins: [global],
    data() {
      return {
        mobileFiltersOpen: false,
        sectionHeight: 0,
        openFilters: [],
        viewMode: 'grid',
        quantities: {},
        addingToCartMap: {},
      };
    },
    mounted() {
      console.log('Mounted Sortable Collections')
      // Restore view mode preference from localStorage
      const savedViewMode = localStorage.getItem('productViewMode');
      if (savedViewMode) {
        this.viewMode = savedViewMode;
      }
      // Fade in the product grid on page load
      this.$nextTick(() => {
        const grid = document.getElementById('product-grid-{{ section.id }}');
        if (grid) {
          grid.style.opacity = '0';
          grid.style.transition = 'opacity 0.5s ease';
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              grid.style.opacity = '1';
            });
          });
        }
      });
      setTimeout(() => {
        this.getNavHeight();
      }, 10);
      window.addEventListener('resize', this.getNavHeight);
    },
    methods: {
      getNavHeight() {
        const newHeight = document.querySelector('.shopify-section-group-header-group').offsetHeight;
        // If different then change and update Filter Container
        if (newHeight != this.sectionHeight) {
          this.sectionHeight = newHeight;
          this.changeFilterSpace();
        }
      },
      changeFilterSpace() {
        const filterContainer = document.querySelector('.ud-filter-container');
        const filterCarousel = document.querySelector('.ud-filter-carousel');
        if (filterContainer) {
          // console.log('got Filter Container')
          const windowHeight = window.innerHeight;
          const filterHeight = windowHeight - this.sectionHeight - 40;
          filterContainer.style.top = `${this.sectionHeight}px`;
          if (filterCarousel) {
            filterCarousel.style.top = `${this.sectionHeight}px`;
            filterCarousel.style.height = `${filterHeight}px`;
          }
          filterContainer.style.height = `${filterHeight}px`;
          console.log('new Filter Height', windowHeight);
          console.log('new Filter Height', filterHeight);
        }
      },
      sortByChange(event) {
        const sortValue = event.target.value;
        const currentUrl = new URL(window.location.href);
        currentUrl.searchParams.set('sort_by', sortValue);
        // Reset to page 1 when sorting changes
        currentUrl.searchParams.set('page', 1);
        this.navigateWithFade(currentUrl.toString());
      },
      navigateWithFade(url) {
        const grid = document.getElementById('product-grid-{{ section.id }}');
        if (grid) {
          grid.style.transition = 'opacity 0.3s ease';
          grid.style.opacity = '0';
          setTimeout(() => { window.location.href = url; }, 300);
        } else {
          window.location.href = url;
        }
      },
      toggleViewMode(mode) {
        this.viewMode = mode;
        localStorage.setItem('productViewMode', mode);
      },
      getQty(variantId) {
        return this.quantities[variantId] || 1;
      },
      setQty(variantId, val) {
        this.$set(this.quantities, variantId, parseInt(val, 10) || 1);
      },
      isAdding(variantId) {
        return !!this.addingToCartMap[variantId];
      },
      addToCart(variantId, btn) {
        const qty = this.getQty(variantId);
        const tags = JSON.parse(btn.dataset.tags || '[]');
        const isbn = btn.dataset.isbn || null;
        this.$set(this.addingToCartMap, variantId, true);
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [{ id: variantId, quantity: qty, properties: { '_tags': tags, '_isbn': isbn } }],
          }),
        })
          .then(async (r) => { const data = await r.json(); if (!r.ok) throw data; return data; })
          .then((data) => {
            const recentItem = data.items?.[0];
            this.bus.$emit('refreshCart');
            this.bus.$emit('cartItemAdded', recentItem);
          })
          .catch((error) => { this.bus.$emit('cartFailedToAdd', error); })
          .finally(() => { this.$set(this.addingToCartMap, variantId, false); });
      },
    },
  });

  {% if section.settings.enable_infinite_scroll %}
  (function () {
    var sentinel = document.getElementById('infinite-scroll-sentinel-{{ section.id }}');
    if (!sentinel) return;

    var grid = document.getElementById('product-grid-{{ section.id }}');
    var spinner = document.getElementById('infinite-scroll-spinner-{{ section.id }}');
    var loading = false;
    var sentinelId = 'infinite-scroll-sentinel-{{ section.id }}';

    function showSpinner() { if (spinner) { spinner.classList.remove('tw-hidden'); spinner.classList.add('tw-flex'); } }
    function hideSpinner() { if (spinner) { spinner.classList.add('tw-hidden'); spinner.classList.remove('tw-flex'); } }

    var observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting || loading) return;
        var nextUrl = sentinel.dataset.nextUrl;
        if (!nextUrl) return;

        loading = true;
        showSpinner();
        fetch(nextUrl)
          .then(function (res) { return res.text(); })
          .then(function (html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newGrid = doc.getElementById('product-grid-{{ section.id }}');
            if (!newGrid) { hideSpinner(); loading = false; return; }

            var newItems = Array.prototype.filter.call(newGrid.children, function (el) {
              return el.id !== sentinelId;
            });
            newItems.forEach(function (card) { grid.insertBefore(card, sentinel); });

            var newSentinel = doc.getElementById(sentinelId);
            if (newSentinel && newSentinel.dataset.nextUrl) {
              sentinel.dataset.nextUrl = newSentinel.dataset.nextUrl;
            } else {
              observer.disconnect();
              sentinel.remove();
              hideSpinner();
            }
            hideSpinner();
            loading = false;
          })
          .catch(function () { hideSpinner(); loading = false; });
      },
      { rootMargin: '1500px' }
    );

    observer.observe(sentinel);
  })();
  {% endif %}
</script>

