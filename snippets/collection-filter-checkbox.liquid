{% comment %}
  Checkbox-style link used by the collection filter blocks.
  Usage:
    {% render 'collection-filter-checkbox', href: url, checked: true, label: 'Art', count: 12 %}
{% endcomment %}
<a
  href="{{ href }}"
  data-filter-entry
  class="tw-flex tw-flex-1 tw-w-full tw-justify-center tw-items-center tw-gap-2 tw-group"
  {% if checked %}
    aria-current="true"
  {% endif %}
>
  <div class="tw-border group-hover:tw-border-black tw-rounded-[4px] tw-border-offblack tw-size-4 tw-aspect-square tw-p-0.5 tw-my-auto{% if checked %} tw-bg-black{% endif %}">
    <svg
      class="tw-fill-white{% unless checked %} tw-hidden{% endunless %}"
      viewBox="0 0 448 512"
    >
      <path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/>
    </svg>
  </div>
  <p class="group-hover:tw-underline tw-text-offblack tw-text-14 tw-w-full !tw-m-0">
    {{- label -}}
    {%- if count != blank %} ({{ count }}){% endif -%}
  </p>
</a>
