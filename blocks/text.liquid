<style>
  .gap-border-{{ block.id }}::after {
    content: "";
    position: absolute;
    bottom: -5px;
    right: 38%;
    width: 25%;
    height: 2px;
    background-color: #DEDEDE;
  }
  .list-item-{{ block.id }}::before {
    content: "•";
    margin-right: 0.5em;
    color: inherit;
    display: inline-block;
  }
  .block-{{ block.id }} {
    color: {{ block.settings.color }};
    max-width: {{ block.settings.mobile_max_width }}px;
    font-size: {{ block.settings.mobile_font_size }}px;
    font-weight: {{ block.settings.weight | default: 400 }};
  }

  @media screen and (min-width: 768px) {
    .block-{{ block.id }} {
      max-width: {{ block.settings.max_width }}px;
      font-size: {{ block.settings.font_size }}px;
    }
  }
</style>

{% assign text_classes = 'tw-m-0  block-' | append: block.id %}

{% if block.settings.font == 'primary' %}
  {% assign text_classes = text_classes | append: ' tw-font-playfair' %}
{% elsif block.settings.font == 'secondary' %}
  {% assign text_classes = text_classes | append: ' tw-font-montserrat' %}
{% endif %}

{% if block.settings['gap-border'] %}
  {% assign text_classes = text_classes | append: ' gap-border-' | append: block.id %}
{% endif %}

{% if block.settings.list %}
  {% assign text_classes = text_classes | append: ' list-item-' | append: block.id %}
{% endif %}

<div class="tw-w-full tw-font-montserrat tw-leading-tighter tw-h-fit tw-flex {% if block.settings.align == 'center' %} tw-text-center {% elsif block.settings.align == 'end' %} tw-text-end {% elsif block.settings.align == 'start' %} tw-text-start {% endif %} {% if block.settings.display == 'desktop' %} tw-hidden md:tw-block {% elsif block.settings.display == 'mobile' %} md:tw-hidden {% endif %} tw-relative">
  {% case block.settings.type %}
    {% when 'h1' %}
      <h2 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h2>
    {% when 'h2' %}
      <h2 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h2>
    {% when 'h3' %}
      <h3 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h3>
    {% when 'h4' %}
      <h4 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h4>
    {% when 'h5' %}
      <h5 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h5>
    {% when 'h6' %}
      <h6 class="{{ text_classes }} tw-leading-tight">
        {{ block.settings.text }}
      </h6>
    {% when 'p' %}
      <p class="{{ text_classes }}">
        {{ block.settings.text }}
      </p>
  {% endcase %}
</div>

