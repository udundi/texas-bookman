<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  # Admin SEO fields win; otherwise build a description from the page's own content,
  # then the shop description, then the theme setting.
  assign seo_description = page_description | strip_html | strip_newlines | strip
  if seo_description == blank
    case request.page_type
      when 'collection'
        assign seo_description = collection.description | strip_html | strip_newlines | strip
        if seo_description == blank
          assign seo_description = 'Shop ' | append: collection.title | append: ' at wholesale prices from ' | append: shop.name | append: '. Low minimums and fast fulfillment.'
        endif
      when 'page'
        assign seo_description = page.content | strip_html | strip_newlines | strip
      when 'article'
        assign seo_description = article.excerpt_or_content | strip_html | strip_newlines | strip
    endcase
  endif
  if seo_description == blank
    assign seo_description = shop.description | default: settings.seo_default_description | strip_html | strip_newlines | strip
    if request.page_type == 'page' or request.page_type == 'blog'
      assign seo_title = page.title | default: blog.title
      if seo_title != blank
        assign seo_description = seo_title | append: ' – ' | append: seo_description
      endif
    endif
  endif
  assign seo_description = seo_description | default: shop.name | truncate: 160
  assign og_description = seo_description

  # og:image falls back to the collection's own imagery, then the theme's share image.
  assign og_image = page_image
  if og_image == blank and request.page_type == 'collection'
    assign og_image = collection.image | default: collection.products.first.featured_image
  endif
  if og_image == blank
    assign og_image = settings.share_image
  endif
  if og_image != blank
    assign og_image_width = og_image.width | at_most: 1200
    assign og_image_height = og_image_width | divided_by: og_image.aspect_ratio | round
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape_once }}"
>

{%- if og_image != blank -%}
  <meta
    property="og:image"
    content="http:{{ og_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image_width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image_height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape_once }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ seo_description | escape_once }}"
>
