<div
  class="
    {% if block.settings.visibility contains 'mobile' %}
      tw-contents
      md:tw-hidden
    {% elsif block.settings.visibility contains "desktop" %}
      tw-hidden
      md:tw-contents
    {% else %}
      tw-contents
    {% endif %}
  "
>
  <!-- Mobile Extra Header -->
  <div class="tw-flex tw-flex-col tw-justify-center tw-gap-2">
    <!-- Mobile Title -->
    {% assign title_text = product.title %}
    {% if block.settings.title_override != blank %}
      {% assign title_text = block.settings.title_override %}
    {% endif %}
    {% if block.settings.visibility contains 'desktop' %}
      <h1 class="tw-text-26 tw-m-0 tw-font-semibold tw-text-offblack tw-w-full max-md:tw-text-center tw-justify-start tw-leading-tight">
        {{ title_text }}
      </h1>
    {% else %}
      <p class="tw-text-26 tw-m-0 tw-font-semibold tw-text-offblack tw-w-full tw-justify-start tw-leading-tight">
        {{ title_text }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "PDP Title & Ratings",
  "class": "tw-contents",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Title Override",
      "placeholder": "Leave blank to use product title"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "PDP Title & Ratings"
    }
  ]
}
{% endschema %}
