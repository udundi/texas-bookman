{% style %}
  .ud-hero-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Desktop: fixed height with background image */
  @media screen and (min-width: 750px) {
    .ud-hero-banner-{{ section.id }} {
      min-height: {{ section.settings.desktop_height }}px;
      display: flex;
      align-items: center;
      justify-content: {{ section.settings.desktop_content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' | replace: 'center', 'center' }};
    }

    .ud-hero-banner-{{ section.id }} .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.desktop_image_position }};
    }

    .ud-hero-banner-{{ section.id }} .hero-content {
      position: relative;
      z-index: 1;
      max-width: 50%;
      padding: 3rem {{ section.settings.desktop_content_padding_x }}rem;
    }
  }

  /* Mobile: stacked layout */
  @media screen and (max-width: 749px) {
    .ud-hero-banner-{{ section.id }} {
      display: flex;
      flex-direction: column;
    }

    .ud-hero-banner-{{ section.id }} .hero-image-wrapper {
      width: 100%;
      aspect-ratio: {{ section.settings.mobile_image_ratio }};
      overflow: hidden;
    }

    .ud-hero-banner-{{ section.id }} .hero-bg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.mobile_image_position }};
    }

    .ud-hero-banner-{{ section.id }} .hero-content {
      padding: 2rem 1.5rem;
      background-color: {{ section.settings.mobile_content_bg }};
    }

    .ud-hero-banner-{{ section.id }} .hero-heading {
      color: {{ section.settings.mobile_heading_color }} !important;
    }

    .ud-hero-banner-{{ section.id }} .hero-body {
      color: {{ section.settings.mobile_body_color }} !important;
    }
  }
{% endstyle %}

<section
  id="ud-hero-banner-{{ section.id }}"
  class="ud-hero-banner-{{ section.id }} tw-max-w-screen-2xl tw-mx-auto"
  style="background-color: {{ section.settings.overlay_color }};"
>
  {%- if section.settings.image != blank -%}
    {%- assign hero_img_alt = section.settings.image.alt | default: '' | escape -%}
    {%- comment -%} Mobile: image inside its own wrapper for aspect-ratio control {%- endcomment -%}
    <div class="hero-image-wrapper md:tw-hidden">
      {{
        section.settings.image
        | image_url: width: 800
        | image_tag: class: 'hero-bg', alt: hero_img_alt, loading: 'lazy'
      }}
    </div>

    {%- comment -%} Desktop: image as absolute background {%- endcomment -%}
    <div class="tw-hidden md:tw-block">
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag: class: 'hero-bg', alt: hero_img_alt, loading: 'lazy'
      }}
    </div>
  {%- endif -%}

  {%- comment -%} Optional overlay for desktop readability {%- endcomment -%}
  {%- if section.settings.show_overlay -%}
    {%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
    <div
      class="tw-hidden md:tw-block tw-absolute tw-inset-0"
      style="background: linear-gradient(to right, {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }} 0%, {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }} 25%, transparent 60%);"
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <div class="hero-content ">
    {%- if section.settings.eyebrow != blank -%}
      <p
        class="tw-mb-2 tw-font-bold tw-uppercase tw-tracking-widest"
        style="color: {{ section.settings.eyebrow_color }}; font-size: {{ section.settings.eyebrow_size }}px;"
      >
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="hero-heading tw-font-bold tw-leading-tight tw-mb-4"
        style="color: {{ section.settings.heading_color }}; font-size: clamp({{ section.settings.heading_size_min }}px, 3vw, {{ section.settings.heading_size_max }}px);"
      >
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <p
        class="hero-body tw-mb-6 tw-leading-relaxed"
        style="color: {{ section.settings.body_color }}; font-size: {{ section.settings.body_size }}px;"
      >
        {{ section.settings.body_text }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_url }}"
        class="tw-inline-block tw-font-bold tw-uppercase tw-tracking-widest tw-no-underline"
        style="
          background-color: {{ section.settings.button_bg }};
          color: {{ section.settings.button_text_color }};
          padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
          font-size: {{ section.settings.button_font_size }}px;
        "
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "center center", "label": "Center Center" },
        { "value": "center top", "label": "Center Top" },
        { "value": "center bottom", "label": "Center Bottom" },
        { "value": "left center", "label": "Left Center" },
        { "value": "right center", "label": "Right Center" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile Image Position",
      "options": [
        { "value": "center center", "label": "Center Center" },
        { "value": "center top", "label": "Center Top" },
        { "value": "center bottom", "label": "Center Bottom" },
        { "value": "left center", "label": "Left Center" },
        { "value": "right center", "label": "Right Center" }
      ],
      "default": "center top"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile Image Aspect Ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "9 / 16", "label": "Tall (9:16)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Height (px)",
      "min": 200,
      "max": 800,
      "step": 10,
      "default": 480
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Colour Overlay (desktop)",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kids' Summer Reading Titles"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Min Size (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Max Size (px)",
      "min": 28,
      "max": 80,
      "step": 2,
      "default": 48
    },
    {
      "type": "header",
      "content": "Body Text"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#F0BA3A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button Font Size (px)",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "label": "Button Padding Vertical (px)",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "label": "Button Padding Horizontal (px)",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 32
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "label": "Desktop Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_content_padding_x",
      "label": "Desktop Content Side Padding (rem)",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 5
    },
    {
      "type": "color",
      "id": "mobile_content_bg",
      "label": "Mobile Content Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_heading_color",
      "label": "Mobile Heading Color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "mobile_body_color",
      "label": "Mobile Body Color",
      "default": "#212121"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
