{%- comment -%}
  Outputs the case-pack facts of a product as JSON, or null when it has no Case variant:
  {"case_variant_id", "size", "single_price", "case_price"}. Case size and the Single/Case
  variant lookup follow blocks/_pdp-box-quantity.liquid. Used by the cart and the add-to-cart
  popup (through templates/product.case-info.liquid) to show the pack size and the saving.

  Accepts:
  - product: {Object} the product
{%- endcomment -%}
{%- liquid
  assign single_variant = nil
  assign case_variant = nil
  for variant in product.variants
    if variant.option1 == 'Case'
      assign case_variant = variant
    elsif single_variant == nil
      assign single_variant = variant
    endif
  endfor
  assign case_size = product.metafields.custom.case_size.value | default: case_variant.metafields.custom.case_quantity.value | default: 1
-%}
{%- if case_variant and single_variant and case_size > 1 -%}
  {"case_variant_id": {{ case_variant.id }}, "size": {{ case_size }}, "single_price": {{ single_variant.price }}, "case_price": {{ case_variant.price }}}
{%- else -%}
  null
{%- endif -%}
