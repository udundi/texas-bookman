          "label": "Video (16 / 9)"
        },
        {
          "value": "8/3",
          "label": "Wide Banner (8 / 3)"
        },
        {
          "value": "10/9",
          "label": "Wide Photo (10 / 9)"
        },
        {
          "value": "7/6",
          "label": "Wide Photo (7 / 6)"
        },
        {
          "value": "6/5",
          "label": "Wide Photo (6 / 5)"
        },
        {
          "value": "5/4",
          "label": "Wide Photo (5 / 4)"
        },
        {
          "value": "4/3",
          "label": "Wide Photo (4 / 3)"
        },
        {
          "value": "3/2",
