{% style %}
  .section-outer-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}rem;
    padding-bottom: {{ section.settings.padding_bottom }}rem;
  }

  .section-{{ section.id }} {
    padding-left: {{ section.settings.padding_left }}rem;
    {% if section.settings.container_width == 'full_width' %}
      width: 100%;
    {% elsif section.settings.container_width == 'lg_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'md_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'sm_desktop' %}
      max-width: var(--container-width, 1280px);
    {% elsif section.settings.container_width == 'tablet' %}
      max-width: var(--container-width, 768px);
    {% else section.settings.container_width == 'mobile' %}
      max-width: var(--container-width, 448px);
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .section-outer-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}rem;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}rem;
    }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-left: {{ section.settings.mobile_padding_left }}rem;
      padding-right: {{ section.settings.mobile_padding_right }}rem;
    }
  }
{% endstyle %}

<div class="section-outer-{{ section.id }}">
  <div class="section-{{ section.id }} tw-mx-auto">
    {% if section.settings.section_title != blank %}
      <div class="tw-flex tw-justify-between tw-px-20 tw-py-4">
        <div class=" tw-font-playfair tw-font-semibold tw-text-36 tw-leading-tight tw-text-offblack">
          {{ section.settings.section_title }}
        </div>
        <a
          href="{{ section.settings.button_url }}"
          class="tw-bg-brand-primary tw-uppercase tw-font-semibold tw-text-white tw-py-2 tw-px-4 tw-w-full tw-flex tw-items-center tw-justify-center tw-max-w-64 tw-rounded-md"
        >
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
    <div class="tw-flex tw-flex-col tw-gap-4 tw-items-center">Test</div>
  </div>
</div>

<script>
  var swiper = new Swiper('.carousel-{{ section.id }}', {
    slidesPerView: {{ section.settings.mobile_slides }},
    loop: true,
    breakpoints: {
      425: {
        slidesPerView: {{ section.settings.tablet_slides }},
      },
      768: {
        slidesPerView: {{ section.settings.sm_desktop_slides }},
      },
      1024: {
        slidesPerView: {{ section.settings.lg_desktop_slides }},
      },
    },
    // Disable all automatic slide advancement from pointer/touch events
    touchStartPreventDefault: false,

    navigation: {
      nextEl: '#featured-swiper-next-{{ section.id }}',
      prevEl: '#featured-swiper-prev-{{ section.id }}',
    },
  });
</script>

{% schema %}
{
  "name": "Events",
  "settings": [
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title"
    },
    {
      "type": "text",
      "label": "Section Subtitle",
      "id": "section_subtitle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_left",
      "label": "Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_right",
      "label": "Padding Right",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_left",
      "label": "Mobile Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_right",
      "label": "Mobile Padding Right",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Max Width Of Section",
      "options": [
        {
          "value": "mobile",
          "label": "448px (Mobile)"
        },
        {
          "value": "tablet",
          "label": "768px (Tablet)"
        },
        {
          "value": "sm_desktop",
          "label": "1024px (Sm Desktop)"
        },
        {
          "value": "md_desktop",
          "label": "1280px (Md Desktop)"
        },
        {
          "value": "lg_desktop",
          "label": "1440px (Lg Desktop)"
        },
        {
          "value": "full_width",
          "label": "Full Width"
        }
      ],
      "default": "full_width"
    }
  ],
  "presets": [
    {
      "name": "Events"
    }
  ]
}
{% endschema %}
