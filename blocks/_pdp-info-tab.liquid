<div class="tw-flex tw-flex-col tw-gap-4 tw-items-center tw-w-full tw-justify-center tw-py-4 tw-px-4 tw-bg-brand-blue">
  <div class="tw-w-full tw-gap-4 tw-flex tw-items-start tw-justify-start">
    {% for block in block.blocks %}
        <div class="tw-flex tw-flex-col tw-gap-0.5 tw-items-start tw-w-full tw-justify-start tw-py-4 tw-px-4">
            {{ block.settings.text }}
        </div>  
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Info Tab",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text Content",
      "default": "<p>Lorem ipsum dolor sit amet.</p>"
    },
  ],
  "presets": [
    {
      "name": "Info Tab"
    }
  ]
}
{% endschema %}
