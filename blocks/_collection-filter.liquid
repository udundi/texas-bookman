  {% if block.settings.filter_type != 'color' %}
    {%- liquid
      # Each entry is a Search & Discovery filter value from collection.filters, so it
      # applies for real, shows its count within the current results and can be combined
      # with other values (Shopify ORs values of one filter). "Collection Tag" holds the
      # value, or several spellings separated by | that are applied together.
      assign filter_param = block.settings.filter_type | remove_last: '='
      capture filter_state
        render 'collection-filter-state', param: filter_param, values: block.settings.tag
      endcapture
      assign filter_state = filter_state | split: '@@'
      assign filter_active = false
      if filter_state[1] == 'true'
        assign filter_active = true
      endif
      assign filter_count = nil
      if filter_state[0] == 'value'
        assign filter_count = filter_state[2] | plus: 0
      endif
      assign filter_href = filter_state[3]
    -%}
    {%- capture child_blocks -%}{%- content_for 'blocks' -%}{%- endcapture -%}
    {%- liquid
      # Nested filters mark themselves active so their parent stays visible and opens
      assign child_blocks = child_blocks | strip
      # Shopify wraps every block in a div, so only count children that rendered an entry
      unless child_blocks contains 'data-filter-entry'
        assign child_blocks = ''
      endunless
      assign children_collapsed = block.settings.children_collapsed | default: false
      if child_blocks contains 'data-filter-active'
        assign children_collapsed = false
      endif
    -%}

    {%- liquid
      # Show the entry only when it does something: it is applied, or adding it gives
      # results. Values no product in the results has, and params the store has no
      # filter for (e.g. a tag nobody uses), would be dead or empty links.
      assign hide_filter = true
      if filter_active or filter_href != blank or child_blocks != blank
        assign hide_filter = false
      endif
    -%}

    {%- unless hide_filter -%}
    <div class="tw-p-0.5">
    <div class="tw-flex tw-w-full tw-flex-col"{% if filter_active %} data-filter-active{% endif %}>
      <div class="tw-flex tw-w-full tw-items-center tw-gap-1">
        {% render 'collection-filter-checkbox',
          href: filter_href,
          checked: filter_active,
          label: block.settings.title,
          count: filter_count
        %}
        {%- unless child_blocks == blank -%}
          <button
            type="button"
            class="tw-flex-shrink-0 tw-fill-offblack tw-size-3 tw-cursor-pointer tw-bg-transparent tw-border-0 tw-p-0 tw-m-0"
            @click="toggleFilter('{{ block.id }}', {{ children_collapsed }})"
          >
            <div
              class="tw-fill-offblack tw-size-3"
              v-if="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
            >
              {% render 'icon-arrow-up' %}
            </div>
            <div v-else class="tw-fill-offblack tw-size-3">{% render 'icon-arrow-down' %}</div>
          </button>
        {%- endunless -%}
      </div>
      {%- unless child_blocks == blank -%}
        <div
          class="tw-pl-4 tw-pt-1 tw-flex tw-flex-col tw-gap-[1px]"
          v-show="isFilterOpen('{{ block.id }}', {{ children_collapsed }})"
        >
          {{ child_blocks }}
        </div>
      {%- endunless -%}
    </div>
    </div>
    {%- endunless -%}
  {% else %}
  {%- liquid
    # theme-check-disable
    # The colour swatches still read the query string from the page URL
    capture content_for_query_string
      echo content_for_header
    endcapture
  -%}

  {% assign get_full_url = content_for_query_string
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | split: '.myshopify.com'
    | last
    | replace: '\/', '/'
    | replace: '%20', ' '
    | replace: '\u0026', '&'
    | replace: collection.url, ''
    | replace: 'feltright.com', ''
    | replace: '%2F', '/'
    | replace: '%27', "'"
  %}
    <div class="tw-p-0.5">
    <div class="tw-flex tw-flex-wrap tw-gap-2 tw-w-full ">
      {% for color in metaobjects.tile_colors.values %}
        {% assign color_index = forloop.index %}
        {% for ref in metaobjects.tile_colors.values %}
          {% if color_index == ref.position %}
            {% assign color_ref = ref %}
          {% endif %}
        {% endfor %}
        {% assign filter_change = 'filter.p.tag=' | append: color_ref.name | replace: ' ', '+' %}
        <a
          {% assign query_params = get_full_url
            | replace: 'pb=0', ''
            | replace: '_fd=0', ''
            | replace: '&&', '&'
            | replace: '?&', '?'
            | replace: '?', ''
            | split: '&'
          %}
          {% if get_full_url contains color_ref.name %}
            {% assign new_params = '' %}
            {% for param in query_params %}
              {% unless forloop.last and param == filter_change %}
                {% assign new_params = new_params | append: '&' %}
              {% endunless %}
              {% if param != filter_change %}
                {% assign new_params = new_params | append: param %}
              {% endif %}
            {% endfor %}
            {% if new_params != blank %}
              href="{{ collection.url |  append: '?' |  append: new_params | replace: '&&', '&' | replace: '?&', '?' }}"
            {% else %}
              href="{{ collection.url }}"
            {% endif %}
          {% else %}
            href="{{ collection.url }}{{ query_params |  join: '&' | prepend: '?' | append: '&' | append: filter_change | replace: '&&', '&' | replace: '?&', '?' }}"
          {% endif %}
          class="tw-group tw-h-fit tw-w-fit"
          data-filter-entry
        >
          {% assign filter_border_check = 'filter.p.tag=' | append: color_ref.name %}
          <div
            class="
              tw-size-6 tw-border {% if color_ref.bordered %}tw-border-black/100{% else %}tw-border-black/0{% endif %}
              {% if get_full_url contains filter_border_check %} tw-ring-4 tw-ring-black {% endif %}  tw-rounded-full
            "
            style="background-color: {{ color_ref.color }};"
          ></div>
        </a>
      {% endfor %}
    </div>
    </div>
  {% endif %}

{% schema %}
{
  "name": "Collection Filter",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Filter value",
      "info": "Search & Discovery filter value. Separate several values with | to apply them together (e.g. publisher spellings)."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Tag Title"
    },
    {
      "type": "text",
      "id": "filter_type",
      "label": "Filter Type",
      "info": "Search & Discovery filter parameter followed by =, e.g. filter.p.m.custom.publisher= or filter.p.m.custom.category=. Entries for filters the store doesn't have are hidden.",
      "default": "filter.p.tag="
    },
    {
      "type": "checkbox",
      "id": "children_collapsed",
      "label": "Children Collapsed",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "_collection-filter"
    }
  ],
  "presets": [
    {
      "name": "Collection Filter"
    }
  ]
}
{% endschema %}
