{% style %}
  .section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.container_width == 'full_width' %}
      width: 100%;
    {% elsif section.settings.container_width == 'lg_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'md_desktop' %}
      max-width: var(--container-width, 1440px);
    {% elsif section.settings.container_width == 'sm_desktop' %}
      max-width: var(--container-width, 1280px);
    {% elsif section.settings.container_width == 'tablet' %}
      max-width: var(--container-width, 768px);
    {% else section.settings.container_width == 'mobile' %}
      max-width: var(--container-width, 448px);
    {% endif %}

  }
{% endstyle %}

<div class="section-{{ block.id }} tw-mx-auto tw-py-4">
  <div class="vue-controler-{{ block.id }} tw-mx-auto">
    {% if block.blocks[1] != blank %}
      <div class="tw-flex tw-justify-start tw-gap-4">
        {% assign tab_titles = block.settings.tab_titles | append: '-' | split: '-' %}
        {% for block in block.blocks %}
          <button
            @click="clickingTab('{{ block.id }}')"
            class="tw-mb-[-1px] tw-text-16 tw-font-montserrat tw-leading-tight tw-p-4 tw-capitalize tw-text-offblack"
            :class="
              [
                clickedTab == '{{ block.id }}' ? 'tw-font-semibold tw-border-t tw-border-grey-400 tw-border-x tw-bg-brand-eggshell' : 'tw-font-normal'
              ]
            "
          >
            {{ tab_titles[forloop.index0] | default: 'Default Tab' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  {% for block in block.blocks %}
    <div class="tw-overflow-hidden tw-border tw-border-grey-400 tw-mt-[-1px] tw-bg-brand-eggshell info-tab-{{ block.id }} {% unless forloop.first %}tw-max-h-0 {% endunless %}">
      {% render block %}
    </div>
  {% endfor %}
</div>


{% schema %}
{
  "name": "Tabbed Info Section",
  "class": "tw-w-full",
  "settings": [
    {
      "type": "text",
      "label": "Tab Titles",
      "id": "tab_titles",
      "info": "Separate titles with hyphens => '-'"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Desktop Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "label": "Mobile Padding Top",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "default": 4
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_left",
      "label": "Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "padding_right",
      "label": "Padding Right",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_left",
      "label": "Mobile Padding Left",
      "default": 2
    },
    {
      "type": "range",
      "min": 0,
      "max": 40,
      "step": 0.5,
      "unit": "rem",
      "id": "mobile_padding_right",
      "label": "Mobile Padding Right",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Max Width Of Section",
      "options": [
        {
          "value": "mobile",
          "label": "448px (Mobile)"
        },
        {
          "value": "tablet",
          "label": "768px (Tablet)"
        },
        {
          "value": "sm_desktop",
          "label": "1024px (Sm Desktop)"
        },
        {
          "value": "md_desktop",
          "label": "1280px (Md Desktop)"
        },
        {
          "value": "lg_desktop",
          "label": "1440px (Lg Desktop)"
        },
        {
          "value": "full_width",
          "label": "Full Width"
        }
      ],
      "default": "full_width"
    }
  ],
  "blocks": [
    {
      "type": "_pdp-info-tab"
    },
  ],
  "presets": [
    {
      "name": "Tabbed Info Section"
    }
  ]
}
{% endschema %}
