{% style %}
  /* Dynamic desktop/mobile section padding driven by theme settings */
  .ud-events-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .ud-events-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<section
  class="ud-events-{{ section.id }} tw-border-t tw-border-solid tw-border-brand-grey tw-w-full"
  id="ud-events-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tw-mx-auto tw-px-6" style="max-width: {{ section.settings.content_max_width }}px;">
    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="tw-font-bold tw-text-center tw-mb-2 tw-font-montserrat"
        style="color: {{ section.settings.heading_color }}; font-size: clamp({{ section.settings.heading_size_min }}px, 2.5vw, {{ section.settings.heading_size_max }}px);"
      >
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p
        class="tw-text-center tw-mb-9 tw-font-montserrat"
        style="color: {{ section.settings.subtext_color }}; font-size: {{ section.settings.subtext_size }}px;"
      >
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- comment -%} Event cards {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="tw-flex tw-flex-col">
        {%- for block in section.blocks -%}
          <article
            class="tw-flex tw-flex-col tw-items-stretch tw-overflow-hidden tw-mb-5 last:tw-mb-0 md:tw-flex-row"
            style="border: 1px solid {{ section.settings.card_border_color }}; border-radius: {{ section.settings.card_border_radius }}px; background-color: {{ section.settings.card_bg }};"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Thumbnail {%- endcomment -%}
            {%- if block.settings.image != blank -%}
              {%- assign thumb_alt = block.settings.image.alt | default: block.settings.title | default: '' | escape -%}
              <img
                src="{{ block.settings.image | image_url: width: 380 }}"
                alt="{{ thumb_alt }}"
                class="tw-shrink-0 tw-self-start tw-rounded-md tw-aspect-video tw-object-cover tw-object-center tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-max-w-[380px] tw-w-full md:tw-mx-0 md:tw-ml-5 md:tw-my-5 md:tw-min-h-0"
                loading="lazy"
                width="380"
                height="148"
              >
            {%- else -%}
              <div
                class="tw-shrink-0 tw-self-start tw-rounded-md tw-aspect-video tw-object-cover tw-object-center tw-mx-4 tw-mt-4 tw-min-h-[180px] md:tw-max-w-[380px] tw-w-full md:tw-mx-0 md:tw-ml-5 md:tw-my-5 md:tw-min-h-0"
                aria-hidden="true"
              ></div>
            {%- endif -%}

            <div class="tw-flex tw-flex-1 tw-flex-col tw-gap-2 tw-min-w-0 tw-p-5 md:tw-pl-6">
              <div class="tw-flex tw-items-start tw-justify-between tw-gap-4 tw-flex-wrap">
                <div class="tw-flex-1 tw-min-w-0">
                  {%- if block.settings.title != blank -%}
                    {%- if block.settings.title_url != blank -%}
                      <a
                        href="{{ block.settings.title_url }}"
                        class="tw-block tw-font-bold tw-leading-tight tw-mb-1 tw-no-underline hover:tw-underline tw-font-montserrat"
                        style="color: {{ section.settings.event_title_color }}; font-size: {{ section.settings.event_title_size }}px;"
                      >
                        {{ block.settings.title }}
                      </a>
                    {%- else -%}
                      <span
                        class="tw-block tw-font-bold tw-leading-tight tw-mb-1 tw-font-montserrat"
                        style="color: {{ section.settings.event_title_color }}; font-size: {{ section.settings.event_title_size }}px;"
                      >
                        {{ block.settings.title }}
                      </span>
                    {%- endif -%}
                  {%- endif -%}

                  {%- comment -%} Reusable meta icon (time icon reused for all until swapped) {%- endcomment -%}
                  {%- capture meta_icon -%}
                    <svg
                      class="tw-shrink-0 tw-size-3.5 tw-fill-none"
                      style="stroke: {{ section.settings.meta_color }}; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  {%- endcapture -%}
                  {%- assign has_date_range = false -%}
                  {%- if block.settings.date_range != blank -%}{%- assign has_date_range = true -%}{%- endif -%}
                  {%- assign has_time = false -%}
                  {%- if block.settings.time != blank -%}{%- assign has_time = true -%}{%- endif -%}
                  {%- assign has_location = false -%}
                  {%- if block.settings.location != blank -%}{%- assign has_location = true -%}{%- endif -%}

                  {%- if has_date_range or has_time or has_location -%}
                    <div
                      class="tw-flex tw-items-center tw-gap-1 tw-flex-wrap tw-font-montserrat"
                      style="color: {{ section.settings.meta_color }}; font-size: {{ section.settings.meta_size }}px;"
                    >
                      {%- if has_date_range -%}
                        <span class="tw-inline-flex tw-items-center tw-gap-1">
                          {{ meta_icon }}
                          <span>{{ block.settings.date_range }}</span>
                        </span>
                      {%- endif -%}
                      {%- if has_time -%}
                        {%- if has_date_range -%}
                          <span class="tw-opacity-50">|</span>
                        {%- endif -%}
                        <span class="tw-inline-flex tw-items-center tw-gap-1">
                          {{ meta_icon }}
                          <span>{{ block.settings.time }}</span>
                        </span>
                      {%- endif -%}
                      {%- if has_location -%}
                        {%- if has_date_range or has_time -%}
                          <span class="tw-opacity-50">|</span>
                        {%- endif -%}
                        <span class="tw-inline-flex tw-items-center tw-gap-1">
                          {{ meta_icon }}
                          <span>{{ block.settings.location }}</span>
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

                {%- comment -%} Date badge {%- endcomment -%}
                {%- if block.settings.date_month != blank or block.settings.date_day != blank -%}
                  <div
                    class="tw-flex tw-shrink-0 tw-flex-col tw-items-center tw-justify-center tw-text-center tw-rounded tw-py-1.5 tw-px-3 tw-min-w-16 max-md:tw-order-first"
                    style="background-color: {{ section.settings.badge_bg }};"
                    aria-label="{{ block.settings.date_month }} {{ block.settings.date_day }} {{ block.settings.date_year }}"
                  >
                    {%- if block.settings.date_month != blank -%}
                      <span
                        class="tw-text-[11px] tw-font-bold tw-uppercase tw-tracking-[0.05em] tw-leading-[1.2]"
                        style="color: {{ section.settings.badge_text_color }};"
                      >
                        {{ block.settings.date_month }}
                      </span>
                    {%- endif -%}
                    {%- if block.settings.date_day != blank -%}
                      <span
                        class="tw-text-28 tw-font-bold tw-leading-[1.1]"
                        style="color: {{ section.settings.badge_text_color }};"
                      >
                        {{ block.settings.date_day }}
                      </span>
                    {%- endif -%}
                    {%- if block.settings.date_year != blank -%}
                      <span
                        class="tw-text-[11px] tw-font-bold tw-leading-[1.2]"
                        style="color: {{ section.settings.badge_text_color }};"
                      >
                        {{ block.settings.date_year }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.description != blank -%}
                <p
                  class="tw-m-0 tw-leading-relaxed tw-font-montserrat"
                  style="color: {{ section.settings.description_color }}; font-size: {{ section.settings.description_size }}px;"
                >
                  {{ block.settings.description }}
                </p>
              {%- endif -%}

              {%- if block.settings.cta_label != blank -%}
                <a
                  href="{{ block.settings.cta_url | default: '#' }}"
                  class="tw-inline-block tw-self-start tw-font-semibold tw-uppercase tw-tracking-wider tw-no-underline tw-mt-1 tw-py-1 tw-px-4 tw-rounded-md tw-transition-opacity hover:tw-opacity-85 tw-font-montserrat"
                  style="background-color: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_text_color }}; font-size: {{ section.settings.cta_font_size }}px; border-radius: {{ section.settings.cta_border_radius }}px;"
                >
                  {{ block.settings.cta_label }}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} View All button {%- endcomment -%}
    {%- if section.settings.view_all_label != blank -%}
      <div class="tw-text-center tw-mt-8">
        <a
          href="{{ section.settings.view_all_url | default: '#' }}"
          class="tw-inline-block tw-font-bold tw-uppercase tw-tracking-[0.1em] tw-no-underline tw-py-2 tw-px-10 tw-rounded-md tw-border tw-border-solid tw-bg-transparent tw-transition-colors hover:tw-bg-[var(--view-all-color)] hover:tw-text-white tw-font-montserrat"
          style="
            --view-all-color: {{ section.settings.view_all_border_color }};
            border-color: {{ section.settings.view_all_border_color }};
            color: {{ section.settings.view_all_text_color }};
            font-size: {{ section.settings.view_all_font_size }}px;
          "
        >
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Events List",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Trade Shows"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Heading Min Size (px)",
      "min": 18,
      "max": 48,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Heading Max Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 40
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We'd love to meet you in person at one of our events or tradeshows"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "subtext_size",
      "label": "Subtext Font Size (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Event Cards"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "color",
      "id": "event_title_color",
      "label": "Event Title Color",
      "default": "#20448F"
    },
    {
      "type": "range",
      "id": "event_title_size",
      "label": "Event Title Size (px)",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta (time/location) Color",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta Font Size (px)",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Date Badge"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#F0BA3A"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#212121"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "CTA Background",
      "default": "#20448F"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_font_size",
      "label": "CTA Font Size (px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "cta_border_radius",
      "label": "CTA Border Radius (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 2
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All Events"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL"
    },
    {
      "type": "color",
      "id": "view_all_border_color",
      "label": "View All Border & Hover Background",
      "default": "#20448F"
    },
    {
      "type": "color",
      "id": "view_all_text_color",
      "label": "View All Text Color",
      "default": "#20448F"
    },
    {
      "type": "range",
      "id": "view_all_font_size",
      "label": "View All Font Size (px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "header",
      "content": "Background & Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FDFBF8"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width (px)",
      "min": 600,
      "max": 1600,
      "step": 40,
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "article",
          "id": "blog",
          "label": "Event"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Event Title",
          "default": "Wholesale Strategy Seminar"
        },
        {
          "type": "url",
          "id": "title_url",
          "label": "Event Title URL"
        },
        {
          "type": "text",
          "id": "date_range",
          "label": "Date Range",
          "default": "September 30 - October 1, 2026",
          "info": "e.g. September 30 - October 1, 2026"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "9:00 AM - 6:00 PM",
          "info": "e.g. 9:00 AM - 6:00 PM"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Austin Distribution Center"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Join our supply chain experts for an in-depth look at optimizing inventory for independent bookstores.</p>"
        },
        {
          "type": "header",
          "content": "Date Badge"
        },
        {
          "type": "text",
          "id": "date_month",
          "label": "Month",
          "default": "OCT",
          "info": "Short form, e.g. OCT"
        },
        {
          "type": "text",
          "id": "date_day",
          "label": "Day",
          "default": "2"
        },
        {
          "type": "text",
          "id": "date_year",
          "label": "Year",
          "default": "2026"
        },
        {
          "type": "header",
          "content": "CTA Button"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Register Now"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events List",
      "blocks": [
        {
          "type": "event",
          "settings": {
            "title": "Wholesale Strategy Seminar",
            "date_range": "September 30 - October 1, 2026",
            "time": "9:00 AM - 6:00 PM",
            "location": "Austin Distribution Center",
            "description": "<p>Join our supply chain experts for an in-depth look at optimizing inventory for independent bookstores.</p>",
            "date_month": "OCT",
            "date_day": "2",
            "date_year": "2026",
            "cta_label": "Register Now"
          }
        },
        {
          "type": "event",
          "settings": {
            "title": "Texas Bookman Annual Tradeshow",
            "date_range": "October 23 - October 24, 2026",
            "time": "9:00 AM - 6:00 PM",
            "location": "Austin Distribution Center",
            "description": "<p>Our annual networking event for educational partners. Preview upcoming fall titles over coffee.</p>",
            "date_month": "OCT",
            "date_day": "23",
            "date_year": "2026",
            "cta_label": "Schedule Appointment"
          }
        }
      ]
    }
  ]
}
{% endschema %}
