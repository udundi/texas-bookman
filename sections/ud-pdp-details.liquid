<style>
  /* Vue v-cloak directive to hide content until Vue is ready */
  [v-cloak] {
    display: none !important;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 1rem;
  }

  .ud-drawers a {
    color: #94412f !important;
    font-weight: 600;
    text-decoration: underline !important;
  }

  .variant-radio {
    display: none !important;
  }

  .variant-radio:checked + .variant-label {
    background-color: white;
    color: #322f30;
  }

  .swiper-pagination-bullet-active {
    background-color: #313558 !important;
  }

  .ud-rich-text > ul {
    list-style: disc !important;
    padding-left: 24px;
  }
  .ud-rich-text > a {
    color: #313558;
    text-decoration: underline;
  }

  /* Main image zoom trigger */
  .pdp-zoom-trigger {
    cursor: zoom-in;
  }

  .pdp-zoom-trigger:focus-visible,
  .image-modal-close:focus-visible {
    outline: 2px solid #313558;
    outline-offset: 2px;
  }

  /* Image Modal Styles */
  .image-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.85);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .image-modal.active {
    display: flex;
    opacity: 1;
  }

  .image-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 3rem;
    height: 3rem;
    background-color: rgba(0, 0, 0, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 0;
    padding: 0;
    color: white;
    transition: background-color 0.2s;
    z-index: 10001;
  }

  .image-modal-close:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .image-modal-close svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke: white;
  }

  .modal-swiper-container {
    width: 100%;
    height: 100%;
  }

  .modal-swiper-container .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
  }

  /* Fill the viewport so small source images still enlarge past the page image */
  .modal-swiper-container .swiper-slide img,
  .modal-swiper-container .swiper-slide video {
    width: 90vw;
    height: 90vh;
    object-fit: contain;
  }

  .modal-swiper-container .swiper-button-next,
  .modal-swiper-container .swiper-button-prev {
    color: white;
    background-color: rgba(0, 0, 0, 0.9);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
  }

  .modal-swiper-container .swiper-button-next:hover,
  .modal-swiper-container .swiper-button-prev:hover {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .modal-swiper-container .swiper-button-next:after,
  .modal-swiper-container .swiper-button-prev:after {
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .image-modal-close {
      top: 0.5rem;
      right: 0.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }

    .modal-swiper-container .swiper-button-next,
    .modal-swiper-container .swiper-button-prev {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
{% render 'vue-mix-pdp' %}

{% comment %} Main HTML Container {% endcomment %}
<div
  id="MainProduct-{{ section.id }}"
  class="tw-flex tw-w-full tw-items-center tw-px-4 tw-pb-8 tw-justify-center section-{{ section.id }}-props tw-flex-col"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-vue-product-details
  data-product-handle="{{ product.handle }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
  data-url="{{ product.url }}"
>
  {% comment %} Add to Cart Form {% endcomment %}
  {% form 'product', product, data-productid: product.id, ref: 'productForm', id: 'product_form', class: 'tw-w-full' %}
    <input
      type="hidden"
      name="id"
      :value="defaultVariantId"
    >
    <div
      class="tw-flex tw-w-full tw-max-w-screen-lg tw-mx-auto tw-flex-col tw-justify-between tw-gap-4 tw-gap-x-10 tw-pt-4 md:tw-flex-row md:tw-items-start"
    >
      {% content_for 'blocks' %}
    </div>
  {% endform %}
</div>

{% render 'gallery-modal' %}

<!-- Setting Price variables for vue -->
{% assign product_price = product.selected_or_first_available_variant.price %}
{% comment %} Case-pack products: see blocks/_pdp-box-quantity.liquid {% endcomment %}
{% assign single_variant = product.selected_or_first_available_variant %}
{% assign case_variant = nil %}
{% for variant in product.variants %}
  {% if variant.option1 == 'Case' %}
    {% assign case_variant = variant %}
  {% elsif single_variant.option1 == 'Case' %}
    {% assign single_variant = variant %}
  {% endif %}
{% endfor %}
{% assign case_size = product.metafields.custom.case_size.value
  | default: case_variant.metafields.custom.case_quantity.value
  | default: 1
%}
{%- liquid
  # Cap at stock only when Shopify refuses to oversell the single variant
  assign stock_max = 'Infinity'
  assign sellable = single_variant.inventory_quantity | at_least: 0
  if single_variant.inventory_management == 'shopify' and single_variant.inventory_policy == 'deny'
    assign stock_max = sellable
  endif
  # Cases are filled from the Single's stock, so they're unlimited when the Single can be oversold
  assign cases_available = 0
  if case_variant and case_size > 1
    if stock_max == 'Infinity'
      assign cases_available = 'Infinity'
    else
      assign cases_available = sellable | divided_by: case_size
    endif
  endif
  capture stock_info
    render 'stock-state', product: product
  endcapture
  assign stock_state = stock_info | split: ' ' | first
-%}
{% assign sitewide_discount = settings.sitewide_sale | default: false %}

<!-- Vue Main script -->
<script>
  const app = Vue.createApp({
    delimiters: ['[[', ']]'],
    mixins: [global, pdpdata],
    data() {
      return {
        quantity: {{ single_variant.quantity_rule.min | default: 1 }},
        currentVariantId: '{{ single_variant.id }}',
        singleVariantId: '{{ single_variant.id }}',
        caseVariantId: '{{ case_variant.id }}',
        casesAvailable: {{ cases_available }},
        caseSize: {{ case_size }},
        stockMax: {{ stock_max }},
        // in_stock, backorder or out_of_stock (snippets/stock-state.liquid)
        stockState: '{{ stock_state }}',
        productId: {{ product.id }},
        // Units of this product already in the cart, Singles plus Cases x case size (see loadCartUnits)
        cartUnits: 0,
        // B2B catalog quantity rules per variant (min/increment/max); Shopify enforces them at checkout
        quantityRules: {
          {%- for variant in product.variants -%}
            '{{ variant.id }}': { min: {{ variant.quantity_rule.min | default: 1 }}, step: {{ variant.quantity_rule.increment | default: 1 }}, max: {{ variant.quantity_rule.max | default: 'null' }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        },
        productPrice: '{{ product_price }}',
        openedBlocks: {% if section.blocks.size > 0 %}[String('block-{{ section.blocks[0].id }}').slice(0, -2)]{% else %}[]{% endif %},
        sitewideDiscount: {{ settings.sitewide_sale_discount | divided_by: 100.0 }},
        sitewideSale: {{ sitewide_discount }},
        clickedTab: 0,
      };
    },
    computed: {
      buyingCase() {
        return !!this.caseVariantId && String(this.currentVariantId) === this.caseVariantId;
      },
      quantityRule() {
        return this.quantityRules[String(this.currentVariantId)] || {};
      },
      // For the Case variant these count cases, so a case-pack minimum is one case
      minQty() {
        return this.quantityRule.min || 1;
      },
      qtyStep() {
        return this.quantityRule.step || 1;
      },
      // Singles and Cases draw on the Single variant's stock (the Case variant has no stock of its own
      // and oversells), so what the cart already holds of either comes off what can still be added
      unitsLeft() {
        if (this.stockMax === Infinity) return Infinity;
        return Math.max(this.stockMax - this.cartUnits, 0);
      },
      casesLeft() {
        if (this.stockMax === Infinity) return this.casesAvailable;
        return Math.min(this.casesAvailable, Math.floor(this.unitsLeft / this.caseSize));
      },
      qtyMax() {
        const stockCap = this.buyingCase ? this.casesLeft : this.unitsLeft;
        return Math.min(stockCap, this.quantityRule.max || Infinity);
      },
      soldOut() {
        return !this.buyingCase && this.stockMax < 1;
      },
      // Out of stock but set to continue selling: adds are allowed
      backorder() {
        return this.stockState === 'backorder';
      },
      // Everything in stock is already in the cart (only for in-stock products, which soldOut covers otherwise)
      cartFull() {
        return !this.soldOut && this.qtyMax < 1;
      },
    },
    watch: {
      // Keep the box inside the cap when the cart fills up or the pack size changes
      qtyMax(max) {
        if (max >= 1 && Number(this.quantity) > max) {
          this.quantity = this.validQuantity(this.quantity, this.minQty, this.qtyStep, max);
        }
      },
    },
    methods: {
      // Counts this product's units in the cart: each Single line by quantity and each Case line by
      // quantity x case size, so Single and Case adds share the one stock count
      async loadCartUnits() {
        try {
          const r = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
          if (!r.ok) return;
          const cart = await r.json();
          this.cartUnits = (cart.items || [])
            .filter((item) => item.product_id === this.productId)
            .reduce((units, item) => {
              const perItem = String(item.variant_id) === this.caseVariantId ? this.caseSize : 1;
              return units + item.quantity * perItem;
            }, 0);
        } catch (e) {
          // Keep the last count; Shopify still refuses Singles beyond stock
        }
      },
      selectPack(variantId) {
        this.currentVariantId = variantId;
        this.quantity = this.minQty;
      },
      clickingTab(id) {
        this.clickedTab = id;
      },
      goToSlide(index) {
        window.goToSlide(index);
      },
      openZoom(event) {
        const trigger = event.target.closest('[data-zoom-index]');
        if (!trigger) return;
        window.openImageModal(Number(trigger.dataset.zoomIndex), trigger);
      },
      async addToCart() {
        if (this.soldOut || this.cartFull) return;
        this.addingToCart = true;
        let mainItemProperties = {};
        const params = new URLSearchParams(window.location.search);
        const urlVariant = params.get('variant');
        let variantIdToAdd = Number(this.currentVariantId || urlVariant || '{{ single_variant.id }}');
        let finalQuantity = this.validQuantity(this.quantity, this.minQty, this.qtyStep, this.qtyMax);
        this.quantity = finalQuantity;
        let mainItem = {
          quantity: finalQuantity,
          id: variantIdToAdd,
        };

        mainItemProperties['_tags'] = {{ product.tags | json }};
        {%- assign isbn = product.metafields.facts.isbn | default: product.metafields.custom.isbn -%}
        {%- if isbn != blank %}
        mainItemProperties['_isbn'] = {{ isbn | append: '' | json }};
        {%- endif %}
        mainItemProperties['_tb'] = {{ product.metafields.custom.tb_code | json }};
        // Only add properties if there are any
        if (Object.keys(mainItemProperties).length > 0) {
          mainItem.properties = mainItemProperties;
        }
        let items = [mainItem];
        items.reverse();
        // Filter out any invalid items
        items = items.filter(item => item && item.id && !isNaN(item.id) && item.quantity > 0);

        console.log('Adding to cart:', JSON.stringify(items, null, 2));

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items }),
        }).then(async (r) => {
          const data = await r.json();
          if (!r.ok) throw data;
          return data;
        }).then((data) => {
          console.log('Cart add success:', data);
          console.log('Items actually added:', data.items?.map(item => ({
            id: item.variant_id,
            title: item.title,
            quantity: item.quantity,
            variant_title: item.variant_title
          })));
          const recentItem = data.items?.[0];
          this.bus.$emit('refreshCart');
          if (recentItem) {
            this.bus.$emit('cartItemAdded', recentItem);
          }
          this.addingToCart = false;
          this.$forceUpdate();
        }).catch((error) => {
          console.error('Cart add error:', error);
          this.bus.$emit('cartFailedToAdd', error);
          this.addingToCart = false;
        }).finally(() => {
          this.addingToCart = false;
          // Partial adds land some units, so recount either way
          this.loadCartUnits();
        });
      }
    },
    mounted() {
      this.loadCartUnits();
      // The cart can change elsewhere (cart popup, /cart in another tab, back/forward cache)
      this.bus.$on('refreshCart', () => this.loadCartUnits());
      window.addEventListener('pageshow', () => this.loadCartUnits());
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') this.loadCartUnits();
      });

      const params = new URLSearchParams(window.location.search);
      const urlVariant = params.get('variant');
      if (urlVariant && (urlVariant !== this.caseVariantId || this.casesAvailable > 0)) {
        this.currentVariantId = urlVariant;
        this.quantity = this.minQty;
      }
    }
  });

  // Mount the Vue 3 application
  app.mount('.section-{{ section.id }}-props');

  // Prevent native form submission — all cart adds are handled via fetch
  document.getElementById('product_form').addEventListener('submit', function(e) {
    e.preventDefault();
  });

  function initMobileSwiper() {
    try {
      const container = document.querySelector('.swiper-container');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof swiper2 !== 'undefined' && swiper2 && swiper2.slides) {
        if (swiper2.slides.length === newSlideCount) {
          swiper2.update();
          swiper2.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy (false, false = keep DOM intact)
        if (swiper2.destroy) swiper2.destroy(false, false);
      }

      swiper2 = new Swiper('.swiper-container', {
        loop: true,
        spaceBetween: 10,
        slidesPerView: 1.3,
        navigation: {
          nextEl: '.swiper-container .swiper-button-next',
          prevEl: '.swiper-container .swiper-button-prev',
        },
        breakpoints: {
          768: {
            slidesPerView: 1,
          }
        },
        pagination: {
          el: ".swiper-pagination",
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var swiper2;
  initMobileSwiper();
  function initThumbsSwiper() {
    try {
      const container = document.querySelector('.swiper-thumbs');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof swiper !== 'undefined' && swiper && swiper.slides) {
        if (swiper.slides.length === newSlideCount) {
          swiper.update();
          swiper.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy
        if (swiper.destroy) swiper.destroy(false, false);
      }

      swiper = new Swiper('.swiper-thumbs', {
        loop: false,
        slidesPerView: 3.4,
        spaceBetween: 10,
        freeMode: true,
        watchSlidesProgress: true,
        breakpoints: {
          450: {
            slidesPerView: 2.4,
          },
          900: {
            slidesPerView: 3.4,
          },
          1440: {
            slidesPerView: 4.4,
          },
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var swiper;
  initThumbsSwiper();

  var swiper3 = new Swiper('.related-swiper', {
    slidesPerView: 1.3,
    spaceBetween: 10,
    breakpoints: {
      900: {
        slidesPerView: 2.3,
      },
      1440: {
        slidesPerView: 3.3,
      },
    },
  });

  function initModalSwiper() {
    try {
      const container = document.querySelector('.modal-swiper-container');
      if (!container) return;

      const newSlideCount = container.querySelectorAll('.swiper-slide').length;

      // Optimize: update existing swiper if slide count matches (saves 100-150ms)
      if (typeof modalSwiper !== 'undefined' && modalSwiper && modalSwiper.slides) {
        if (modalSwiper.slides.length === newSlideCount) {
          modalSwiper.update();
          modalSwiper.slideTo(0, 0);
          return;
        }
        // Structural change - lighter destroy
        if (modalSwiper.destroy) modalSwiper.destroy(false, false);
      }

      modalSwiper = new Swiper('.modal-swiper-container', {
        // Loop mode needs more than one slide, and single-image products hide the arrows
        loop: newSlideCount > 1,
        spaceBetween: 10,
        slidesPerView: 1,
        navigation: {
          nextEl: '.modal-swiper-container .swiper-button-next',
          prevEl: '.modal-swiper-container .swiper-button-prev',
        },
        keyboard: {
          enabled: true,
        },
      });
    } catch (err) {
      // Swiper init failed - gracefully degrade
    }
  }
  var modalSwiper;
  initModalSwiper();

  function goToSlide(index) {
    // Main carousel uses loop mode, so real slide indexes must be resolved with slideToLoop
    if (typeof swiper2 !== 'undefined' && swiper2 && swiper2.slideToLoop) {
      swiper2.slideToLoop(index);
    } else if (typeof swiper2 !== 'undefined' && swiper2 && swiper2.slideTo) {
      swiper2.slideTo(index);
    }
  }

  // Image Modal Functions
  var imageModalReturnFocus = null;

  function getImageModal() {
    return document.getElementById('imageModal-{{ section.id }}');
  }

  function openImageModal(slideIndex, returnFocusTo) {
    const modal = getImageModal();
    if (!modal || !modal.querySelector('.swiper-slide')) return;
    imageModalReturnFocus = returnFocusTo || document.activeElement;
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // The modal swiper was built while hidden, so measure it now that it is visible
    if (modalSwiper && modalSwiper.update) {
      modalSwiper.update();
      const index = Number(slideIndex) || 0;
      if (modalSwiper.params.loop) {
        modalSwiper.slideToLoop(index, 0);
      } else {
        modalSwiper.slideTo(index, 0);
      }
    }
    modal.querySelector('.image-modal-close').focus();
  }

  function closeImageModal() {
    const modal = getImageModal();
    if (!modal || !modal.classList.contains('active')) return;
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    modal.querySelectorAll('video').forEach((video) => video.pause());
    if (imageModalReturnFocus && imageModalReturnFocus.focus) {
      imageModalReturnFocus.focus();
    }
    imageModalReturnFocus = null;
  }

  // Escape closes the modal, and Tab stays inside it while open
  document.addEventListener('keydown', function(e) {
    const modal = getImageModal();
    if (!modal || !modal.classList.contains('active')) return;
    if (e.key === 'Escape') {
      closeImageModal();
    } else if (e.key === 'Tab') {
      const focusable = Array.from(
        modal.querySelectorAll('button, [tabindex="0"], video[controls]')
      ).filter((el) => el.offsetParent !== null && !el.classList.contains('swiper-button-lock'));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && (document.activeElement === first || !modal.contains(document.activeElement))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Clicking the backdrop around the image closes the modal
  document.addEventListener('click', function(e) {
    const modal = getImageModal();
    if (!modal || !modal.classList.contains('active')) return;
    if (e.target === modal || e.target.classList.contains('swiper-slide')) {
      closeImageModal();
    }
  });
</script>

