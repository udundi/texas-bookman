<div
  id="inner-{{ block.id }}"
  class="tw-flex-col tw-flex-grow{% if block.settings.desktop == 'full' %} md:tw-w-full {% elsif block.settings.desktop == '33%' %} md:tw-w-1/3 {% elsif block.settings.desktop == '50%' %} md:tw-w-1/2 {% elsif block.settings.desktop == '2/5' %} md:tw-w-2/5 {% elsif block.settings.desktop == '3/5' %} md:tw-w-3/5 {% elsif block.settings.desktop == '66%' %} md:tw-w-2/3 {% else %}md:tw-w-full{% endif %} {% if block.settings.mobile == 'full' %} tw-w-full {% elsif block.settings.mobile == '33%' %} tw-w-1/3 {% elsif block.settings.mobile == '50%' %} tw-w-1/2 {% elsif block.settings.mobile == '2/5' %} tw-w-2/5 {% elsif block.settings.mobile == '3/5' %} tw-w-3/5 {% elsif block.settings.mobile == '66%' %} tw-w-2/3 {% else %} tw-w-full {% endif %} {% if block.settings.visibility contains 'mobile' %} tw-flex md:tw-hidden {% elsif block.settings.visibility contains "desktop" %} tw-hidden md:tw-sticky {% else %} md:tw-sticky tw-flex {% endif %} md:tw-z-[1] md:tw-h-fit tw-top-4 md:tw-self-start tw-gap-2"
>
  <style>
    @media (min-width: 768px) {
      #inner-{{ block.id }} {
        top: var(--site-header-height, 7rem);
      }
    }
  </style>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Main Details Column",
  "class": "tw-contents",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "both",
          "label": "Mobile and Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "mobile",
      "label": "Column Size on Mobile",
      "options": [
        {
          "value": "full",
          "label": "Full Width"
        },
        {
          "value": "33%",
          "label": "1 / 3 of Screen"
        },
        {
          "value": "50%",
          "label": "1 / 2 of Screen"
        },
        {
          "value": "2/5",
          "label": "2 / 5 of Screen"
        },
        {
          "value": "3/5",
          "label": "3 / 5 of Screen"
        },
        {
          "value": "66%",
          "label": "2 / 3 of Screen"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "desktop",
      "label": "Column Size on Desktop",
      "options": [
        {
          "value": "full",
          "label": "Full Width"
        },
        {
          "value": "33%",
          "label": "1 / 3 of Screen"
        },
        {
          "value": "50%",
          "label": "1 / 2 of Screen"
        },
        {
          "value": "2/5",
          "label": "2 / 5 of Screen"
        },
        {
          "value": "3/5",
          "label": "3 / 5 of Screen"
        },
        {
          "value": "66%",
          "label": "2 / 3 of Screen"
        }
      ],
      "default": "33%"
    }
  ],
  "blocks": [
    {
      "type": "_pdp-checkout-buttons"
    },
    {
      "type": "_pdp-description"
    },
    {
      "type": "_pdp-price"
    },
    {
      "type": "_pdp-quantity"
    },
    {
      "type": "_pdp-info-numbers"
    },
    {
      "type": "_pdp-info-tabs"
    },
    {
      "type": "_pdp-box-quantity"
    },
    {
      "type": "_pdp-related-products"
    },
    {
      "type": "_pdp-title-rating"
    },
    {
      "type": "_pdp-image-gallery"
    },
    {
      "type": "_pdp-variants"
    },
    {
      "type": "_pdp-description-drawers"
    },
    {
      "type": "_pdp-author"
    },
    {
      "type": "_pdp-value-options"
    }
  ],
  "presets": [
    {
      "name": "Main Details Column",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
