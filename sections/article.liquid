{% style %}
  .ud-article-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .ud-article-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }

  .ud-article-{{ section.id }} .article-inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .ud-article-{{ section.id }} .article-hero {
    width: 100%;
    border-radius: {{ section.settings.image_border_radius }}px;
    object-fit: cover;
    margin-bottom: 2rem;
    display: block;
  }

  .ud-article-{{ section.id }} .article-title {
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: clamp({{ section.settings.heading_size_min }}px, 3vw, {{ section.settings.heading_size_max }}px);
    line-height: 1.2;
    margin: 0 0 0.75rem;
  }

  .ud-article-{{ section.id }} .article-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.meta_color }};
    font-size: {{ section.settings.meta_size }}px;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .ud-article-{{ section.id }} .article-meta-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    stroke: {{ section.settings.meta_color }};
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ud-article-{{ section.id }} .article-meta-divider {
    color: {{ section.settings.meta_color }};
    opacity: 0.5;
  }

  .ud-article-{{ section.id }} .article-meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .ud-article-{{ section.id }} .article-meta-icon-fill {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .ud-article-{{ section.id }} .article-body {
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.75;
  }

  .ud-article-{{ section.id }} .article-body h1,
  .ud-article-{{ section.id }} .article-body h2,
  .ud-article-{{ section.id }} .article-body h3,
  .ud-article-{{ section.id }} .article-body h4 {
    color: {{ section.settings.heading_color }};
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .ud-article-{{ section.id }} .article-body a {
    color: {{ section.settings.heading_color }};
    text-decoration: underline;
  }

  .ud-article-{{ section.id }} .article-body img {
    max-width: 100%;
    border-radius: 6px;
  }

  /* Event metafields */
  .ud-article-{{ section.id }} .article-event-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.meta_color }};
    font-size: {{ section.settings.meta_size }}px;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .ud-article-{{ section.id }} .article-cta {
    display: inline-block;
    background-color: {{ section.settings.heading_color }};
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.6rem 1.75rem;
    border-radius: 4px;
    margin-top: 1.5rem;
    transition: opacity 0.2s;
  }

  .ud-article-{{ section.id }} .article-cta:hover {
    opacity: 0.85;
  }

  /* Comments */
  .ud-article-{{ section.id }} .article-comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  .ud-article-{{ section.id }} .comments-heading {
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: 22px;
    margin: 0 0 1.5rem;
  }

  .ud-article-{{ section.id }} .comment-item {
    border: 1px solid {{ section.settings.divider_color }};
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }

  .ud-article-{{ section.id }} .comment-author {
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: 14px;
    margin: 0 0 0.2rem;
  }

  .ud-article-{{ section.id }} .comment-date {
    color: {{ section.settings.meta_color }};
    font-size: 12px;
    margin: 0 0 0.5rem;
  }

  .ud-article-{{ section.id }} .comment-body {
    color: {{ section.settings.body_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ud-article-{{ section.id }} .comment-form {
    margin-top: 2rem;
  }

  .ud-article-{{ section.id }} .comment-form-heading {
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    font-size: 18px;
    margin: 0 0 1rem;
  }

  .ud-article-{{ section.id }} .comment-form-field {
    margin-bottom: 1rem;
  }

  .ud-article-{{ section.id }} .comment-form-field label {
    display: block;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    font-size: 13px;
    margin-bottom: 0.35rem;
  }

  .ud-article-{{ section.id }} .comment-form-field input,
  .ud-article-{{ section.id }} .comment-form-field textarea {
    width: 100%;
    border: 1px solid {{ section.settings.divider_color }};
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-size: {{ section.settings.body_size }}px;
    color: {{ section.settings.body_color }};
    background: #fff;
    box-sizing: border-box;
  }

  .ud-article-{{ section.id }} .comment-form-field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .ud-article-{{ section.id }} .comment-form-submit {
    display: inline-block;
    background-color: {{ section.settings.heading_color }};
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    padding: 0.6rem 1.75rem;
    border-radius: 4px;
    transition: opacity 0.2s;
  }

  .ud-article-{{ section.id }} .comment-form-submit:hover {
    opacity: 0.85;
  }
{% endstyle %}

<section class="ud-article-{{ section.id }} tw" id="ud-article-{{ section.id }}">
  <div class="article-inner">
    <article>
      {%- if article.image -%}
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-hero"
          loading="eager"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
        >
      {%- endif -%}

      <h1 class="article-title tw-font-montserrat">{{ article.title }}</h1>

      {%- assign event_start_time = article.metafields.custom.start_time -%}
      {%- assign event_end_time = article.metafields.custom.end_time -%}
      {%- assign event_location = article.metafields.custom.location -%}

      {%- assign has_date_range = false -%}
      {%- if event_start_time != blank and event_end_time != blank -%}
        {%- assign has_date_range = true -%}
        {%- assign start_month = event_start_time | date: '%B' -%}
        {%- assign start_day = event_start_time | date: '%-d' -%}
        {%- assign start_year = event_start_time | date: '%Y' -%}
        {%- assign end_month = event_end_time | date: '%B' -%}
        {%- assign end_day = event_end_time | date: '%-d' -%}
        {%- assign end_year = event_end_time | date: '%Y' -%}
      {%- endif -%}
      {%- assign has_time = false -%}
      {%- if event_start_time != blank -%}{%- assign has_time = true -%}{%- endif -%}
      {%- assign has_location = false -%}
      {%- if event_location != blank -%}{%- assign has_location = true -%}{%- endif -%}

      {%- if has_date_range or has_time or has_location -%}
        <div class="article-event-meta tw-font-montserrat">
          {%- if has_date_range -%}
            <span class="article-meta-item">
              <svg class="article-meta-icon-fill" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                <g clip-path="url(#clip0_490_3446_{{ section.id }})">
                <path d="M12.7229 14.0391H1.31616C0.587886 14.0391 0 13.4512 0 12.7229V2.1936C0 1.46533 0.587886 0.877441 1.31616 0.877441H12.7229C13.4512 0.877441 14.0391 1.46533 14.0391 2.1936V12.7229C14.0391 13.4512 13.4512 14.0391 12.7229 14.0391ZM1.31616 1.75488C1.07048 1.75488 0.877441 1.94792 0.877441 2.1936V12.7229C0.877441 12.9686 1.07048 13.1616 1.31616 13.1616H12.7229C12.9686 13.1616 13.1616 12.9686 13.1616 12.7229V2.1936C13.1616 1.94792 12.9686 1.75488 12.7229 1.75488H1.31616Z" fill="#5D616E"/>
                <path d="M3.94849 3.50977C3.7028 3.50977 3.50977 3.31673 3.50977 3.07104V0.438721C3.50977 0.193037 3.7028 0 3.94849 0C4.19417 0 4.38721 0.193037 4.38721 0.438721V3.07104C4.38721 3.31673 4.19417 3.50977 3.94849 3.50977ZM10.0906 3.50977C9.84489 3.50977 9.65186 3.31673 9.65186 3.07104V0.438721C9.65186 0.193037 9.84489 0 10.0906 0C10.3363 0 10.5293 0.193037 10.5293 0.438721V3.07104C10.5293 3.31673 10.3363 3.50977 10.0906 3.50977ZM13.6003 5.26465H0.438721C0.193037 5.26465 0 5.07161 0 4.82593C0 4.58024 0.193037 4.38721 0.438721 4.38721H13.6003C13.846 4.38721 14.0391 4.58024 14.0391 4.82593C14.0391 5.07161 13.846 5.26465 13.6003 5.26465Z" fill="#5D616E"/>
                </g>
                <defs>
                <clipPath id="clip0_490_3446_{{ section.id }}">
                <rect width="14.0391" height="14.0391" fill="white"/>
                </clipPath>
                </defs>
              </svg>
              <span>
                {%- if start_month != end_month -%}
                  {{ start_month }} {{ start_day }}
                {%- else -%}
                  {{ start_day }}
                {%- endif -%}
                {%- if start_year != end_year -%}, {{ start_year }}{%- endif -%}
                - {{ end_month }} {{ end_day }}, {{ end_year }}
              </span>
            </span>
          {%- endif -%}
          {%- if has_time -%}
            {%- if has_date_range -%}<span class="article-meta-divider">·</span>{%- endif -%}
            <span class="article-meta-item">
              <svg class="article-meta-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>
                {{- event_start_time | date: '%l:%M %p' | strip -}}
                {%- if event_end_time != blank %} - {{ event_end_time | date: '%l:%M %p' | strip }}{% endif -%}
              </span>
            </span>
          {%- endif -%}
          {%- if has_location -%}
            {%- if has_date_range or has_time -%}<span class="article-meta-divider">·</span>{%- endif -%}
            <span class="article-meta-item">
              <svg class="article-meta-icon-fill" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M2.89283 1.85512C3.9847 0.849172 5.45622 0.288262 6.98707 0.294485C8.51792 0.300707 9.98419 0.873558 11.0667 1.88835C12.1493 2.90314 12.7604 4.27772 12.7672 5.7129C12.7739 7.14807 12.1758 8.52766 11.1028 9.55137L10.3108 10.2851C9.72772 10.8218 8.97083 11.512 8.04016 12.3557C7.76036 12.6092 7.38645 12.7508 6.99736 12.7507C6.60827 12.7506 6.23446 12.6088 5.95483 12.3551L3.62749 10.2326C3.33505 9.96346 3.09016 9.73637 2.89283 9.55137C1.80464 8.53057 1.19336 7.14644 1.19336 5.70325C1.19336 4.26006 1.80464 2.87593 2.89283 1.85512ZM10.3948 2.51887C9.94979 2.09592 9.4199 1.75968 8.83567 1.52952C8.25144 1.29936 7.62442 1.17983 6.99071 1.1778C6.35699 1.17577 5.72911 1.29129 5.14322 1.51771C4.55733 1.74413 4.02501 2.07698 3.5769 2.49707C3.1288 2.91717 2.77377 3.41623 2.53226 3.9655C2.29074 4.51477 2.16752 5.10341 2.16968 5.69751C2.17184 6.29162 2.29934 6.87945 2.54485 7.42717C2.79035 7.97488 3.14901 8.47165 3.60016 8.88887L4.59149 9.80575C5.2758 10.4326 5.96202 11.0576 6.65016 11.6807C6.74341 11.7653 6.86808 11.8126 6.99783 11.8126C7.12758 11.8126 7.25224 11.7653 7.34549 11.6807L9.60816 9.61825C9.92149 9.33075 10.1837 9.08762 10.3948 8.88887C11.2958 8.04415 11.802 6.89847 11.802 5.70387C11.802 4.50928 11.2958 3.3636 10.3948 2.51887ZM6.99816 3.68762C7.30462 3.68771 7.60807 3.74438 7.89116 3.8544C8.17426 3.96442 8.43148 4.12565 8.64812 4.32886C8.86476 4.53208 9.03658 4.77331 9.15378 5.03877C9.27097 5.30424 9.33125 5.58875 9.33116 5.87606C9.33107 6.16337 9.27062 6.44785 9.15326 6.71325C9.03591 6.97866 8.86394 7.2198 8.64717 7.4229C8.43041 7.626 8.1731 7.78708 7.88993 7.89695C7.60677 8.00682 7.30329 8.06333 6.99683 8.06325C6.3779 8.06308 5.78439 7.83242 5.34687 7.42201C4.90935 7.0116 4.66365 6.45506 4.66383 5.87481C4.664 5.29457 4.91004 4.73816 5.34781 4.32798C5.78559 3.9178 6.37923 3.68746 6.99816 3.68762ZM6.99749 4.62512C6.64387 4.62512 6.30473 4.75682 6.05468 4.99124C5.80464 5.22566 5.66416 5.5436 5.66416 5.87512C5.66416 6.20665 5.80464 6.52459 6.05468 6.75901C6.30473 6.99343 6.64387 7.12512 6.99749 7.12512C7.35112 7.12512 7.69025 6.99343 7.9403 6.75901C8.19035 6.52459 8.33083 6.20665 8.33083 5.87512C8.33083 5.5436 8.19035 5.22566 7.9403 4.99124C7.69025 4.75682 7.35112 4.62512 6.99749 4.62512Z" fill="#5D616E"/>
              </svg>
              <span>{{ event_location }}</span>
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="article-body">
        {{ article.content }}
      </div>

      {%- if article.metafields.custom.cta_link != blank -%}
        <a
          href="{{ article.metafields.custom.cta_link }}"
          class="article-cta tw-font-montserrat"
        >
          {{- article.metafields.custom.cta_text | default: 'Learn More' -}}
        </a>
      {%- endif -%}
    </article>

    {%- if blog.comments_enabled? -%}
      <div class="article-comments">
        <h2 class="comments-heading tw-font-montserrat">{{ 'blog.article_comments' | t }}</h2>

        {%- if article.comments_count > 0 -%}
          <div id="comments">
            {%- paginate article.comments by 10 -%}
              {%- for comment in article.comments -%}
                <div class="comment-item">
                  <p class="comment-author tw-font-montserrat">{{ comment.author }}</p>
                  <p class="comment-date tw-font-montserrat">{{ comment.created_at | time_tag: format: 'date' }}</p>
                  <p class="comment-body">{{ comment.content }}</p>
                </div>
              {%- endfor -%}
              {{ paginate | default_pagination: anchor: 'comments' }}
            {%- endpaginate -%}
          </div>
        {%- endif -%}

        {%- form 'new_comment', article -%}
          <div class="comment-form">
            <h3 class="comment-form-heading tw-font-montserrat">{{ 'blog.comment_form_title' | t }}</h3>
            {{ form.errors | default_errors }}
            <div class="comment-form-field">
              <label for="author">{{ 'blog.comment_form_name' | t }}</label>
              <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
            </div>
            <div class="comment-form-field">
              <label for="email">{{ 'blog.comment_form_email' | t }}</label>
              <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
            </div>
            <div class="comment-form-field">
              <label for="body">{{ 'blog.comment_form_body' | t }}</label>
              <textarea name="comment[body]" id="body" required>{{ form.body }}</textarea>
            </div>
            <input
              type="submit"
              class="comment-form-submit tw-font-montserrat"
              value="{{ 'blog.comment_form_submit' | t }}"
            >
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width (px)",
      "min": 480,
      "max": 1200,
      "step": 20,
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Hero Image Border Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / Title Color",
      "default": "#212121"
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "label": "Title Min Size (px)",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "label": "Title Max Size (px)",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 42
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Text Color",
      "default": "#6b7280"
    },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta Font Size (px)",
      "min": 11,
      "max": 18,
      "step": 1,
      "default": 14
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#374151"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size (px)",
      "min": 13,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider / Border Color",
      "default": "#e5e7eb"
    }
  ]
}
{% endschema %}
